{
  "name": "Reliability · Dead letter",
  "nodes": [
    {
      "id": "cba9137a-5af3-48fd-ab6e-522f522b7250",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Reliability · Dead letter\nKeeps the payload of work that could not be finished in Supabase, with the reason, so nothing is lost when a platform is down.\n\n**Platforms:** Supabase, Slack\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `shared`"
      }
    },
    {
      "id": "51b1753e-88e4-47c4-ad51-2bc7b034ea35",
      "position": [
        0,
        90
      ],
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "41727648-c0ea-4b8e-a9de-b466b2fd9545",
      "position": [
        260,
        90
      ],
      "name": "Wrap the payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return $input.all().map((item) => ({ json: {\n  source: item.json.source ?? \"unknown\",\n  replay_url: item.json.replay_url ?? null,\n  reason: String(item.json.reason ?? \"unspecified\").slice(0, 300),\n  payload: item.json.payload ?? {},\n  status: \"pending\",\n  attempts: 0,\n  parked_at: new Date().toISOString(),\n} }));"
      }
    },
    {
      "id": "f865655c-5809-4329-a2a5-7f7061fbc9b2",
      "position": [
        520,
        90
      ],
      "name": "Park it",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "dead_letters",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "source",
              "fieldValue": "={{ $json.source }}"
            },
            {
              "fieldId": "replay_url",
              "fieldValue": "={{ $json.replay_url }}"
            },
            {
              "fieldId": "reason",
              "fieldValue": "={{ $json.reason }}"
            },
            {
              "fieldId": "payload",
              "fieldValue": "={{ $json.payload }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "={{ $json.status }}"
            },
            {
              "fieldId": "attempts",
              "fieldValue": "={{ $json.attempts }}"
            },
            {
              "fieldId": "parked_at",
              "fieldValue": "={{ $json.parked_at }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "a3568f07-eb3f-40ed-a9fe-f1ddbb1d0f23",
      "position": [
        780,
        90
      ],
      "name": "Say so",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ '#ops-alerts' }}"
        },
        "text": "={{ ':inbox_tray: Parked 1 item from ' + $('Wrap the payload').item.json.source + ': ' + $('Wrap the payload').item.json.reason }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "slackApi": {
          "id": "__CRED:slack__",
          "name": "Slack"
        }
      }
    }
  ],
  "connections": {
    "When called": {
      "main": [
        [
          {
            "node": "Wrap the payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wrap the payload": {
      "main": [
        [
          {
            "node": "Park it",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Park it": {
      "main": [
        [
          {
            "node": "Say so",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
