            "index": 0
          }
        ]
      ]
    },
    "Log the error": {
      "main": [
        [
          {
            "node": "Alert the team",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Seen this hour?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Seen this hour?": {
      "main": [
        [
          {
