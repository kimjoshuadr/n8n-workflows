{
  "name": "Reliability · Error handler",
  "nodes": [
    {
      "id": "0581a7c1-2c3e-4a26-a395-ec868269b126",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Reliability · Error handler\nCatches a failure in any workflow, logs it to Supabase, and alerts Slack once per distinct error per hour so a broken loop cannot flood the channel.\n\n**Platforms:** Supabase, Slack\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `shared`"
      }
    },
    {
      "id": "dce5f972-b3db-473f-adb8-7414b84ad45b",
      "position": [
        0,
        180
      ],
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "parameters": {}
    },
    {
      "id": "99310d67-a0d8-47ab-a8e1-df3139244ad2",
      "position": [
        260,
        180
      ],
      "name": "Describe the failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst workflow = e.workflow?.name ?? \"Unknown workflow\";\nconst node = e.execution?.lastNodeExecuted ?? \"unknown node\";\nconst message = String(e.execution?.error?.message ?? e.trigger?.error?.message ?? \"No message\").slice(0, 500);\nconst hour = new Date().toISOString().slice(0, 13);\nreturn [{ json: {\n  workflow, node, message,\n  execution_id: e.execution?.id ?? null,\n  execution_url: e.execution?.url ?? null,\n  fingerprint: [workflow, node, message.slice(0, 80), hour].join(\"|\"),\n  at: new Date().toISOString(),\n} }];"
      }
    },
    {
      "id": "d2475f31-7b58-4456-a438-515d78ab10c9",
      "position": [
        520,
        180
      ],
      "name": "Log the error",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "workflow_errors",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "workflow",
              "fieldValue": "={{ $json.workflow }}"
            },
            {
              "fieldId": "node",
              "fieldValue": "={{ $json.node }}"
            },
            {
              "fieldId": "message",
              "fieldValue": "={{ $json.message }}"
            },
            {
              "fieldId": "execution_id",
              "fieldValue": "={{ $json.execution_id }}"
            },
            {
              "fieldId": "fingerprint",
              "fieldValue": "={{ $json.fingerprint }}"
            },
            {
              "fieldId": "at",
              "fieldValue": "={{ $json.at }}"
            }
          ]
        }
      },
      "onError": "continueErrorOutput",
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "c8d93d0f-8888-4d65-a12f-33ac1fd0c634",
      "position": [
        780,
        90
      ],
      "name": "Alert the team",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ '#ops-alerts' }}"
        },
        "text": "={{ ':rotating_light: ' + $('Describe the failure').first().json.workflow + ' failed at \"' + $('Describe the failure').first().json.node + '\": ' + $('Describe the failure').first().json.message }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "slackApi": {
          "id": "__CRED:slack__",
          "name": "Slack"
        }
      }
    },
    {
      "id": "4228acb3-0754-44f0-a012-4e1eb27f27d8",
      "position": [
        780,
        270
      ],
      "name": "Seen this hour?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "1bdc4999-ccb8-41e9-af7a-e9a19ae7f1ec",
              "leftValue": "={{ /duplicate key|23505/.test(String($json.error ?? '')) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "70793f10-e5f6-42c6-ae4d-08413c8b661b",
      "position": [
        1040,
        90
      ],
      "name": "Already alerted",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    },
    {
      "id": "6f134486-cf8a-47ef-a248-883dfb8464cc",
      "position": [
        1040,
        270
      ],
      "name": "Alert anyway",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ '#ops-alerts' }}"
        },
        "text": "={{ ':rotating_light: ' + $('Describe the failure').first().json.workflow + ' failed at \"' + $('Describe the failure').first().json.node + '\": ' + $('Describe the failure').first().json.message + ' (and the error log could not be written)' }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "slackApi": {
          "id": "__CRED:slack__",
          "name": "Slack"
        }
      }
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Describe the failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Describe the failure": {
