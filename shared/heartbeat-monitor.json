{
  "name": "Reliability · Heartbeat monitor",
  "nodes": [
    {
      "id": "61f4f4bc-2c60-4191-ac81-58f50014ce5a",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Reliability · Heartbeat monitor\nNotices the failure nobody reports: a scheduled workflow that silently stopped running. Each one checks in to Supabase, and this alerts Slack when a check-in is overdue.\n\n**Platforms:** Supabase, Slack\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `shared`"
      }
    },
    {
      "id": "2e9a4e97-913b-4c43-a7d6-574aed1f7d85",
      "position": [
        0,
        90
      ],
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "51a204d2-fda6-4401-a753-f0385df5b7b4",
      "position": [
        260,
        90
      ],
      "name": "Read heartbeats",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "heartbeats",
        "returnAll": true
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "aec6adc1-e8aa-4d54-a4e9-fed809e33636",
      "position": [
        520,
        90
      ],
      "name": "Find the overdue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const now = Date.now();\nreturn $input.all()\n  .map((i) => i.json)\n  .filter((h) => h.name && h.last_seen)\n  .filter((h) => now - new Date(h.last_seen).getTime() > (h.max_gap_minutes ?? 90) * 60000)\n  .map((h) => ({ json: { name: h.name, last_seen: h.last_seen, hours_silent: Math.round((now - new Date(h.last_seen).getTime()) / 36e5) } }));"
      }
    },
    {
      "id": "bd1916cf-eab1-43cb-aa23-144449178675",
      "position": [
        780,
        90
      ],
      "name": "Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ '#ops-alerts' }}"
        },
        "text": "={{ ':zzz: ' + $json.name + ' has not run for ' + $json.hours_silent + 'h (last seen ' + $json.last_seen + ').' }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "slackApi": {
          "id": "__CRED:slack__",
          "name": "Slack"
        }
      }
    }
  ],
  "connections": {
    "Every hour": {
      "main": [
        [
          {
            "node": "Read heartbeats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read heartbeats": {
      "main": [
        [
          {
            "node": "Find the overdue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find the overdue": {
      "main": [
        [
          {
            "node": "Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
