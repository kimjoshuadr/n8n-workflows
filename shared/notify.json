{
  "name": "Reliability · Notify",
  "nodes": [
    {
      "id": "9026b30c-a622-4a29-a60a-b48868580672",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -390
      ],
      "parameters": {
        "width": 620,
        "height": 220,
        "content": "## Reliability · Notify\nThe one place alerts leave from. Posts to chat, and falls back to email when chat is down, so an outage cannot hide its own alert.\n\n**Needs:** ALERT_CHANNEL, CHAT_API_KEY, CHAT_BASE_URL, EMAIL_API_KEY, EMAIL_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `shared`"
      }
    },
    {
      "id": "26f9ecb8-11e0-4e4e-aadf-28060c93d6d5",
      "position": [
        0,
        0
      ],
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "91932aa0-2f70-454f-a3cf-dbe4552ccb8d",
      "position": [
        240,
        0
      ],
      "name": "Compose",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cce3708b-632e-413d-ae7b-8d97df6d8604",
              "name": "channel",
              "value": "={{ $json.channel ?? $env.ALERT_CHANNEL }}",
              "type": "string"
            },
            {
              "id": "de16a74d-9302-4dbb-a57d-150cb5d90c18",
              "name": "text",
              "value": "={{ ($json.level === 'critical' ? ':red_circle: ' : $json.level === 'warn' ? ':warning: ' : ':information_source: ') + $json.text }}",
              "type": "string"
            },
            {
              "id": "8ce9ad01-2c26-4069-a047-3458b36f19a2",
              "name": "level",
              "value": "={{ $json.level ?? 'info' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "180af92a-833b-42a7-a5f8-97c455ab1340",
      "position": [
        480,
        0
      ],
      "name": "Post to chat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHAT_BASE_URL }}/chat.postMessage",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.CHAT_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $json.channel, text: $json.text }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "f9988700-4056-45dc-a754-58072e82e41f",
      "position": [
        720,
        -90
      ],
      "name": "Delivered by chat",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "7918710d-13df-494d-a3bd-c1d1cb07df58",
              "name": "delivered",
              "value": "={{ 'chat' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "bc694fe5-059b-4dc6-a962-80a0ff8706f4",
      "position": [
        720,
        90
      ],
      "name": "Email instead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EMAIL_BASE_URL }}/emails",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.EMAIL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: 'ops@example.com', subject: 'Alert (chat unavailable)', text: $('Compose').item.json.text }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "17a0749d-9962-4fa5-ab48-39fbafd917dd",
      "position": [
        960,
        0
      ],
      "name": "Delivered by email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "254caa7b-30b4-441c-a47b-eca106e173f6",
              "name": "delivered",
              "value": "={{ 'email' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    }
  ],
  "connections": {
    "When called": {
      "main": [
        [
          {
            "node": "Compose",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compose": {
      "main": [
        [
          {
            "node": "Post to chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post to chat": {
      "main": [
        [
          {
            "node": "Delivered by chat",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Email instead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email instead": {
      "main": [
        [
          {
            "node": "Delivered by email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
