{
  "name": "Reliability · Notify",
  "nodes": [
    {
      "id": "9026b30c-a622-4a29-a60a-b48868580672",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Reliability · Notify\nThe one place alerts leave from. Posts to Slack, and falls back to a SendGrid email when Slack is down, so an outage cannot hide its own alert.\n\n**Platforms:** Slack, SendGrid\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `shared`"
      }
    },
    {
      "id": "26f9ecb8-11e0-4e4e-aadf-28060c93d6d5",
      "position": [
        0,
        180
      ],
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "91932aa0-2f70-454f-a3cf-dbe4552ccb8d",
      "position": [
        260,
        180
      ],
      "name": "Compose",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cce3708b-632e-413d-ae7b-8d97df6d8604",
              "name": "channel",
              "value": "={{ $json.channel ?? '#ops-alerts' }}",
              "type": "string"
            },
            {
              "id": "de16a74d-9302-4dbb-a57d-150cb5d90c18",
              "name": "text",
              "value": "={{ ($json.level === 'critical' ? ':red_circle: ' : $json.level === 'warn' ? ':warning: ' : ':information_source: ') + $json.text }}",
              "type": "string"
            },
            {
              "id": "8ce9ad01-2c26-4069-a047-3458b36f19a2",
              "name": "level",
              "value": "={{ $json.level ?? 'info' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "8996d357-98cb-4aa8-a03c-0101debf7713",
      "position": [
        520,
        180
      ],
      "name": "Post to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $json.channel }}"
        },
        "text": "={{ $json.text }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput",
      "credentials": {
        "slackApi": {
          "id": "__CRED:slack__",
          "name": "Slack"
        }
      }
    },
    {
      "id": "13c8f07f-3a66-4c92-a260-350203014922",
      "position": [
        780,
        90
      ],
      "name": "Delivered by Slack",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "682d65d0-762f-4c72-a079-09e95c7494a2",
              "name": "delivered",
              "value": "={{ 'slack' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "bc694fe5-059b-4dc6-a962-80a0ff8706f4",
      "position": [
        780,
        270
      ],
      "name": "Email instead",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "parameters": {
        "resource": "mail",
        "operation": "send",
        "fromEmail": "={{ 'hello@example.com' }}",
        "fromName": "={{ 'Acme' }}",
        "toEmail": "={{ 'ops@example.com' }}",
        "subject": "={{ 'Alert (Slack unavailable)' }}",
        "dynamicTemplate": false,
        "contentType": "text/plain",
        "contentValue": "={{ $('Compose').item.json.text }}",
        "additionalFields": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "sendGridApi": {
          "id": "__CRED:sendgrid__",
          "name": "SendGrid"
        }
      }
    },
    {
      "id": "17a0749d-9962-4fa5-ab48-39fbafd917dd",
      "position": [
        1040,
        180
      ],
      "name": "Delivered by email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "254caa7b-30b4-441c-a47b-eca106e173f6",
              "name": "delivered",
              "value": "={{ 'email' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    }
  ],
  "connections": {
    "When called": {
      "main": [
        [
          {
            "node": "Compose",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compose": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post to Slack": {
      "main": [
        [
          {
            "node": "Delivered by Slack",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Email instead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email instead": {
      "main": [
        [
          {
            "node": "Delivered by email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
