{
  "name": "Reliability · Dead letter replay",
  "nodes": [
    {
      "id": "51390283-77d8-4658-aa4a-4c9496c50dfb",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Reliability · Dead letter replay\nEvery fifteen minutes, sends parked work back to where it came from. Gives up after five attempts and tells Slack.\n\n**Platforms:** Supabase, Slack\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `shared`"
      }
    },
    {
      "id": "6ecb0768-be6a-4159-a068-fb9249e95080",
      "position": [
        0,
        180
      ],
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "6a15b899-4292-4e3e-a405-18955e12daa3",
      "position": [
        260,
        180
      ],
      "name": "Fetch pending",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "dead_letters",
        "returnAll": false,
        "limit": 50,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "={{ 'pending' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "0c44ea74-afca-4e70-ad7a-3ff08337ff46",
      "position": [
        520,
        180
      ],
      "name": "Anything parked?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "212c49fc-794e-4c2b-a04b-e30f7f0254e3",
              "leftValue": "={{ !!$json.id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c5a6514a-7420-408c-a335-87a1788a469c",
      "position": [
        780,
        90
      ],
      "name": "One at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "bfcc7750-e770-4975-a5c6-377cae385ed5",
      "position": [
        1040,
        90
      ],
      "name": "Replay",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $json.replay_url }}",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "6f01597d-3c98-4da9-ae45-030a01f29c64",
      "position": [
        1300,
        90
      ],
      "name": "Mark replayed",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "dead_letters",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('One at a time').item.json.id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "={{ 'replayed' }}"
            },
            {
              "fieldId": "replayed_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "67836a8c-6504-4ce2-ac59-61302733c1a3",
      "position": [
        1300,
        270
      ],
      "name": "Count the attempt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const row = $(\"One at a time\").first().json;\nconst attempts = (row.attempts ?? 0) + 1;\nreturn [{ json: { id: row.id, source: row.source, attempts, status: attempts >= 5 ? \"abandoned\" : \"pending\" } }];"
      }
    },
    {
      "id": "3b850c43-2ea9-4152-a0be-a0641276bcc8",
      "position": [
        1560,
        180
      ],
      "name": "Record the attempt",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "dead_letters",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "attempts",
              "fieldValue": "={{ $json.attempts }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "={{ $json.status }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "ec7c9f2e-de30-4425-ab48-9b405ba33dee",
      "position": [
        1820,
        180
      ],
      "name": "Given up?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "4a494e35-6919-4f34-abbb-2e464b0a0208",
              "leftValue": "={{ $('Count the attempt').item.json.status === 'abandoned' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "03924ad1-204a-44ab-a577-a6aff4c8d80f",
      "position": [
        2080,
        180
      ],
      "name": "Escalate",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ '#ops-alerts' }}"
        },
        "text": "={{ ':red_circle: Gave up replaying an item from ' + $('Count the attempt').item.json.source + ' after 5 attempts. It needs a person.' }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "slackApi": {
          "id": "__CRED:slack__",
          "name": "Slack"
        }
      }
    },
    {
      "id": "97169698-2ba2-4889-a68a-c87ed3d1d9fe",
      "position": [
        780,
        270
      ],
      "name": "Nothing to do",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    },
    {
      "id": "1575c803-49ba-44ae-ac96-cc9c062eb19f",
      "position": [
        1040,
        270
      ],
      "name": "All replayed",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    }
  ],
  "connections": {
