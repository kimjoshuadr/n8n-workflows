{
  "name": "Publishing · Markdown to blog draft",
  "nodes": [
    {
      "id": "384af4d2-007d-428e-a8d4-805826f168eb",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Publishing · Markdown to blog draft\nA Markdown file sent to a Telegram bot is turned into a blog post. Gemini restructures the notes, picks a recent YouTube video fetched through Apify to embed, and works in the promotion of the week. The post is saved to Wix as a draft for an editor to review.\n\n**Platforms:** Telegram, Apify, Gemini, Groq, Wix\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `production/publishing`"
      }
    },
    {
      "id": "5380ff7b-3500-4541-a74f-4a5e9deabfeb",
      "position": [
        0,
        310
      ],
      "name": "get_file",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "webhookId": "9ae5576c-409c-4dd9-ae27-12994a9a4bc6",
      "credentials": {
        "telegramApi": {
          "id": "__CRED:telegram__",
          "name": "Telegram"
        }
      }
    },
    {
      "id": "e6dc9cb6-ecf5-499c-a2e3-162a63b9d88d",
      "position": [
        260,
        310
      ],
      "name": "check_file",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "72e576fd-a202-47b1-a1e7-9e9d3839fb87",
              "leftValue": "={{ !!$json.message?.document && /\\.(md|markdown)$/i.test($json.message.document.file_name ?? '') }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a75add87-1dc0-43ab-af4f-31cd659d6f15",
      "position": [
        520,
        310
      ],
      "name": "download_md",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "parameters": {
        "resource": "file",
        "operation": "get",
        "fileId": "={{ $json.message.document.file_id }}",
        "download": true
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "telegramApi": {
          "id": "__CRED:telegram__",
          "name": "Telegram"
        }
      }
    },
    {
      "id": "3be57caf-56c9-41cc-a66d-9064b01684f4",
      "position": [
        780,
        310
      ],
      "name": "extract_md",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "parameters": {
        "operation": "text",
        "binaryPropertyName": "data",
        "destinationKey": "markdown",
        "options": {}
      }
    },
    {
      "id": "27d643a8-1957-4d60-a540-17cc9ea830b5",
      "position": [
        1040,
        310
      ],
      "name": "get_latest_yt_videos",
      "type": "@apify/n8n-nodes-apify.apify",
      "typeVersion": 2,
      "parameters": {
        "resource": "Actor tasks",
        "operation": "Run task and get dataset",
        "actorTaskId": "acme~youtube-latest-videos"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "apifyApi": {
          "id": "__CRED:apify__",
          "name": "Apify"
        }
      }
    },
    {
      "id": "9c4dde09-f0b0-4163-a660-6ec343efffd6",
      "position": [
        1400,
        90
      ],
      "name": "generate_content",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Research notes:\\n' + $('extract_md').first().json.markdown + '\\n\\nRecent videos:\\n' + $('get_latest_yt_videos').all().map((i) => i.json).filter((v) => v.url).map((v) => '- ' + v.title + ' (' + v.url + ')').join('\\n') }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "[task:blog-convert] You turn internal research notes into a blog post for the public site. Keep every fact and add none. Give it a clear title, a two-sentence excerpt and a body of short paragraphs separated by blank lines. From the list of recent videos choose the one most relevant to the post and return its URL as video_url, or an empty string if none fits. Work this promotion into one paragraph near the end, in the post's own tone: 'Join the weekly briefing: one email, every Friday.'"
            }
          ]
        },
        "batching": {}
      },
      "executeOnce": true
    },
    {
      "id": "18f670bd-bea4-4be8-a71c-5bfbf44930db",
      "position": [
        1300,
        310
      ],
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0.4
        }
      },
      "credentials": {
        "googlePalmApi": {
          "id": "__CRED:gemini__",
          "name": "Gemini"
        }
      }
    },
    {
      "id": "20aeeb6a-6448-48bf-a5bc-45cc420534ed",
      "position": [
        1500,
        310
      ],
      "name": "blog_parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserAutofixing",
      "typeVersion": 1,
      "parameters": {
        "options": {}
      }
    },
    {
      "id": "dc612c0b-8060-4a0d-abc2-5ab47121dcef",
      "position": [
        1400,
        530
      ],
      "name": "Groq Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "parameters": {
        "model": "llama-3.3-70b-versatile",
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "groqApi": {
          "id": "__CRED:groq__",
          "name": "Groq"
        }
      }
    },
    {
      "id": "8c55ed10-a398-43ba-a668-2e1521545c7a",
      "position": [
        1600,
        530
      ],
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"title\": \"The post's title\",\n  \"excerpt\": \"Two sentences.\",\n  \"body\": \"Paragraph one.\\n\\nParagraph two.\",\n  \"video_url\": \"https://www.youtube.com/watch?v=...\"\n}"
      }
    },
    {
      "id": "abe5abe4-8677-4879-af4f-bd724e935aa1",
      "position": [
        1760,
        310
      ],
      "name": "draft_wix",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://www.wixapis.com/blog/v3/draft-posts' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ draftPost: { title: $json.output.title, excerpt: $json.output.excerpt, richContent: { nodes: String($json.output.body ?? '').split('\\n\\n').filter((text) => text.trim()).map((text) => ({ type: 'PARAGRAPH', nodes: [ { type: 'TEXT', textData: { text: text.trim() } } ] })).concat($json.output.video_url ? [ { type: 'VIDEO', videoData: { video: { src: { url: $json.output.video_url } } } } ] : []) } }, publish: false }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED:wix__",
          "name": "Wix API key"
        }
      }
    }
  ],
  "connections": {
    "get_file": {
      "main": [
        [
          {
            "node": "check_file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "check_file": {
      "main": [
        [
          {
            "node": "download_md",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "download_md": {
      "main": [
        [
          {
            "node": "extract_md",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "extract_md": {
      "main": [
        [
          {
            "node": "get_latest_yt_videos",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "get_latest_yt_videos": {
      "main": [
        [
          {
            "node": "generate_content",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "generate_content": {
      "main": [
        [
          {
            "node": "draft_wix",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "generate_content",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "blog_parser": {
      "ai_outputParser": [
        [
          {
            "node": "generate_content",
            "type": "ai_outputParser",
            "index": 0
          }
        ]
      ]
    },
    "Groq Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "blog_parser",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Structured Output Parser": {
      "ai_outputParser": [
        [
          {
            "node": "blog_parser",
            "type": "ai_outputParser",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
