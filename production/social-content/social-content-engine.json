      "name": "generate_caption",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemini-2.5-flash"
        },
        "messages": {
          "values": [
            {
              "content": "={{ 'Brand: ' + $('store_temp').first().json.brand + '\\nVoice: ' + $('store_temp').first().json.voice + '\\nHashtags: ' + $('store_temp').first().json.tags + '\\n\\nHeadline: ' + $('for_each_news').first().json.title + '\\nSummary: ' + String($('for_each_news').first().json.contentSnippet ?? '').slice(0, 1500) }}",
              "role": "user"
            }
          ]
        },
        "simplify": true,
        "options": {
          "systemMessage": "[task:social-caption] You write one social media caption for a media brand. Follow the brand voice you are given exactly. Under 600 characters, one idea, no invented facts, no quotation marks around the whole caption. End with the brand's hashtags. Reply with the caption only."
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "googlePalmApi": {
          "id": "__CRED:gemini__",
          "name": "Gemini"
        }
      }
    },
