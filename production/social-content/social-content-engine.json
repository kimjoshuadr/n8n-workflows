        },
        "prompt": "={{ 'A social media graphic for the news story: ' + $('for_each_news').first().json.title + '. Style: ' + $('store_temp').first().json.look + ' No text in the image.' }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "googlePalmApi": {
          "id": "__CRED:gemini__",
          "name": "Gemini"
