        0,
        970
      ],
      "name": "generate_caption",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemini-2.5-flash"
        },
        "messages": {
          "values": [
            {
              "content": "={{ 'Brand: ' + $('store_temp').first().json.brand + '\\nVoice: ' + $('store_temp').first().json.voice + '\\nHashtags: ' + $('store_temp').first().json.tags + '\\nSource link: ' + ($('store_temp').first().json.source_url || 'none') + '\\n\\nRequest: ' + $('store_temp').first().json.request }}",
              "role": "user"
            }
          ]
        },
        "simplify": true,
        "options": {
          "systemMessage": "[task:social-caption] You write one social media caption for a media brand. Follow the brand voice you are given exactly. Under 600 characters, one idea, no invented facts, no quotation marks around the whole caption. End with the brand's hashtags. Reply with the caption only. If a source link is given, the post is about that article: say so and end with the link on its own line."
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "googlePalmApi": {
          "id": "__CRED:gemini__",
          "name": "Gemini"
        }
      }
    },
    {
      "id": "df4c2652-fab8-4a6f-a47c-e1d067b2f396",
      "position": [
        0,
        1150
      ],
      "name": "generate_image",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "parameters": {
        "resource": "image",
        "operation": "generate",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "models/gemini-2.5-flash-image"
        },
        "prompt": "={{ 'A social media graphic for: ' + $('store_temp').first().json.request.slice(0, 400) + '. Style: ' + $('store_temp').first().json.look + ' No text in the image.' }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "googlePalmApi": {
          "id": "__CRED:gemini__",
          "name": "Gemini"
        }
      }
    },
