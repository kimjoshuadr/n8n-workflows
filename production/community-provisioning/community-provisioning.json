    {
      "id": "5cc9f721-5a94-427d-a656-a740facdc0f6",
      "position": [
        1560,
        880
      ],
      "name": "prepare_access",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const buyer = $(\"set_buyer\").first().json;\nconst items = $(\"aggregate_products\").first().json.items ?? [];\nconst user = $input.first().json;\nconst roles = [...new Set(items.filter((i) => i.kind === \"bot\").map((i) => i.role))];\nconst invites = items.filter((i) => i.kind === \"community\").map((i) => ({ email: buyer.email, tier: i.tier, group: i.group }));\nconst owned = new Set(String(user.products).split(\",\").filter(Boolean));\nfor (const i of items) owned.add(i.product);\nreturn [{ json: { ...buyer, is_new: String(user.is_new) === \"true\", products: [...owned].sort().join(\",\"), roles: roles.join(\",\"), has_bot: roles.length > 0, invites, has_community: invites.length > 0, secret_code: user.secret_code } }];"
      }
    },
