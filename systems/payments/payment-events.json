{
  "name": "Payments · Event ledger",
  "nodes": [
    {
      "id": "c1f6502e-fdfb-47ed-a4ba-3af6e117ecad",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Payments · Event ledger\nRecords each payment, failure and refund from the processor exactly once, updates the invoice, and sends the receipt or the retry notice.\n\n**Platforms:** Stripe, Supabase, SendGrid\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/payments`"
      }
    },
    {
      "id": "1df99ca6-66d9-4b26-aea8-189f0cd074b0",
      "position": [
        0,
        360
      ],
      "name": "Payment event",
      "type": "n8n-nodes-base.stripeTrigger",
      "typeVersion": 1,
      "parameters": {
        "events": [
          "payment_intent.succeeded",
          "payment_intent.payment_failed",
          "charge.refunded"
        ]
      },
      "webhookId": "d1431833-bf16-4589-adf9-cba3c692591e",
      "credentials": {
        "stripeApi": {
          "id": "__CRED:stripe__",
          "name": "Stripe"
        }
      }
    },
    {
      "id": "4539a812-c446-4942-a270-b7c15a47ff83",
      "position": [
        260,
        360
      ],
      "name": "Read the event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const e = $(\"Payment event\").first().json ?? {};\nconst o = e.data?.object ?? {};\nif (!e.id || !e.type) throw new Error(\"Event has no id or type\");\nreturn [{ json: { event_id: String(e.id), type: e.type, amount: Number(o.amount ?? 0) / 100, currency: String(o.currency ?? \"usd\").toUpperCase(), invoice_id: o.metadata?.invoice_id ?? null, email: o.receipt_email ?? o.billing_details?.email ?? null, charge_id: o.id ?? null, scope: \"payment-event\", key: String(e.id) } }];"
      }
    },
    {
      "id": "ebc81471-1db2-4394-a815-bae534df600a",
      "position": [
        520,
        360
      ],
      "name": "Seen before?",
