              "fieldId": "event_id",
              "fieldValue": "={{ $json.event_id }}"
            },
            {
              "fieldId": "charge_id",
              "fieldValue": "={{ $json.charge_id }}"
            },
            {
              "fieldId": "kind",
              "fieldValue": "={{ 'payment' }}"
            },
            {
              "fieldId": "amount",
              "fieldValue": "={{ $json.amount }}"
