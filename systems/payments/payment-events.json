      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "payment-event",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "daf11e40-9a91-48af-af82-c2485782af2d"
    },
