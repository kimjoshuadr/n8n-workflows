        "jsonBody": "={{ JSON.stringify({ to: $('New event?').first().json.email, subject: 'Receipt for your payment', template: 'receipt', data: { amount: $('New event?').first().json.amount, currency: $('New event?').first().json.currency } }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
