      ],
      "name": "Signed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "3b98ad77-7366-49b1-a86c-8bdb20d41ed2",
              "leftValue": "={{ $json.headers['x-webhook-secret'] === $env.PAYMENTS_WEBHOOK_SECRET }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ddba1875-6030-497e-a8df-19bf02596182",
      "position": [
        480,
        -90
      ],
      "name": "Unauthorised",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false }) }}",
        "options": {
          "responseCode": 401
        }
      }
    },
    {
      "id": "4539a812-c446-4942-a270-b7c15a47ff83",
      "position": [
        480,
        90
      ],
      "name": "Read the event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const e = $(\"Payment event\").first().json.body ?? {};\nconst o = e.data?.object ?? {};\nif (!e.id || !e.type) throw new Error(\"Event has no id or type\");\nreturn [{ json: { event_id: String(e.id), type: e.type, amount: Number(o.amount ?? 0) / 100, currency: String(o.currency ?? \"usd\").toUpperCase(), invoice_id: o.metadata?.invoice_id ?? null, email: o.receipt_email ?? o.billing_details?.email ?? null, charge_id: o.id ?? null, scope: \"payment-event\", key: String(e.id) } }];"
      }
    },
    {
      "id": "ebc81471-1db2-4394-a815-bae534df600a",
      "position": [
        720,
        0
      ],
      "name": "Seen before?",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:idempotency-guard__"
        },
        "options": {}
      }
    },
