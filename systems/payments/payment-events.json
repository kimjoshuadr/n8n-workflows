{
  "name": "Payments · Event ledger",
  "nodes": [
    {
      "id": "c1f6502e-fdfb-47ed-a4ba-3af6e117ecad",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -570
      ],
      "parameters": {
        "width": 620,
        "height": 220,
        "content": "## Payments · Event ledger\nRecords each payment, failure and refund from the processor exactly once, updates the invoice, and sends the receipt or the retry notice.\n\n**Needs:** DB_API_KEY, DB_BASE_URL, EMAIL_API_KEY, EMAIL_BASE_URL, PAYMENTS_WEBHOOK_SECRET\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/payments`"
      }
    },
