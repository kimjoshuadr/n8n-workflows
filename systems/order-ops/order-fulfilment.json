{
  "name": "Order ops · Shipping updates",
  "nodes": [
    {
      "id": "1a0623a0-5b0b-47cd-a488-da7b9b080335",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Order ops · Shipping updates\nTurns a courier status into the right message for the customer, and tells a person when a parcel fails delivery.\n\n**Platforms:** Supabase, SendGrid\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/order-ops`"
      }
    },
    {
      "id": "42df853a-d0a6-4919-af5f-9735fc36a8f3",
      "position": [
        0,
        180
      ],
      "name": "Shipment update",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "shipment-update",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "9ee8bb0d-9d24-44a2-a279-02a699847594"
    },
    {
      "id": "71fd70e8-dfba-4bb5-ad59-1035a4e2bff4",
      "position": [
        260,
        180
      ],
      "name": "Read the update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nconst map = { in_transit: \"shipped\", out_for_delivery: \"out_for_delivery\", delivered: \"delivered\", failure: \"failed\", returned: \"failed\" };\nreturn [{ json: { order_id: String(b.order_id), status: map[b.status] ?? null, raw_status: b.status, tracking_url: b.tracking_url ?? null } }];"
      }
    },
    {
      "id": "c15724f6-79aa-4d95-a7d4-53743f7e0e69",
      "position": [
        520,
        180
      ],
      "name": "A status we act on?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "98cbfed8-5978-4210-a46b-abd00a8559b1",
              "leftValue": "={{ !!$json.status }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "cc409fbe-411d-4196-ae48-6f0559fd5099",
      "position": [
        780,
        90
      ],
      "name": "Update the order",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "orders",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "order_id",
              "condition": "eq",
              "keyValue": "={{ $json.order_id }}"
            },
            {
              "keyName": "status",
              "condition": "neq",
              "keyValue": "={{ $json.status }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "={{ $json.status }}"
            },
            {
              "fieldId": "tracking_url",
              "fieldValue": "={{ $json.tracking_url }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "16d95082-c695-421d-a908-179fb68bc8d6",
      "position": [
        1040,
        180
      ],
      "name": "Changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b0c90d96-8370-4846-a659-2b812095c918",
              "leftValue": "={{ !!$json.order_id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "2240c39f-6021-4317-aea2-bfd89ac4a6e7",
      "position": [
        1300,
        90
      ],
      "name": "Which status?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "17a583db-94cf-4738-a9ab-7d99757647b8",
                    "leftValue": "={{ $json.status === 'failed' }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "failed"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "6eb79a8a-b24f-4bb7-a5d7-4f96bdd185c8",
      "position": [
        1560,
        90
      ],
      "name": "Email the customer",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "parameters": {
        "resource": "mail",
        "operation": "send",
        "fromEmail": "={{ 'hello@example.com' }}",
        "fromName": "={{ 'Acme' }}",
        "toEmail": "={{ $json.email }}",
        "dynamicTemplate": true,
        "templateId": "={{ 'd-shipping-' + $json.status }}",
        "dynamicTemplateFields": {
          "fields": [
            {
              "key": "order_id",
              "value": "={{ $json.order_id }}"
            },
            {
              "key": "tracking_url",
              "value": "={{ $json.tracking_url }}"
            }
          ]
        },
        "additionalFields": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "sendGridApi": {
          "id": "__CRED:sendgrid__",
          "name": "SendGrid"
        }
      }
    },
    {
      "id": "d038a7e2-f962-40cd-a0c9-cd7da023a8ca",
      "position": [
        1560,
        270
      ],
      "name": "Failed delivery message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const o = $input.first().json;\nreturn [{ json: { text: \"Delivery failed for order \" + o.order_id + \" (\" + o.email + \"). Someone should contact the customer.\", level: \"warn\" } }];"
      }
    },
    {
      "id": "62d5b452-f997-4bcd-a93c-4054d8681bca",
      "position": [
        1820,
        180
      ],
      "name": "Tell support",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:notify__"
        },
        "options": {}
      }
    },
    {
      "id": "00910118-420e-460a-a6ac-8ee760218b5b",
