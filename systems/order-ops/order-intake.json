{
  "name": "Order ops · New order",
  "nodes": [
    {
      "id": "61f98cfa-6899-42ea-ae54-c2b6386cf5e0",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Order ops · New order\nTakes a new order from the store, records it once, takes its items out of stock, confirms to the customer, and warns the team about anything running low.\n\n**Platforms:** Shopify, Supabase, SendGrid\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/order-ops`"
      }
    },
    {
      "id": "4912eeaa-972c-4c81-abc2-f564361e5215",
      "position": [
        0,
        180
      ],
      "name": "Order created",
      "type": "n8n-nodes-base.shopifyTrigger",
      "typeVersion": 1,
      "parameters": {
        "authentication": "accessToken",
        "topic": "orders/create"
      },
      "webhookId": "ba75f716-9226-4635-a13e-b6ee1ff3dc3b",
      "credentials": {
        "shopifyAccessTokenApi": {
          "id": "__CRED:shopify__",
          "name": "Shopify"
        }
      }
    },
    {
      "id": "412e6bc2-f528-496a-a29c-f6ad22f9639f",
      "position": [
        260,
        180
      ],
      "name": "Read the order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const o = $(\"Order created\").first().json ?? {};\nconst lines = (o.line_items ?? []).map((l) => ({ sku: String(l.sku), title: l.title, quantity: Number(l.quantity ?? 1), price: Number(l.price ?? 0) }));\nif (!o.id || !lines.length) throw new Error(\"Order has no id or no line items\");\nreturn [{ json: { order_id: String(o.id), email: String(o.email ?? \"\").toLowerCase(), customer: o.customer?.first_name ?? \"there\", currency: o.currency ?? \"USD\", total: lines.reduce((s, l) => s + l.price * l.quantity, 0), lines, scope: \"order\", key: String(o.id) } }];"
      }
    },
    {
      "id": "fbdbb6e8-80be-47db-a1ca-d73cc6e69219",
      "position": [
        520,
        180
      ],
      "name": "Seen before?",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:idempotency-guard__"
        },
        "options": {}
      }
    },
    {
      "id": "d373d0f6-019d-4fe9-ad72-b5c0c6fce154",
      "position": [
        780,
        180
      ],
      "name": "New order?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "329a3aa1-9117-4f22-a02c-8bc23c2ad92b",
              "leftValue": "={{ !$json.duplicate }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ac0b0063-a396-4721-ae59-bdfe7a64f22b",
      "position": [
        1040,
        90
      ],
      "name": "Already handled",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    },
    {
      "id": "aef03a4a-86e2-4430-a437-6db3c673ce6c",
      "position": [
        1040,
        270
      ],
      "name": "Save the order",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "orders",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "order_id",
              "fieldValue": "={{ $json.order_id }}"
            },
            {
              "fieldId": "email",
              "fieldValue": "={{ $json.email }}"
            },
            {
              "fieldId": "total",
              "fieldValue": "={{ $json.total }}"
            },
            {
              "fieldId": "currency",
              "fieldValue": "={{ $json.currency }}"
            },
            {
              "fieldId": "lines",
              "fieldValue": "={{ $json.lines }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "={{ 'paid' }}"
            },
            {
              "fieldId": "created_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "4f2935f7-e7e4-4c8b-a0cf-64b2f5a6883a",
      "position": [
        1300,
        90
      ],
      "name": "One item per line",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return $(\"New order?\").first().json.lines.map((l) => ({ json: { ...l, order_id: $(\"New order?\").first().json.order_id } }));"
      }
    },
    {
      "id": "fffc4284-4dee-4e19-a621-58d9e1b9e7bd",
      "position": [
        1560,
        180
      ],
      "name": "Take from stock",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://acme-store.myshopify.com/admin/api/2025-01' + '/inventory_levels/adjust.json' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "shopifyAccessTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sku: $json.sku, available_adjustment: -$json.quantity }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput",
      "credentials": {
        "shopifyAccessTokenApi": {
          "id": "__CRED:shopify__",
          "name": "Shopify"
        }
      }
    },
    {
      "id": "7e13d170-9ffb-402a-a058-fe6e355013da",
      "position": [
        1820,
        90
      ],
      "name": "What is running low?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const lines = $(\"One item per line\").all();\nconst low = $input.all().map((item, i) => ({ sku: lines[i]?.json.sku, title: lines[i]?.json.title, available: item.json.available }))\n  .filter((l) => typeof l.available === \"number\" && l.available <= 5);\nreturn [{ json: { low, any_low: low.length > 0, text: \"Running low: \" + low.map((l) => l.title + \" (\" + l.available + \" left)\").join(\", \"), level: \"warn\" } }];"
      }
    },
    {
      "id": "009ffea0-ce7e-4e68-abf4-8f0aa7d3c022",
      "position": [
        2080,
        90
      ],
      "name": "Anything low?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f07e346e-e9ed-448c-a80d-c71f3546b380",
              "leftValue": "={{ $json.any_low }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ec573f0a-d530-455d-ab22-68d2bc56d010",
      "position": [
        2340,
        180
      ],
      "name": "Warn the team",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:notify__"
        },
        "options": {}
      }
    },
    {
      "id": "991c63e2-d785-4358-ad19-0d208e3a6370",
      "position": [
        1300,
        270
      ],
      "name": "Confirm to customer",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "parameters": {
        "resource": "mail",
        "operation": "send",
        "fromEmail": "={{ 'hello@example.com' }}",
        "fromName": "={{ 'Acme' }}",
        "toEmail": "={{ $('New order?').first().json.email }}",
        "dynamicTemplate": true,
        "templateId": "={{ 'd-order-confirmation' }}",
        "dynamicTemplateFields": {
          "fields": [
            {
              "key": "name",
              "value": "={{ $('New order?').first().json.customer }}"
            },
            {
              "key": "lines",
              "value": "={{ $('New order?').first().json.lines }}"
            },
            {
              "key": "total",
              "value": "={{ $('New order?').first().json.total }}"
            }
          ]
        },
        "additionalFields": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "sendGridApi": {
          "id": "__CRED:sendgrid__",
          "name": "SendGrid"
        }
      }
    },
    {
      "id": "45c11ce1-b33f-41de-a7cc-f7d4587fb60c",
      "position": [
        1820,
        270
      ],
      "name": "Stock failure payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const l = $input.first().json;\nreturn [{ json: { source: \"order-intake\", reason: \"Stock could not be adjusted for an order line\", payload: { order_id: $(\"New order?\").first().json.order_id, lines: $(\"New order?\").first().json.lines } } }];"
      }
    },
    {
      "id": "574b9e51-0991-40fe-ab59-8e18023544d7",
