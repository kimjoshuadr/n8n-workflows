{
  "name": "Ops digest · Threshold alerts",
  "nodes": [
    {
      "id": "1cf17200-10f8-4a06-afed-3cff6965ac54",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -300
      ],
      "parameters": {
        "width": 620,
        "height": 220,
        "content": "## Ops digest · Threshold alerts\nChecks each watched number hourly and alerts when it crosses its line, and again when it recovers. It does not repeat itself in between.\n\n**Needs:** DB_API_KEY, DB_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/ops-digest`"
      }
    },
    {
      "id": "1a6ad27d-7a53-4d76-a8c2-44f8b619a7b8",
      "position": [
        0,
        0
      ],
      "name": "Hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "ed15231e-e603-486a-a912-74d2e74361e2",
      "position": [
        240,
        0
      ],
      "name": "Watched metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DB_BASE_URL }}/watched_metrics",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true
    },
    {
      "id": "5be3ce3c-3733-4b61-ae89-0d385cc71629",
      "position": [
        480,
        0
      ],
      "name": "Which changed state?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return $input.all().map((i) => i.json).filter((m) => m.name && typeof m.value === \"number\").map((m) => {\n  const breached = m.direction === \"below\" ? m.value < m.threshold : m.value > m.threshold;\n  const state = breached ? \"breached\" : \"ok\";\n  return { ...m, state, changed: state !== (m.last_state ?? \"ok\") };\n}).filter((m) => m.changed).map((json) => ({ json }));"
      }
    },
    {
      "id": "92b216ff-2d58-4282-ad84-831c4797cf30",
      "position": [
        720,
        0
      ],
      "name": "Remember the state",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.DB_BASE_URL }}/watched_metrics",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "name",
              "value": "={{ 'eq.' + $json.name }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ last_state: $json.state, state_changed_at: $now.toISO() }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "4e3d101a-2c1a-4380-a90f-59dce9486914",
      "position": [
        960,
        0
      ],
      "name": "Alert text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const before = $(\"Which changed state?\").all();\nreturn $input.all().map((item, i) => { const m = before[i].json; return { json: { level: m.state === \"breached\" ? \"critical\" : \"info\", text: m.state === \"breached\" ? m.name + \" is \" + m.value + \", \" + m.direction + \" its line of \" + m.threshold + \".\" : m.name + \" is back to normal at \" + m.value + \".\" } }; });"
      }
    },
    {
      "id": "354f2720-f0dc-410d-a01c-d2aa1e984f6c",
      "position": [
        1200,
        0
      ],
      "name": "Alert",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:notify__"
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Hourly": {
      "main": [
        [
          {
            "node": "Watched metrics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Watched metrics": {
      "main": [
        [
          {
            "node": "Which changed state?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Which changed state?": {
      "main": [
        [
          {
            "node": "Remember the state",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Remember the state": {
      "main": [
        [
          {
            "node": "Alert text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert text": {
      "main": [
        [
          {
            "node": "Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
