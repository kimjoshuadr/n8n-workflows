    {
      "id": "635da5aa-34a8-4aef-a80a-d70b0f2abecc",
      "position": [
        1300,
        220
      ],
      "name": "Work out the week",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const weekAgo = Date.now() - 7 * 864e5;\nconst rows = (name) => { try { return $(name).all().map((i) => i.json).filter((r) => r && !r.error); } catch (e) { return null; } };\nconst split = (list, field) => {\n  const cur = list.filter((r) => new Date(r[field]).getTime() >= weekAgo);\n  return [cur, list.filter((r) => new Date(r[field]).getTime() < weekAgo)];\n};\nconst change = (now, before) => (before ? Math.round(((now - before) / before) * 100) : null);\nconst metric = (label, now, before, unit = \"\") => ({ label, now, before, change: change(now, before), unit });\nconst out = [];\nconst unavailable = [];\n\nconst leads = rows(\"Leads\")?.filter((r) => r.received_at);\nif (leads) { const [c, p] = split(leads, \"received_at\"); out.push(metric(\"New leads\", c.length, p.length)); out.push(metric(\"Qualified leads\", c.filter((l) => l.fit === true).length, p.filter((l) => l.fit === true).length)); } else unavailable.push(\"leads\");\n\nconst orders = rows(\"Orders\")?.filter((r) => r.created_at);\nif (orders) { const [c, p] = split(orders, \"created_at\"); const sum = (l) => Math.round(l.reduce((s, o) => s + Number(o.total ?? 0), 0)); out.push(metric(\"Orders\", c.length, p.length)); out.push(metric(\"Revenue\", sum(c), sum(p))); } else unavailable.push(\"orders\");\n\nconst support = rows(\"Support\")?.filter((r) => r.at);\nif (support) { const [c, p] = split(support, \"at\"); const rate = (l) => (l.length ? Math.round((l.filter((s) => s.answered).length / l.length) * 100) : 0); out.push(metric(\"Support conversations\", c.length, p.length)); out.push(metric(\"Answered by the agent\", rate(c), rate(p), \"%\")); } else unavailable.push(\"support\");\n\nconst traffic = $(\"Site traffic\").first()?.json?.result?.[0]?.data;\nif (Array.isArray(traffic) && traffic.length >= 14) { const s = (a) => a.reduce((x, y) => x + y, 0); out.push(metric(\"Site visits\", s(traffic.slice(-7)), s(traffic.slice(-14, -7)))); } else unavailable.push(\"site traffic\");\n\nconst lines = out.map((m) => m.label + \": \" + m.now + m.unit + (m.change === null ? \"\" : \" (\" + (m.change >= 0 ? \"+\" : \"\") + m.change + \"% on last week)\"));\nreturn [{ json: { metrics: out, unavailable, table: lines.join(\"\\n\"), week_of: new Date(weekAgo).toISOString().slice(0, 10) } }];"
      }
    },
    {
      "id": "b2f0ee23-8279-4608-ac96-f15e51b2cf10",
      "position": [
        1560,
        90
      ],
      "name": "Write the summary",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.table + ($json.unavailable.length ? '\\nUnavailable this week: ' + $json.unavailable.join(', ') : '') }}",
        "hasOutputParser": false,
        "options": {
          "systemMessage": "[task:summarise] Write a four-sentence summary of this week's numbers for a business owner. Say what moved most and what deserves attention. Use only the numbers given. Do not invent causes.",
          "maxIterations": 2
        }
      },
      "onError": "continueRegularOutput"
    },
    {
