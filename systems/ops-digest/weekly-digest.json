    },
    {
      "id": "99be993a-d78a-4dcf-a48f-4a5405f08564",
      "position": [
        1820,
        220
      ],
      "name": "Compose",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const w = $(\"Work out the week\").first().json;\nconst summary = $input.first().json.output ?? \"(The written summary is unavailable this week. The numbers are below.)\";\nconst note = w.unavailable.length ? \"\\n\\nNot included, because the source did not answer: \" + w.unavailable.join(\", \") + \".\" : \"\";\nreturn [{ json: { subject: \"Week of \" + w.week_of, text: summary + \"\\n\\n\" + w.table + note } }];"
      }
    },
