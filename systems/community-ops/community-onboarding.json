{
  "name": "Community ops · Member onboarding",
  "nodes": [
    {
      "id": "5272c6f9-c9a3-4a27-a309-8982c71da519",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Community ops · Member onboarding\nWelcomes a new member, gives them the starter role, records them, and flags accounts created minutes ago for a moderator to look at.\n\n**Platforms:** Supabase, Discord\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/community-ops`"
      }
    },
    {
      "id": "e059afcd-3601-4e69-a3d7-22b8df581ab1",
      "position": [
        0,
        180
      ],
      "name": "Member joined",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "member-joined",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "6e6bf0fc-804f-4050-a9da-a756b5aef125"
    },
    {
      "id": "4e0dec90-ac80-41e2-aae3-0d4a1ecea46e",
      "position": [
        260,
        180
      ],
      "name": "Read the member",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const m = $input.first().json.body ?? {};\nconst created = m.user?.created_at ? new Date(m.user.created_at).getTime() : null;\nconst ageDays = created ? (Date.now() - created) / 864e5 : null;\nreturn [{ json: { user_id: String(m.user?.id), username: m.user?.username ?? \"new member\", guild_id: String(m.guild_id), bot: !!m.user?.bot, account_age_days: ageDays === null ? null : Math.floor(ageDays), suspicious: ageDays !== null && ageDays < 1, scope: \"member-joined\", key: m.guild_id + \":\" + m.user?.id } }];"
      }
    },
    {
      "id": "95ec3f75-8384-49d8-ad60-1bbc0cc3124c",
      "position": [
        520,
        180
      ],
      "name": "A person?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "125b1fb0-66b3-4459-ae26-eeb5531ab86c",
              "leftValue": "={{ !$json.bot }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "be2489a8-0193-46f5-a5fb-d07430bde7d3",
      "position": [
        780,
        90
      ],
      "name": "Seen before?",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:idempotency-guard__"
        },
        "options": {}
      }
    },
    {
      "id": "d7a1aae2-1f8e-4e2c-a079-20ff98850948",
      "position": [
        1040,
        180
      ],
      "name": "First join?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a50052a4-c487-47a8-a08d-359ddeb5e712",
              "leftValue": "={{ !$json.duplicate }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "536eb07d-1ee8-4cbd-a0a3-203e85d5e5c5",
      "position": [
        1300,
        90
      ],
      "name": "Save the member",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "members",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "user_id",
              "fieldValue": "={{ $json.user_id }}"
            },
            {
              "fieldId": "username",
              "fieldValue": "={{ $json.username }}"
            },
            {
              "fieldId": "guild_id",
              "fieldValue": "={{ $json.guild_id }}"
            },
            {
              "fieldId": "joined_at",
              "fieldValue": "={{ $now.toISO() }}"
            },
            {
              "fieldId": "suspicious",
              "fieldValue": "={{ $json.suspicious }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "fdae915b-fb3a-4004-a837-e8f949ed2232",
      "position": [
