    {
      "id": "b12e7464-4f69-488e-a292-1c3b581452fc",
      "position": [
        1820,
        90
      ],
      "name": "Review message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const m = $(\"First join?\").first().json;\nreturn [{ json: { channel: \"#mods\", level: \"warn\", text: m.username + \" joined with an account under a day old. Held without a role until someone checks.\" } }];"
      }
    },
