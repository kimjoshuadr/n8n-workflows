{
  "name": "Community ops · Scheduled announcements",
  "nodes": [
    {
      "id": "102ecbf1-c4d8-4df8-a281-9ca0252cdc62",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Community ops · Scheduled announcements\nPosts announcements at the time they were scheduled for, once, and reports any that could not be posted.\n\n**Platforms:** Supabase, Discord\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/community-ops`"
      }
    },
    {
      "id": "94a3fee6-4122-409d-a687-86e048b23b04",
      "position": [
        0,
        180
      ],
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "e18b8fd2-19a7-472a-abf3-226d8e12a57f",
      "position": [
        260,
        180
      ],
      "name": "Due announcements",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "announcements",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "={{ 'scheduled' }}"
            },
            {
              "keyName": "send_at",
              "condition": "lte",
              "keyValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "93c7d4cd-691f-4efc-a129-1725bdbcea4b",
      "position": [
        520,
        180
      ],
      "name": "Any due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "7125bf0e-bf22-4fac-a3ea-eb96788fcc72",
              "leftValue": "={{ !!$json.id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "827d27d6-4baa-4653-ab50-756f07e67c05",
      "position": [
        780,
        90
      ],
      "name": "Claim it",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "announcements",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            },
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "={{ 'scheduled' }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "={{ 'sending' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "4e9bed98-201b-4067-a15b-6dc31d676d3c",
      "position": [
        1040,
        180
      ],
      "name": "Claimed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "d2884e8b-6ff0-4d17-a44b-f99996ad5e65",
              "leftValue": "={{ !!$json.id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "15c59722-fa30-44b8-a0f1-5313b8358198",
      "position": [
        1300,
        180
      ],
      "name": "Post it",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "parameters": {
        "authentication": "botToken",
        "resource": "message",
        "operation": "send",
        "guildId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ '100000000000000001' }}"
        },
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.channel_id }}"
        },
        "content": "={{ $json.content }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "discordBotApi": {
          "id": "__CRED:discord__",
          "name": "Discord"
        }
      }
    },
    {
      "id": "656b5821-8b52-44cf-a645-659353213818",
      "position": [
        1560,
        180
      ],
      "name": "Posted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "959be091-4f39-4086-a411-1b3fb6712f34",
              "leftValue": "={{ !!$json.id && !$json.error }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "8c10dae4-67df-420a-a827-914fff88de0d",
      "position": [
        1820,
        90
      ],
      "name": "Mark sent",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "announcements",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Claimed?').item.json.id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "={{ 'sent' }}"
            },
            {
              "fieldId": "sent_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "bd231682-82ba-4c0d-a09f-a46fcc86076d",
      "position": [
        1820,
        270
      ],
      "name": "Mark failed",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "announcements",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Claimed?').item.json.id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "={{ 'failed' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "b8c9a21d-f837-4a5a-a4bf-553c9cdccf9f",
      "position": [
        2080,
        180
      ],
      "name": "Failure message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return $input.all().map((i) => ({ json: { channel: \"#mods\", level: \"warn\", text: \"An announcement could not be posted and was marked failed: \\\"\" + String(i.json.content ?? \"\").slice(0, 120) + \"\\\"\" } }));"
      }
    },
    {
      "id": "846f044b-d042-484b-a597-9b0e21a47e6c",
      "position": [
        2340,
        180
      ],
      "name": "Tell the team",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:notify__"
        },
        "options": {}
      }
    },
    {
      "id": "69c0f051-6c6b-496e-aea2-44e3fda0d8a9",
      "position": [
        780,
        270
      ],
      "name": "Nothing due",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Due announcements",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Due announcements": {
      "main": [
        [
          {
            "node": "Any due?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any due?": {
      "main": [
        [
          {
            "node": "Claim it",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Nothing due",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim it": {
      "main": [
        [
          {
            "node": "Claimed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claimed?": {
      "main": [
        [
          {
            "node": "Post it",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post it": {
      "main": [
        [
          {
            "node": "Posted?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Posted?": {
      "main": [
        [
          {
            "node": "Mark sent",
            "type": "main",
