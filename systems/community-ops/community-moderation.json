{
  "name": "Community ops · Message moderation",
  "nodes": [
    {
      "id": "4ae7b133-d2e3-42a0-adda-0c5d6184399c",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Community ops · Message moderation\nChecks each message, removes clear scams, sends borderline ones to moderators, and never removes anything when the model is unavailable.\n\n**Platforms:** OpenAI, Discord, Supabase\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/community-ops`"
      }
    },
    {
      "id": "33f2ea2b-1e10-4c10-a294-caf65a4127a1",
      "position": [
        0,
        270
      ],
      "name": "Message posted",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "message-posted",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "42c0b335-8a60-43d0-ae21-bacba975d234"
    },
    {
      "id": "1b61e473-e7c9-426e-a31b-2b99e70f33ef",
      "position": [
        260,
        270
      ],
      "name": "Read the message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const m = $input.first().json.body ?? {};\nconst roles = m.member?.roles ?? [];\nif (m.author?.bot || roles.includes(\"moderator\") || roles.includes(\"admin\")) return [];\nconst content = String(m.content ?? \"\").trim();\nif (!content) return [];\nreturn [{ json: { message_id: String(m.id), channel_id: String(m.channel_id), user_id: String(m.author?.id), username: m.author?.username ?? \"unknown\", content: content.slice(0, 2000) } }];"
      }
    },
    {
      "id": "f207acb2-b765-4972-aaf0-3b903b66e2ba",
      "position": [
        620,
        140
      ],
      "name": "Judge it",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.content }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "[task:moderate] You moderate a community server. Reply with JSON: { action: 'allow'|'review'|'remove', reason: string }. Remove only clear scams, phishing links and threats. Use review for insults and anything you are unsure about. Disagreement and criticism are allowed.",
          "maxIterations": 2
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "1eaf493c-5ccf-4d85-ab7b-965410461062",
      "position": [
        520,
        360
      ],
      "name": "Judge it · GPT",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "__CRED:openai__",
          "name": "OpenAI"
        }
      }
    },
    {
      "id": "720ca1dd-1af5-482f-af87-5825184e8430",
      "position": [
        720,
        360
      ],
      "name": "Judge it · shape",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"action\": \"allow\",\n  \"reason\": \"Why.\"\n}"
      }
    },
    {
      "id": "c79361ed-de8f-4c6a-a2d9-91fc2ee5f564",
      "position": [
        980,
        270
      ],
      "name": "Read the verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const before = $(\"Read the message\").all();\nconst out = [];\nfor (const [i, item] of $input.all().entries()) {\n  const answer = item.json.output;\n  const ok = answer && typeof answer === \"object\" && !Array.isArray(answer);\n  out.push({ json: { ...(before[i]?.json ?? {}), ...(ok ? answer : {\"action\":\"review\",\"reason\":\"The model was unavailable, so a person should look.\"}), parse_error: !ok } });\n}\nreturn out;"
      }
    },
    {
      "id": "2a9c7d7c-5aeb-4529-a878-b59740499487",
      "position": [
        1240,
        270
      ],
      "name": "What to do?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "95b7d632-94c2-427f-ab67-f8ffcd58fa6a",
                    "leftValue": "={{ $json.action === 'remove' && !$json.parse_error }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "remove"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "21dcef02-12cc-46f4-ad39-d844961aab82",
                    "leftValue": "={{ $json.action === 'review' || $json.parse_error }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "review"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "2cc4b682-85e5-4cf0-a678-272cd16265e0",
      "position": [
        1500,
        90
      ],
      "name": "Delete the message",
      "type": "n8n-nodes-base.discord",
      "typeVersion": 2,
      "parameters": {
        "authentication": "botToken",
        "resource": "message",
        "operation": "deleteMessage",
        "guildId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ '100000000000000001' }}"
        },
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.channel_id }}"
        },
        "messageId": "={{ $json.message_id }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "discordBotApi": {
          "id": "__CRED:discord__",
          "name": "Discord"
        }
      }
    },
    {
      "id": "6677c49a-18c8-444e-ace4-f2eb1aa9bd1b",
      "position": [
        1760,
        270
      ],
      "name": "Time the author out",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PATCH",
        "url": "={{ 'https://discord.com/api/v10/guilds/100000000000000001/members/' + $('What to do?').first().json.user_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "discordBotApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ communication_disabled_until: $now.plus({ minutes: 60 }).toISO() }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "discordBotApi": {
          "id": "__CRED:discord__",
          "name": "Discord"
        }
      }
    },
    {
      "id": "42eba279-1d64-4fc0-a50d-b8316047edf6",
      "position": [
        2020,
        270
      ],
      "name": "Log the action",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "moderation_log",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "message_id",
              "fieldValue": "={{ $('What to do?').first().json.message_id }}"
            },
            {
              "fieldId": "user_id",
              "fieldValue": "={{ $('What to do?').first().json.user_id }}"
            },
            {
              "fieldId": "action",
              "fieldValue": "={{ 'removed' }}"
            },
            {
              "fieldId": "reason",
              "fieldValue": "={{ $('What to do?').first().json.reason }}"
            },
            {
              "fieldId": "content",
              "fieldValue": "={{ $('What to do?').first().json.content }}"
            },
            {
              "fieldId": "at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "6fd1f7c1-e801-4df2-a48c-41a1d530e9a1",
      "position": [
        2280,
        270
      ],
      "name": "Removed message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const m = $(\"What to do?\").first().json;\nreturn [{ json: { channel: \"#mods\", level: \"info\", text: \"Removed a message from \" + m.username + \" and timed them out for an hour. Reason: \" + m.reason } }];"
      }
    },
    {
      "id": "cfef1a6f-3e53-45ee-a625-667d79d8eff3",
      "position": [
        1500,
        270
      ],
      "name": "Review message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const m = $input.first().json;\nreturn [{ json: { channel: \"#mods\", level: \"warn\", text: \"Please look at a message from \" + m.username + \": \\\"\" + m.content.slice(0, 200) + \"\\\". Reason: \" + m.reason } }];"
      }
    },
    {
      "id": "c94baa18-48f5-4d99-a38b-de71b931f840",
      "position": [
        2540,
        270
      ],
      "name": "Tell moderators",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:notify__"
        },
        "options": {}
      }
    },
    {
      "id": "f36881e3-2c0c-41fe-a8e4-7cda9cadc893",
      "position": [
        1500,
        450
      ],
      "name": "Leave it",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    }
  ],
