{
  "name": "Support agent · Answer or hand over",
  "nodes": [
    {
      "id": "6bbc5ad0-786c-4b5d-a7c3-142e5ef897f8",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Support agent · Answer or hand over\nAnswers a customer's message from the help centre when it is confident, and hands the conversation to a person with a summary when it is not.\n\n**Platforms:** none, this is logic only\n**Settings:** DB_API_KEY, DB_BASE_URL, HELPDESK_API_KEY, HELPDESK_BASE_URL, LLM_API_KEY, LLM_BASE_URL, LLM_MODEL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/support-agent`"
      }
    },
    {
      "id": "2866a047-ee8e-4164-a73d-5a2df239ffd8",
      "position": [
        0,
        180
      ],
      "name": "Message received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "support-message",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "6bfbeacb-4ae7-4ca9-a61f-927a4aef03c8"
    },
    {
      "id": "53043ff1-cc25-4195-a7bd-f4443123d123",
      "position": [
        260,
        180
      ],
      "name": "Read the message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nif (b.message_type && b.message_type !== \"incoming\") return []; // our own replies come back as events too\nconst text = String(b.content ?? \"\").trim();\nif (!text) return [];\nreturn [{ json: {\n  conversation_id: String(b.conversation?.id ?? b.conversation_id),\n  message_id: String(b.id),\n  text: text.slice(0, 3000),\n  customer: b.sender?.name ?? \"Customer\",\n  scope: \"support-message\", key: String(b.id),\n} }];"
      }
    },
    {
      "id": "11edd7ca-6ce2-4811-ada1-025b1f916dca",
      "position": [
        520,
        180
      ],
      "name": "Seen before?",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:idempotency-guard__"
        },
        "options": {}
      }
    },
    {
      "id": "6f23a2e7-bd5c-42da-a3ea-ecd4ded58340",
      "position": [
        780,
        180
      ],
      "name": "New message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "67a08949-441c-4ed4-a0f2-6c737b42a6b2",
              "leftValue": "={{ !$json.duplicate }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "be624172-ccd3-40c6-a800-ca44ad17aa6d",
      "position": [
        1040,
        90
      ],
      "name": "Search the help centre",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.HELPDESK_BASE_URL }}/help_center/search",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.HELPDESK_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.text.slice(0, 200) }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "9ec4b164-2fba-4715-a0ee-2743a711c90b",
      "position": [
        1300,
        180
      ],
      "name": "Build the context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const m = $(\"New message?\").first().json;\nconst articles = ($input.first().json.articles ?? []).slice(0, 4);\nconst context = articles.map((a) => \"[\" + a.id + \"] \" + a.title + \"\\n\" + String(a.body ?? \"\").slice(0, 800)).join(\"\\n\\n\");\nreturn [{ json: { ...m, context, article_count: articles.length } }];"
      }
    },
    {
      "id": "3bdcdff0-8678-4faf-a927-6d613b3b7d07",
      "position": [
        1560,
        180
      ],
      "name": "Draft an answer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LLM_BASE_URL }}/chat/completions",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.LLM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $env.LLM_MODEL,\n  temperature: 0.2,\n  response_format: { type: \"json_object\" },\n  messages: [\n    { role: \"system\", content: \"[task:support-answer] You are a support agent. Answer ONLY from the articles given. Reply with JSON: { answer: string, confidence: 0-1, sources: string[], handover: boolean }. Set handover true if the articles do not cover it, or the customer is upset, asks for a person, or mentions a refund dispute or legal action.\" },\n    { role: \"user\", content: 'Articles:\\n' + ($json.context || '(none found)') + '\\n\\nCustomer: ' + $json.text }\n  ]\n}) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "91d3c3d0-81be-4926-ab29-e4299b684f3a",
      "position": [
        1820,
        180
      ],
      "name": "Read the draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const before = $(\"Build the context\").all();\nconst out = [];\nfor (const [i, item] of $input.all().entries()) {\n  let reply = {\"answer\":\"\",\"confidence\":0,\"sources\":[],\"handover\":true};\n  let parse_error = false;\n  try {\n    reply = JSON.parse(item.json.choices[0].message.content);\n  } catch (e) {\n    parse_error = true;\n  }\n  out.push({ json: { ...(before[i]?.json ?? {}), ...reply, parse_error } });\n}\nreturn out;"
      }
    },
    {
      "id": "43f21659-c8e9-4ed8-ab1a-870a3d0ae3b3",
      "position": [
        2080,
        180
      ],
      "name": "Confident?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "dd5f83b6-c825-4ba6-ad57-4a3d619fa343",
              "leftValue": "={{ !$json.handover && !$json.parse_error && $json.confidence >= 0.7 && $json.answer.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9ccdc297-a8dd-48e6-a5d2-c60dd0989f3d",
      "position": [
        2340,
        90
      ],
      "name": "Send the reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HELPDESK_BASE_URL }}/conversations/reply",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.HELPDESK_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ conversation_id: $json.conversation_id, content: $json.answer, message_type: 'outgoing' }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "918faca5-5af7-4ad9-a2a8-4c255f277d58",
      "position": [
        2340,
        270
      ],
      "name": "Hand to a person",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HELPDESK_BASE_URL }}/conversations/assign",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.HELPDESK_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ conversation_id: $json.conversation_id, team: 'support', status: 'open' }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "7c9e8b18-90b2-4eac-ad7d-f98e55fcc001",
      "position": [
        2600,
        90
      ],
      "name": "Leave a private note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HELPDESK_BASE_URL }}/conversations/note",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.HELPDESK_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ conversation_id: $('Confident?').first().json.conversation_id, private: true, content: 'Handed over by the agent. Customer asked: ' + $('Confident?').first().json.text.slice(0, 300) + ' | Confidence: ' + $('Confident?').first().json.confidence + ' | Articles found: ' + $('Confident?').first().json.article_count }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "30859699-0b3e-43dd-a525-a15af3d19e12",
      "position": [
        2600,
        270
      ],
      "name": "Answered",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$(\"Confident?\").first().json, answered: true } }];"
      }
    },
    {
      "id": "c26550dd-767a-4717-ae7d-b941ad48764d",
      "position": [
        2860,
        180
      ],
      "name": "Handed over",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$(\"Confident?\").first().json, answered: false } }];"
      }
    },
    {
      "id": "9f550e86-6788-4672-a59a-ec64d075bf8a",
      "position": [
        3120,
        180
      ],
      "name": "Log the outcome",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DB_BASE_URL }}/support_log",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ conversation_id: $json.conversation_id, question: $json.text, answered: $json.answered, confidence: $json.confidence, sources: $json.sources, at: $now.toISO() }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "99ecfdd6-aa4a-41c8-ab05-309ae9fc7f5f",
      "position": [
        1040,
        270
      ],
      "name": "Ignore the repeat",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    }
  ],
