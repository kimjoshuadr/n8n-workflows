{
  "name": "Support agent · Answer or hand over",
  "nodes": [
    {
      "id": "6bbc5ad0-786c-4b5d-a7c3-142e5ef897f8",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Support agent · Answer or hand over\nAnswers a customer's message from the help centre when it is confident, and hands the conversation to a person with a summary when it is not.\n\n**Platforms:** Zendesk, OpenAI, Supabase\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/support-agent`"
      }
    },
    {
      "id": "2866a047-ee8e-4164-a73d-5a2df239ffd8",
      "position": [
        0,
        220
      ],
      "name": "Message received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "support-message",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "6bfbeacb-4ae7-4ca9-a61f-927a4aef03c8"
    },
    {
      "id": "53043ff1-cc25-4195-a7bd-f4443123d123",
      "position": [
        260,
        220
      ],
      "name": "Read the message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nif (b.message_type && b.message_type !== \"incoming\") return []; // our own replies come back as events too\nconst text = String(b.content ?? \"\").trim();\nif (!text) return [];\nreturn [{ json: {\n  conversation_id: String(b.conversation?.id ?? b.conversation_id),\n  message_id: String(b.id),\n  text: text.slice(0, 3000),\n  customer: b.sender?.name ?? \"Customer\",\n  scope: \"support-message\", key: String(b.id),\n} }];"
      }
    },
    {
      "id": "11edd7ca-6ce2-4811-ada1-025b1f916dca",
      "position": [
        520,
        220
      ],
      "name": "Seen before?",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:idempotency-guard__"
        },
        "options": {}
      }
    },
    {
      "id": "6f23a2e7-bd5c-42da-a3ea-ecd4ded58340",
      "position": [
        780,
        220
      ],
      "name": "New message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "67a08949-441c-4ed4-a0f2-6c737b42a6b2",
              "leftValue": "={{ !$json.duplicate }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "be624172-ccd3-40c6-a800-ca44ad17aa6d",
      "position": [
        1040,
        130
      ],
      "name": "Search the help centre",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://acme.zendesk.com/api/v2/help_center/articles/search.json' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "zendeskApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.text.slice(0, 200) }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "zendeskApi": {
          "id": "__CRED:zendesk__",
          "name": "Zendesk"
        }
      }
    },
    {
      "id": "9ec4b164-2fba-4715-a0ee-2743a711c90b",
      "position": [
        1300,
        220
      ],
      "name": "Build the context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const m = $(\"New message?\").first().json;\nconst articles = ($input.first().json.results ?? []).slice(0, 4);\nconst context = articles.map((a) => \"[\" + a.id + \"] \" + a.title + \"\\n\" + String(a.body ?? \"\").slice(0, 800)).join(\"\\n\\n\");\nreturn [{ json: { ...m, context, article_count: articles.length } }];"
      }
    },
    {
      "id": "3bdcdff0-8678-4faf-a927-6d613b3b7d07",
      "position": [
        1660,
        90
      ],
      "name": "Draft an answer",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Articles:\\n' + ($json.context || '(none found)') + '\\n\\nCustomer: ' + $json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "[task:support-answer] You are a support agent. Answer ONLY from the articles given. Reply with JSON: { answer: string, confidence: 0-1, sources: string[], handover: boolean }. Set handover true if the articles do not cover it, or the customer is upset, asks for a person, or mentions a refund dispute or legal action.",
          "maxIterations": 2
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "9698fe4b-2c62-4d7e-a1e8-73ae38fdad99",
      "position": [
        1560,
        310
      ],
      "name": "Draft an answer · GPT",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "__CRED:openai__",
          "name": "OpenAI"
        }
      }
    },
    {
      "id": "78e25e75-6be2-4598-a76f-3587e7be77be",
      "position": [
        1760,
        310
      ],
      "name": "Draft an answer · shape",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"answer\": \"The answer.\",\n  \"confidence\": 0.9,\n  \"sources\": [\n    \"kb-12\"\n  ],\n  \"handover\": false\n}"
      }
    },
    {
      "id": "91d3c3d0-81be-4926-ab29-e4299b684f3a",
      "position": [
        2020,
        220
      ],
      "name": "Read the draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const before = $(\"Build the context\").all();\nconst out = [];\nfor (const [i, item] of $input.all().entries()) {\n  const answer = item.json.output;\n  const ok = answer && typeof answer === \"object\" && !Array.isArray(answer);\n  out.push({ json: { ...(before[i]?.json ?? {}), ...(ok ? answer : {\"answer\":\"\",\"confidence\":0,\"sources\":[],\"handover\":true}), parse_error: !ok } });\n}\nreturn out;"
      }
    },
    {
      "id": "43f21659-c8e9-4ed8-ab1a-870a3d0ae3b3",
      "position": [
        2280,
        220
      ],
      "name": "Confident?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "dd5f83b6-c825-4ba6-ad57-4a3d619fa343",
              "leftValue": "={{ !$json.handover && !$json.parse_error && $json.confidence >= 0.7 && $json.answer.length > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9ccdc297-a8dd-48e6-a5d2-c60dd0989f3d",
      "position": [
        2540,
        130
      ],
      "name": "Send the reply",
      "type": "n8n-nodes-base.zendesk",
      "typeVersion": 1,
      "parameters": {
        "resource": "ticket",
        "operation": "update",
        "id": "={{ $json.conversation_id }}",
        "updateFields": {
          "status": "={{ 'pending' }}",
          "publicReply": "={{ $json.answer }}",
          "tags": [
            "ai-answered"
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "zendeskApi": {
          "id": "__CRED:zendesk__",
          "name": "Zendesk"
        }
      }
    },
    {
      "id": "918faca5-5af7-4ad9-a2a8-4c255f277d58",
      "position": [
        2540,
        310
      ],
      "name": "Hand to a person",
      "type": "n8n-nodes-base.zendesk",
      "typeVersion": 1,
      "parameters": {
        "resource": "ticket",
        "operation": "update",
        "id": "={{ $json.conversation_id }}",
        "updateFields": {
          "status": "={{ 'open' }}",
          "tags": [
            "needs-human"
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "zendeskApi": {
          "id": "__CRED:zendesk__",
          "name": "Zendesk"
        }
      }
    },
    {
      "id": "7c9e8b18-90b2-4eac-ad7d-f98e55fcc001",
      "position": [
        2800,
        130
      ],
      "name": "Leave a private note",
      "type": "n8n-nodes-base.zendesk",
      "typeVersion": 1,
      "parameters": {
        "resource": "ticket",
        "operation": "update",
        "id": "={{ $('Confident?').first().json.conversation_id }}",
        "updateFields": {
          "internalNote": "={{ 'Handed over by the agent. Customer asked: ' + $('Confident?').first().json.text.slice(0, 300) + ' | Confidence: ' + $('Confident?').first().json.confidence + ' | Articles found: ' + $('Confident?').first().json.article_count }}"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "zendeskApi": {
          "id": "__CRED:zendesk__",
          "name": "Zendesk"
        }
      }
    },
    {
      "id": "30859699-0b3e-43dd-a525-a15af3d19e12",
      "position": [
        2800,
        310
      ],
      "name": "Answered",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$(\"Confident?\").first().json, answered: true } }];"
      }
    },
    {
      "id": "c26550dd-767a-4717-ae7d-b941ad48764d",
      "position": [
        3060,
        220
      ],
      "name": "Handed over",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { ...$(\"Confident?\").first().json, answered: false } }];"
      }
    },
    {
      "id": "9f550e86-6788-4672-a59a-ec64d075bf8a",
      "position": [
