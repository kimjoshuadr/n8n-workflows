            },
            {
              "fieldId": "sources",
              "fieldValue": "={{ $json.sources }}"
            },
            {
              "fieldId": "at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "99ecfdd6-aa4a-41c8-ab05-309ae9fc7f5f",
      "position": [
        1040,
