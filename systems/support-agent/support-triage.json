    },
    {
      "id": "c6dc00c3-876e-4539-afce-d063a9ba18e5",
      "position": [
        1560,
        360
      ],
      "name": "Urgent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "dc9ef982-ea50-4272-a239-1f980bb39d3a",
              "leftValue": "={{ $('Read the labels').first().json.urgent === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "5b5ccbb9-2713-43fd-a196-1f71bd86a29c",
      "position": [
        1820,
        360
      ],
      "name": "Page message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const t = $(\"Read the labels\").first().json;\nreturn [{ json: { text: \"Urgent \" + t.label + \" ticket #\" + t.ticket_id + \": \" + t.subject, level: \"critical\" } }];"
      }
    },
    {
      "id": "8cac8dc5-3c3e-42f6-a07f-b8b45d049a2d",
