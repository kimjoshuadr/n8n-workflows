{
  "name": "Support agent · Ticket triage",
  "nodes": [
    {
      "id": "2f056257-b6b9-4a22-a17a-2179606663a5",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Support agent · Ticket triage\nLabels each new ticket by topic and urgency, routes it to the right team, and pages someone only when it is urgent.\n\n**Platforms:** OpenAI, Zendesk\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/support-agent`"
      }
    },
    {
      "id": "431a2f30-91a4-4b47-af24-a2f667ac1dfe",
      "position": [
        0,
        360
      ],
      "name": "Ticket created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "support-ticket",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "aebb35ac-e5a4-4458-aff4-4d6b1373ff1f"
    },
    {
      "id": "edb65851-2fa0-4626-a9c9-c9ee992b1f46",
      "position": [
        260,
        360
      ],
      "name": "Read the ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nreturn [{ json: { ticket_id: String(b.id), subject: String(b.subject ?? \"\"), body: String(b.body ?? \"\").slice(0, 3000), from: b.from ?? null } }];"
      }
    },
    {
      "id": "708e926a-f7d5-46df-a6ff-97df9a82e789",
      "position": [
        620,
        230
      ],
      "name": "Classify",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.subject + '\\n\\n' + $json.body }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "[task:classify] Classify a support ticket. Reply with JSON: { label: 'billing'|'technical'|'spam'|'general', urgent: boolean, sentiment: 'negative'|'neutral'|'positive' }.",
          "maxIterations": 2
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "2f777565-ed70-463e-ab0f-12a8ad95974e",
      "position": [
        520,
        450
      ],
      "name": "Classify · GPT",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "__CRED:openai__",
          "name": "OpenAI"
        }
      }
    },
    {
      "id": "1f554615-8fa6-48fc-a6d2-c1a2f7bd15de",
      "position": [
        720,
        450
      ],
      "name": "Classify · shape",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"label\": \"billing\",\n  \"urgent\": false,\n  \"sentiment\": \"neutral\"\n}"
      }
    },
    {
      "id": "7919cc74-98d4-4cc3-ac94-ddc39959eba0",
      "position": [
        980,
        360
      ],
      "name": "Read the labels",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const before = $(\"Read the ticket\").all();\nconst out = [];\nfor (const [i, item] of $input.all().entries()) {\n  const answer = item.json.output;\n  const ok = answer && typeof answer === \"object\" && !Array.isArray(answer);\n  out.push({ json: { ...(before[i]?.json ?? {}), ...(ok ? answer : {\"label\":\"general\",\"urgent\":false,\"sentiment\":\"neutral\"}), parse_error: !ok } });\n}\nreturn out;"
      }
    },
    {
      "id": "d638aa7d-b630-45a4-abc3-e66644b04cee",
      "position": [
        1240,
        360
      ],
      "name": "By topic",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "29130356-0c00-4622-a1b3-dafe22b8ffea",
                    "leftValue": "={{ $json.label === 'spam' }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "spam"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "26eaf4eb-6b00-4c02-aa1e-020dd518fb3d",
                    "leftValue": "={{ $json.label === 'billing' }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "billing"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "986705cc-9c8c-463a-a493-20ff6b7d85c4",
                    "leftValue": "={{ $json.label === 'technical' }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "technical"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
