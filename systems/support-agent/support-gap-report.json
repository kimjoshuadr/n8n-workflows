{
  "name": "Support agent · Weekly gap report",
  "nodes": [
    {
      "id": "545ae2af-fdac-4c91-adb6-877fb99f72aa",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Support agent · Weekly gap report\nEvery Monday, reads what the agent could not answer last week and tells the team which help articles are missing.\n\n**Platforms:** Supabase, Claude, Slack\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/support-agent`"
      }
    },
    {
      "id": "53f670c1-891f-4239-a05a-8d68c1337288",
      "position": [
        0,
        310
      ],
      "name": "Monday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "670118fd-c33c-425b-a4ce-bf135d4af0a5",
      "position": [
        260,
        310
      ],
      "name": "Unanswered last week",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "support_log",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "answered",
              "condition": "eq",
              "keyValue": "={{ 'false' }}"
            },
            {
              "keyName": "at",
              "condition": "gte",
              "keyValue": "={{ $now.minus({ days: 7 }).toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "a8eb664c-7df9-407a-ae73-efefc86805a7",
      "position": [
        520,
        310
      ],
      "name": "Gather the questions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const qs = $input.all().map((i) => i.json.question).filter(Boolean);\nreturn [{ json: { count: qs.length, questions: qs.slice(0, 80).map((q) => \"- \" + String(q).slice(0, 200)).join(\"\\n\") } }];"
      }
    },
    {
      "id": "7ead2bda-48fb-41ac-aa14-09eb047577d8",
      "position": [
        780,
        310
      ],
      "name": "Any gaps?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a2745c57-5fa1-4165-a27c-689389e72115",
              "leftValue": "={{ $json.count > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "7d797618-81eb-4794-a9c9-5663c0c21007",
      "position": [
        1040,
        90
      ],
      "name": "Group into topics",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.questions }}",
        "hasOutputParser": false,
        "options": {
          "systemMessage": "[task:summarise] Group these unanswered support questions into at most five topics. For each, give the topic, how many questions, and the help article that would have answered them. Plain text.",
          "maxIterations": 2
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "62ab8cb1-3a3f-4dca-a950-8bc48868cdbc",
      "position": [
        1040,
        310
      ],
      "name": "Group into topics · Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-sonnet-4-5"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "credentials": {
        "anthropicApi": {
          "id": "__CRED:anthropic__",
          "name": "Claude"
        }
      }
    },
    {
      "id": "8b53cf61-0843-4d92-aa2f-b44070a00f4f",
      "position": [
        1300,
        310
      ],
      "name": "Post the report",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ '#support' }}"
        },
        "text": "={{ ':books: ' + $('Gather the questions').first().json.count + ' questions went to a person last week.\\n' + $json.output }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "slackApi": {
          "id": "__CRED:slack__",
          "name": "Slack"
        }
      }
    },
    {
      "id": "73384992-fd9b-42be-aa60-427db5c956b3",
      "position": [
        1040,
        530
      ],
      "name": "Post all clear",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ '#support' }}"
        },
        "text": "={{ ':white_check_mark: The agent answered everything it was asked last week.' }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "slackApi": {
          "id": "__CRED:slack__",
          "name": "Slack"
        }
      }
    }
  ],
  "connections": {
    "Monday 08:00": {
      "main": [
        [
          {
