{
  "name": "Support agent · Weekly gap report",
  "nodes": [
    {
      "id": "545ae2af-fdac-4c91-adb6-877fb99f72aa",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Support agent · Weekly gap report\nEvery Monday, reads what the agent could not answer last week and tells the team which help articles are missing.\n\n**Platforms:** none, this is logic only\n**Settings:** CHAT_API_KEY, CHAT_BASE_URL, DB_API_KEY, DB_BASE_URL, LLM_API_KEY, LLM_BASE_URL, LLM_MODEL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/support-agent`"
      }
    },
    {
      "id": "53f670c1-891f-4239-a05a-8d68c1337288",
      "position": [
        0,
        180
      ],
      "name": "Monday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "670118fd-c33c-425b-a4ce-bf135d4af0a5",
      "position": [
        260,
        180
      ],
      "name": "Unanswered last week",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DB_BASE_URL }}/support_log",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "answered",
              "value": "={{ 'eq.false' }}"
            },
            {
              "name": "at",
              "value": "={{ 'gte.' + $now.minus({ days: 7 }).toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true
    },
    {
      "id": "a8eb664c-7df9-407a-ae73-efefc86805a7",
      "position": [
        520,
        180
      ],
      "name": "Gather the questions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const qs = $input.all().map((i) => i.json.question).filter(Boolean);\nreturn [{ json: { count: qs.length, questions: qs.slice(0, 80).map((q) => \"- \" + String(q).slice(0, 200)).join(\"\\n\") } }];"
      }
    },
    {
      "id": "7ead2bda-48fb-41ac-aa14-09eb047577d8",
      "position": [
        780,
        180
      ],
      "name": "Any gaps?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a2745c57-5fa1-4165-a27c-689389e72115",
              "leftValue": "={{ $json.count > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "7d797618-81eb-4794-a9c9-5663c0c21007",
      "position": [
        1040,
        90
      ],
      "name": "Group into topics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LLM_BASE_URL }}/chat/completions",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.LLM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $env.LLM_MODEL,\n  temperature: 0.2,\n  messages: [\n    { role: \"system\", content: \"[task:summarise] Group these unanswered support questions into at most five topics. For each, give the topic, how many questions, and the help article that would have answered them. Plain text.\" },\n    { role: \"user\", content: $json.questions }\n  ]\n}) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "8b53cf61-0843-4d92-aa2f-b44070a00f4f",
      "position": [
        1300,
        180
      ],
      "name": "Post the report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHAT_BASE_URL }}/chat.postMessage",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.CHAT_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: '#support', text: ':books: ' + $('Gather the questions').first().json.count + ' questions went to a person last week.\\n' + $json.choices[0].message.content }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "73384992-fd9b-42be-aa60-427db5c956b3",
      "position": [
        1040,
        270
      ],
      "name": "Post all clear",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHAT_BASE_URL }}/chat.postMessage",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.CHAT_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: '#support', text: ':white_check_mark: The agent answered everything it was asked last week.' }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    }
  ],
  "connections": {
    "Monday 08:00": {
      "main": [
        [
          {
            "node": "Unanswered last week",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unanswered last week": {
      "main": [
        [
          {
            "node": "Gather the questions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gather the questions": {
      "main": [
        [
          {
            "node": "Any gaps?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any gaps?": {
      "main": [
        [
          {
            "node": "Group into topics",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Post all clear",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Group into topics": {
      "main": [
        [
          {
            "node": "Post the report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
