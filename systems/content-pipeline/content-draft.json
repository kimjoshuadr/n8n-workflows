{
  "name": "Content pipeline · Research and draft",
  "nodes": [
    {
      "id": "cbdcd577-5b47-48cc-ab91-bbec0af34eeb",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Content pipeline · Research and draft\nTakes the next topic off the list, researches it, drafts the article, and asks a person to approve it. Nothing is published from here.\n\n**Platforms:** Supabase, SerpAPI, OpenAI, Claude, Slack\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/content-pipeline`"
      }
    },
    {
      "id": "0d978302-c53c-4e6b-a20e-6a90f5e40a83",
      "position": [
        0,
        310
      ],
      "name": "Weekdays 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "6314bcf4-9b57-446a-a723-b46098e2bcbc",
      "position": [
        260,
        310
      ],
      "name": "Next topic",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "content_topics",
        "returnAll": false,
        "limit": 1,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "={{ 'queued' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "5bb76069-560f-4701-a855-641b3a766e57",
      "position": [
        520,
        310
      ],
      "name": "Is there one?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f51cd303-5533-400e-ad5c-f340f751b332",
              "leftValue": "={{ !!$json.id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "7d858916-a729-409f-abf6-41376f9d71e2",
      "position": [
        780,
        220
      ],
      "name": "Claim the topic",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "content_topics",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "={{ 'drafting' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "d3ac425a-e1bc-494a-add7-70e6f4f1885f",
      "position": [
        1040,
        310
      ],
      "name": "Research",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://serpapi.com/search.json' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "serpApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $('Is there one?').first().json.topic }}"
            },
            {
              "name": "num",
              "value": "={{ '10' }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "serpApi": {
          "id": "__CRED:serpapi__",
          "name": "SerpAPI"
        }
      }
    },
    {
      "id": "1e64b3ba-f22f-4d17-ac6b-1a969d4c1058",
      "position": [
        1300,
        310
      ],
      "name": "Collect sources",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const t = $(\"Is there one?\").first().json;\nconst results = ($input.first().json.organic_results ?? []).slice(0, 5);\nreturn [{ json: { topic_id: t.id, topic: t.topic, sources: results.map((r) => ({ title: r.title, url: r.link })), notes: results.map((r) => \"- \" + r.title + \": \" + String(r.snippet ?? \"\").slice(0, 400)).join(\"\\n\") } }];"
      }
    },
    {
      "id": "a642d55a-764b-4c6f-a2bd-7c8be9a76bf0",
      "position": [
        1660,
        180
      ],
      "name": "Outline",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Topic: ' + $json.topic + '\\n\\nResearch notes:\\n' + ($json.notes || '(none)') }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "[task:outline] Write an article outline as JSON: { title: string, sections: string[], keywords: string[] }. Use only facts found in the research notes.",
          "maxIterations": 2
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "3b5db886-3758-483f-abad-bce364628b7c",
      "position": [
        1560,
        400
      ],
      "name": "Outline · GPT",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "__CRED:openai__",
          "name": "OpenAI"
        }
      }
    },
    {
      "id": "d0834dbd-922a-437a-adbe-30816cd550ab",
      "position": [
        1760,
        400
      ],
      "name": "Outline · shape",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"title\": \"The title\",\n  \"sections\": [\n    \"A section\"\n  ],\n  \"keywords\": [\n    \"a keyword\"\n  ]\n}"
      }
    },
    {
      "id": "7006d8a4-39a7-470a-a65a-0c1014a71cf6",
      "position": [
        2020,
        310
      ],
      "name": "Read the outline",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const before = $(\"Collect sources\").all();\nconst out = [];\nfor (const [i, item] of $input.all().entries()) {\n  const answer = item.json.output;\n  const ok = answer && typeof answer === \"object\" && !Array.isArray(answer);\n  out.push({ json: { ...(before[i]?.json ?? {}), ...(ok ? answer : {\"title\":null,\"sections\":[],\"keywords\":[]}), parse_error: !ok } });\n}\nreturn out;"
      }
    },
    {
      "id": "7abc4d7f-5b9f-4451-a167-84dd9078c1cc",
      "position": [
        2280,
        310
      ],
      "name": "Usable outline?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "3a91b1aa-fbe4-4cf7-ac56-b94cada24ba4",
              "leftValue": "={{ !$json.parse_error && $json.sections.length >= 2 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "7d71d3bc-6809-43b8-ae2a-f11aa165edca",
      "position": [
        2540,
        90
      ],
      "name": "Write the draft",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ JSON.stringify({ title: $json.title, sections: $json.sections, sources: $json.sources }) }}",
        "hasOutputParser": false,
        "options": {
          "systemMessage": "[task:draft] Write the article in Markdown from this outline. Plain language, no invented statistics, cite only the sources listed.",
          "maxIterations": 2
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "66bfb0f2-d70c-44de-ac06-dedce788c272",
      "position": [
        2540,
        310
      ],
      "name": "Write the draft · Claude",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-sonnet-4-5"
        },
        "options": {
          "temperature": 0.2
        }
      },
      "credentials": {
        "anthropicApi": {
          "id": "__CRED:anthropic__",
          "name": "Claude"
        }
      }
    },
    {
      "id": "18d3527e-aff3-483c-a15c-2ce30a62dee4",
      "position": [
        2800,
        310
      ],
      "name": "Save the draft",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "content_drafts",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "topic_id",
              "fieldValue": "={{ $('Usable outline?').first().json.topic_id }}"
            },
            {
              "fieldId": "title",
              "fieldValue": "={{ $('Usable outline?').first().json.title }}"
            },
            {
              "fieldId": "keywords",
              "fieldValue": "={{ $('Usable outline?').first().json.keywords }}"
            },
            {
              "fieldId": "sources",
              "fieldValue": "={{ $('Usable outline?').first().json.sources }}"
            },
            {
              "fieldId": "body",
              "fieldValue": "={{ $json.output }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "={{ 'awaiting_approval' }}"
            },
            {
              "fieldId": "created_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "1f860db6-5ddb-4767-a6ac-e203553b5a11",
      "position": [
        3060,
        310
      ],
      "name": "Ask for approval",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ '#content' }}"
        },
        "text": "={{ ':memo: Draft ready for review: \"' + $json.title + '\". Approve or reject draft ' + $json.id + '.' }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "slackApi": {
          "id": "__CRED:slack__",
          "name": "Slack"
        }
      }
    },
    {
      "id": "445a2090-f167-40c6-a5eb-f181b8dbe0f3",
      "position": [
        2540,
        530
      ],
      "name": "Return the topic",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "content_topics",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.topic_id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "={{ 'needs_brief' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "a3d9e506-67df-42bb-afd9-49294a675833",
