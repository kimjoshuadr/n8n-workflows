{
  "name": "Content pipeline · Share what was published",
  "nodes": [
    {
      "id": "d08a7ced-6fb1-4dc6-a28b-32265d00c566",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Content pipeline · Share what was published\nEvery hour, writes a post per network for anything newly published and schedules it. One network failing does not stop the others.\n\n**Platforms:** Supabase, OpenAI, LinkedIn, X, Facebook\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/content-pipeline`"
      }
    },
    {
      "id": "036d7389-17dd-4ba5-a054-9e611fda1d69",
      "position": [
        0,
        310
      ],
      "name": "Hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "d817ebe2-d13c-4dc0-ab13-f027000f2d9a",
      "position": [
        260,
        310
      ],
      "name": "Published, not shared",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "content_drafts",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "={{ 'published' }}"
            },
            {
              "keyName": "shared",
              "condition": "eq",
              "keyValue": "={{ 'false' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "b1be9994-856d-42cc-ab3a-c475e1fa85d7",
      "position": [
        520,
        310
      ],
      "name": "Anything new?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "8895fcd1-c460-45d2-aefa-96592b3fae89",
              "leftValue": "={{ !!$json.id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "4592c543-8ffe-466b-ae2b-8a73509434b2",
      "position": [
        780,
        220
      ],
      "name": "Each article",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "c1c10a8f-f873-4cba-a408-0c73981fe02a",
      "position": [
        1140,
        90
      ],
      "name": "Write the posts",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.title + '\\n\\n' + String($json.body).slice(0, 1500) }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "[task:social] Write one post per network for this article. Reply with JSON: { x: string (max 260 chars), linkedin: string, facebook: string }. No hashtags stuffing, no invented claims.",
          "maxIterations": 2
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "bdba154d-59fb-4b23-a3f8-4184b7c6c49c",
      "position": [
        1040,
        310
      ],
      "name": "Write the posts · GPT",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "__CRED:openai__",
          "name": "OpenAI"
        }
      }
    },
    {
      "id": "1768495c-e8b2-47f6-a7ec-4eda11bf7ac8",
      "position": [
        1240,
        310
      ],
      "name": "Write the posts · shape",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"x\": \"The X post\",\n  \"linkedin\": \"The LinkedIn post\",\n  \"facebook\": \"The Facebook post\"\n}"
      }
    },
    {
      "id": "f5de6dc0-bf3c-4b6c-a458-d84c59afa8de",
      "position": [
        1500,
        310
      ],
      "name": "Cut each post to length",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const a = $(\"Each article\").first().json;\nconst o = $input.first().json.output ?? {};\nconst fallback = \"New on the blog: \" + a.title;\nconst post = (network, max) => String(typeof o[network] === \"string\" && o[network].trim() ? o[network] : fallback).slice(0, max);\nreturn [{ json: { draft_id: a.id, x: post(\"x\", 260), linkedin: post(\"linkedin\", 2000), facebook: post(\"facebook\", 2000) } }];"
      }
    },
    {
      "id": "6de2d4b3-6c68-4be0-a5f0-17060508ec2b",
      "position": [
        1760,
        310
      ],
      "name": "Post to LinkedIn",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "parameters": {
        "resource": "post",
        "operation": "create",
        "postAs": "organization",
        "organization": "1234567",
        "text": "={{ $('Cut each post to length').first().json.linkedin }}",
        "additionalFields": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "linkedInOAuth2Api": {
          "id": "__CRED:linkedin__",
          "name": "LinkedIn"
        }
      }
    },
    {
      "id": "f5402db7-d4be-4551-a0ac-a0012d3e519c",
      "position": [
        2020,
        310
      ],
      "name": "Post to X",
      "type": "n8n-nodes-base.twitter",
      "typeVersion": 2,
      "parameters": {
        "resource": "tweet",
        "operation": "create",
        "text": "={{ $('Cut each post to length').first().json.x }}",
        "additionalFields": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "twitterOAuth2Api": {
          "id": "__CRED:x__",
          "name": "X"
        }
      }
    },
    {
      "id": "72a54932-d0a8-4e87-a1c7-f2c8e03e71e5",
      "position": [
        2280,
        310
      ],
      "name": "Post to Facebook",
      "type": "n8n-nodes-base.facebookGraphApi",
      "typeVersion": 1,
      "parameters": {
        "hostUrl": "graph.facebook.com",
        "httpRequestMethod": "POST",
        "graphApiVersion": "v23.0",
        "node": "acme-page",
        "edge": "feed",
        "options": {
          "queryParameters": {
            "parameter": [
              {
                "name": "message",
                "value": "={{ $('Cut each post to length').first().json.facebook }}"
              }
            ]
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "facebookGraphApi": {
          "id": "__CRED:facebook__",
          "name": "Facebook"
        }
      }
    },
    {
      "id": "f6063fae-3d9d-465a-a446-c1d7489e7cea",
      "position": [
        2540,
        310
      ],
      "name": "Mark shared",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "content_drafts",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Each article').first().json.id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "shared",
              "fieldValue": "={{ true }}"
            },
            {
              "fieldId": "shared_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "c218a248-0804-4ebb-aa86-f712bd24fd60",
      "position": [
        780,
        400
      ],
      "name": "Nothing new",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    },
    {
      "id": "978b2aea-298a-45ad-ad79-9933b7b48ea6",
      "position": [
        1140,
        530
      ],
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    }
