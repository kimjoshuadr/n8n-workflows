          }
        ]
      ]
    },
    "Each article": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Write the posts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write the posts": {
      "main": [
        [
          {
            "node": "One item per network",
