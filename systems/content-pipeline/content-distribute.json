{
  "name": "Content pipeline · Share what was published",
  "nodes": [
    {
      "id": "d08a7ced-6fb1-4dc6-a28b-32265d00c566",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Content pipeline · Share what was published\nEvery hour, writes a post per network for anything newly published and schedules it. One network failing does not stop the others.\n\n**Platforms:** none, this is logic only\n**Settings:** DB_API_KEY, DB_BASE_URL, LLM_API_KEY, LLM_BASE_URL, LLM_MODEL, SOCIAL_API_KEY, SOCIAL_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/content-pipeline`"
      }
    },
    {
      "id": "036d7389-17dd-4ba5-a054-9e611fda1d69",
      "position": [
        0,
        180
      ],
      "name": "Hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "d817ebe2-d13c-4dc0-ab13-f027000f2d9a",
      "position": [
        260,
        180
      ],
      "name": "Published, not shared",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DB_BASE_URL }}/content_drafts",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "={{ 'eq.published' }}"
            },
            {
              "name": "shared",
              "value": "={{ 'eq.false' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true
    },
    {
      "id": "b1be9994-856d-42cc-ab3a-c475e1fa85d7",
      "position": [
        520,
        180
      ],
      "name": "Anything new?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "8895fcd1-c460-45d2-aefa-96592b3fae89",
              "leftValue": "={{ !!$json.id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "4592c543-8ffe-466b-ae2b-8a73509434b2",
      "position": [
        780,
        90
      ],
      "name": "Each article",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "c1c10a8f-f873-4cba-a408-0c73981fe02a",
      "position": [
        1040,
        90
      ],
      "name": "Write the posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LLM_BASE_URL }}/chat/completions",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.LLM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $env.LLM_MODEL,\n  temperature: 0.2,\n  response_format: { type: \"json_object\" },\n  messages: [\n    { role: \"system\", content: \"[task:social] Write one post per network for this article. Reply with JSON: { x: string (max 260 chars), linkedin: string, facebook: string }. No hashtags stuffing, no invented claims.\" },\n    { role: \"user\", content: $json.title + '\\n\\n' + String($json.body).slice(0, 1500) }\n  ]\n}) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "59b33689-10df-428f-a8c2-a1774b912f31",
      "position": [
        1300,
        180
      ],
      "name": "One item per network",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const a = $(\"Each article\").first().json;\nlet posts = {};\ntry { posts = JSON.parse($input.first().json.choices[0].message.content); } catch (e) {}\nconst fallback = \"New on the blog: \" + a.title;\nreturn [\"x\", \"linkedin\", \"facebook\"].map((network) => ({ json: { draft_id: a.id, network, text: String(posts[network] || fallback).slice(0, network === \"x\" ? 260 : 2000) } }));"
      }
    },
    {
      "id": "2306ed84-5499-4b7e-a44b-7b5532034fa9",
      "position": [
        1560,
        180
      ],
      "name": "Schedule the post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SOCIAL_BASE_URL }}/updates/create",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SOCIAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ network: $json.network, text: $json.text }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "f6063fae-3d9d-465a-a446-c1d7489e7cea",
      "position": [
        1820,
        180
      ],
      "name": "Mark shared",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.DB_BASE_URL }}/content_drafts",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "={{ 'eq.' + $('Each article').first().json.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ shared: true, shared_at: $now.toISO() }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "c218a248-0804-4ebb-aa86-f712bd24fd60",
      "position": [
        780,
        270
      ],
      "name": "Nothing new",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    },
    {
      "id": "978b2aea-298a-45ad-ad79-9933b7b48ea6",
      "position": [
        1040,
        270
      ],
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    }
  ],
  "connections": {
    "Hourly": {
      "main": [
        [
          {
