{
  "name": "Content pipeline · Approve and publish",
  "nodes": [
    {
      "id": "81fe471c-4a84-4711-af06-af36c0009e72",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Content pipeline · Approve and publish\nReceives a person's decision on a draft. Approved drafts are published to the CMS once and queued for sharing; rejected ones go back with the reason.\n\n**Platforms:** none, this is logic only\n**Settings:** CMS_API_KEY, CMS_BASE_URL, DB_API_KEY, DB_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/content-pipeline`"
      }
    },
    {
      "id": "9fa092bc-e41c-4bed-a845-08e0fadd4d31",
      "position": [
        0,
        180
      ],
      "name": "Decision",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "content-decision",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "a3da4bcc-1c0e-4ac4-a560-8a39cf07d38e"
    },
    {
      "id": "7711f376-a9f9-4f6b-a480-b75cf381ba3f",
      "position": [
        260,
        180
      ],
      "name": "Read the decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nconst decision = b.decision === \"approve\" ? \"approve\" : b.decision === \"reject\" ? \"reject\" : null;\nreturn [{ json: { valid: !!decision && !!b.draft_id, decision, draft_id: String(b.draft_id ?? \"\"), by: String(b.by ?? \"unknown\"), reason: String(b.reason ?? \"\") } }];"
      }
    },
    {
      "id": "33a04959-6442-46d1-a607-554514fc7a37",
      "position": [
        520,
        180
      ],
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "8ba548b6-353c-474e-a581-189fba03a955",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "5b538e98-8219-4da6-a3f0-43fc8f775598",
      "position": [
        780,
        90
      ],
      "name": "Bad request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'Need draft_id and decision: approve | reject' }) }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "e82f2931-af53-486d-a69b-60045ba08156",
      "position": [
        780,
        270
      ],
      "name": "Load the draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DB_BASE_URL }}/content_drafts",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "={{ 'eq.' + $json.draft_id }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true
    },
    {
      "id": "6f0ef800-0409-458e-a682-49a6271d6100",
      "position": [
        1040,
        180
      ],
      "name": "Awaiting approval?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "3a75bed8-d918-40a0-a3b4-807a1bba03c9",
              "leftValue": "={{ $json.status === 'awaiting_approval' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "3c7bbd10-2628-4fe1-adc2-d80960b0ab2d",
      "position": [
        1300,
        90
      ],
      "name": "Not pending",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'That draft is not awaiting approval' }) }}",
        "options": {
          "responseCode": 409
        }
      }
    },
    {
      "id": "64a803c8-ff31-4c98-a28b-8cfbe18a3141",
      "position": [
        1300,
        270
      ],
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b604e61a-1df5-4742-a368-1493d5c22ea0",
              "leftValue": "={{ $('Read the decision').first().json.decision === 'approve' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "da3bfa64-8127-442a-af58-b4f958504c20",
      "position": [
        1560,
        90
      ],
      "name": "Publish to CMS",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CMS_BASE_URL }}/posts",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.CMS_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $json.title, content: $json.body, status: 'publish', meta: { keywords: $json.keywords } }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "6bffc76d-2b27-4279-a5c8-83e49d6db969",
      "position": [
        1820,
        90
      ],
      "name": "Mark published",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.DB_BASE_URL }}/content_drafts",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "={{ 'eq.' + $('Read the decision').first().json.draft_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'published', post_id: $json.id, approved_by: $('Read the decision').first().json.by, published_at: $now.toISO(), shared: false }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "1b5bcd38-0d80-4961-aefa-49f7e6b1e9ad",
      "position": [
        2080,
        180
      ],
      "name": "Published",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, status: 'published' }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "ff443074-0b6f-43cf-a541-0dc7f3a938b4",
      "position": [
        1560,
        270
      ],
      "name": "Mark rejected",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.DB_BASE_URL }}/content_drafts",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "={{ 'eq.' + $json.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'rejected', rejected_by: $('Read the decision').first().json.by, reason: $('Read the decision').first().json.reason }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "d968cf3e-5801-455c-aa4b-d6a5a7566ef7",
      "position": [
        1820,
        270
      ],
      "name": "Rejected",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, status: 'rejected' }) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
