      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "d968cf3e-5801-455c-aa4b-d6a5a7566ef7",
      "position": [
        1820,
        270
      ],
      "name": "Rejected",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, status: 'rejected' }) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
