{
  "name": "Lead intake · Booking sync",
  "nodes": [
    {
      "id": "0f3410d9-ac39-4b6f-a612-0b7656ed8b5d",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Lead intake · Booking sync\nWhen a call is booked, moves the lead forward everywhere at once: the lead record, the CRM deal and the sales channel.\n\n**Platforms:** none, this is logic only\n**Settings:** CRM_API_KEY, CRM_BASE_URL, DB_API_KEY, DB_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/lead-intake`"
      }
    },
    {
      "id": "eb5c4352-6a48-4ebf-a77f-145bcb91c5a1",
      "position": [
        0,
        180
      ],
      "name": "Booking created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "booking-created",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "d49bdb06-49d1-42c9-a8ca-322db50b2b75"
    },
    {
      "id": "3b3c3936-85d6-4201-a037-354c8fd65b78",
      "position": [
        260,
        180
      ],
      "name": "Read the booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nconst p = b.payload ?? b;\nconst email = String(p.attendees?.[0]?.email ?? p.email ?? \"\").toLowerCase();\nif (!email) throw new Error(\"Booking has no attendee email\");\nreturn [{ json: { email, starts_at: p.startTime ?? p.start_time, booking_id: String(p.uid ?? p.id), scope: \"booking\", key: String(p.uid ?? p.id) } }];"
      }
    },
    {
      "id": "28f64dbc-4b63-438a-a19c-bf0f10c46640",
      "position": [
        520,
        180
      ],
      "name": "Seen before?",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:idempotency-guard__"
        },
        "options": {}
      }
    },
    {
      "id": "d101f8ed-5c3c-417e-a845-ff8bbdc29094",
      "position": [
        780,
        180
      ],
      "name": "New booking?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "905ac9a6-715e-42ad-ad5e-66e5d287f613",
              "leftValue": "={{ !$json.duplicate }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "0857e053-49af-4f1b-a87f-19a8aedeb853",
      "position": [
        1040,
        90
      ],
      "name": "Mark lead booked",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.DB_BASE_URL }}/leads",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{ 'eq.' + $json.email }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ booked: true, status: 'booked', call_at: $json.starts_at }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true
    },
    {
      "id": "f67ef109-1e4f-4987-a57e-83259f3a24cd",
      "position": [
        1300,
        180
      ],
      "name": "Known lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "666d7309-0368-4e20-a1de-7a40c881a4e5",
              "leftValue": "={{ !!$json.email }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f312fc35-ad53-4b12-a1e1-bb1bdbbf77a1",
      "position": [
        1560,
        90
      ],
      "name": "Open CRM deal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_BASE_URL }}/crm/v3/objects/deals",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.CRM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ properties: { dealname: 'Intro call: ' + $json.name, dealstage: 'appointmentscheduled', closedate: $json.call_at }, contact_email: $json.email }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "1aac9ee7-5844-42fb-affb-c6dd52e52f0b",
      "position": [
        1820,
        90
      ],
      "name": "Booked message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const l = $(\"Known lead?\").first().json;\nreturn [{ json: { text: l.name + \" booked a call for \" + l.call_at + \".\", level: \"info\" } }];"
      }
    },
    {
      "id": "63d1eafa-c216-4878-a076-88d827d22cf7",
      "position": [
        2080,
        180
      ],
      "name": "Tell sales",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:notify__"
        },
        "options": {}
      }
    },
    {
      "id": "b799411b-9a9d-4f26-ac1a-c53ad0d89af4",
      "position": [
        1560,
        270
      ],
      "name": "Unknown message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { text: \"A call was booked by \" + $(\"New booking?\").first().json.email + \", who is not in the leads table.\", level: \"warn\" } }];"
      }
    },
    {
      "id": "53791f51-c7a4-42b9-a35f-b63ea06e0fb4",
      "position": [
        1820,
        270
      ],
      "name": "Flag it",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:notify__"
        },
        "options": {}
      }
    },
    {
      "id": "b291f727-30fe-4fc6-ac3e-1cf644a1776e",
      "position": [
        1040,
        270
      ],
      "name": "Already handled",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    }
  ],
