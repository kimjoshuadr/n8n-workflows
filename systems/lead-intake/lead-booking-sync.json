{
  "name": "Lead intake · Booking sync",
  "nodes": [
    {
      "id": "0f3410d9-ac39-4b6f-a612-0b7656ed8b5d",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Lead intake · Booking sync\nWhen a call is booked, moves the lead forward everywhere at once: the lead record, the CRM deal and the sales channel.\n\n**Platforms:** Calendly, Supabase, HubSpot\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/lead-intake`"
      }
    },
    {
      "id": "eb5c4352-6a48-4ebf-a77f-145bcb91c5a1",
      "position": [
        0,
        180
      ],
      "name": "Booking created",
      "type": "n8n-nodes-base.calendlyTrigger",
      "typeVersion": 1,
      "parameters": {
        "scope": "user",
        "events": [
          "invitee.created"
        ]
      },
      "webhookId": "6d80594e-fccd-4ffa-aea2-f6e57bdfd9b1",
      "credentials": {
        "calendlyApi": {
          "id": "__CRED:calendly__",
          "name": "Calendly"
        }
      }
    },
    {
      "id": "3b3c3936-85d6-4201-a037-354c8fd65b78",
      "position": [
        260,
        180
      ],
      "name": "Read the booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return $input.all().map((item) => {\n  const p = item.json.payload ?? item.json;\n  const email = String(p.email ?? \"\").toLowerCase();\n  const id = String(p.uri ?? p.scheduled_event?.uri ?? \"\").split(\"/\").pop();\n  if (!email || !id) throw new Error(\"Booking has no invitee email or id\");\n  return { json: { email, starts_at: p.scheduled_event?.start_time ?? null, booking_id: id, scope: \"booking\", key: id } };\n});"
      }
    },
    {
      "id": "28f64dbc-4b63-438a-a19c-bf0f10c46640",
      "position": [
        520,
        180
      ],
      "name": "Seen before?",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:idempotency-guard__"
        },
        "options": {}
      }
    },
    {
      "id": "d101f8ed-5c3c-417e-a845-ff8bbdc29094",
      "position": [
        780,
        180
      ],
      "name": "New booking?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "905ac9a6-715e-42ad-ad5e-66e5d287f613",
              "leftValue": "={{ !$json.duplicate }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "0857e053-49af-4f1b-a87f-19a8aedeb853",
      "position": [
        1040,
        90
      ],
      "name": "Mark lead booked",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "leads",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "condition": "eq",
              "keyValue": "={{ $json.email }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "booked",
              "fieldValue": "={{ true }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "={{ 'booked' }}"
            },
            {
              "fieldId": "call_at",
              "fieldValue": "={{ $json.starts_at }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "f67ef109-1e4f-4987-a57e-83259f3a24cd",
      "position": [
        1300,
        180
      ],
      "name": "Known lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "666d7309-0368-4e20-a1de-7a40c881a4e5",
              "leftValue": "={{ !!$json.email }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f312fc35-ad53-4b12-a1e1-bb1bdbbf77a1",
      "position": [
        1560,
        90
      ],
      "name": "Open CRM deal",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2.1,
      "parameters": {
        "authentication": "appToken",
        "resource": "deal",
        "operation": "create",
        "stage": "={{ 'appointmentscheduled' }}",
        "additionalFields": {
          "dealName": "={{ 'Intro call: ' + $json.name }}"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "hubspotAppToken": {
          "id": "__CRED:hubspot__",
          "name": "HubSpot"
        }
      }
    },
    {
      "id": "1aac9ee7-5844-42fb-affb-c6dd52e52f0b",
      "position": [
        1820,
        90
      ],
      "name": "Booked message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const l = $(\"Known lead?\").first().json;\nreturn [{ json: { text: l.name + \" booked a call for \" + l.call_at + \".\", level: \"info\" } }];"
      }
    },
    {
      "id": "63d1eafa-c216-4878-a076-88d827d22cf7",
      "position": [
        2080,
        180
      ],
      "name": "Tell sales",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:notify__"
        },
        "options": {}
      }
    },
    {
      "id": "b799411b-9a9d-4f26-ac1a-c53ad0d89af4",
      "position": [
        1560,
        270
      ],
      "name": "Unknown message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { text: \"A call was booked by \" + $(\"New booking?\").first().json.email + \", who is not in the leads table.\", level: \"warn\" } }];"
      }
    },
    {
      "id": "53791f51-c7a4-42b9-a35f-b63ea06e0fb4",
      "position": [
        1820,
        270
      ],
      "name": "Flag it",
