      ],
      "name": "Score the fit · shape",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"score\": 70,\n  \"fit\": true,\n  \"reason\": \"Why, in one sentence.\",\n  \"missing\": [\n    \"budget\"\n  ]\n}"
      }
    },
    {
      "id": "f70ba5b3-c2fa-4477-a6df-1e4807e155a8",
      "position": [
        2020,
        310
      ],
      "name": "Read the verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const before = $(\"New enquiry?\").all();\nconst out = [];\nfor (const [i, item] of $input.all().entries()) {\n  const answer = item.json.output;\n  const ok = answer && typeof answer === \"object\" && !Array.isArray(answer);\n  out.push({ json: { ...(before[i]?.json ?? {}), ...(ok ? answer : {\"score\":null,\"fit\":null,\"reason\":\"Model reply could not be read\"}), parse_error: !ok } });\n}\nreturn out;"
      }
    },
