      "name": "Score the fit",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ 'From: ' + $json.name + ($json.company ? ' at ' + $json.company : '') + '\\n\\n' + $json.message }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "[task:qualify-lead] You qualify inbound enquiries for a services business. Reply with JSON: { score: 0-100, fit: boolean, reason: string, missing: string[] }. Judge only what the message says.",
          "maxIterations": 2
        }
      },
      "onError": "continueRegularOutput"
    },
