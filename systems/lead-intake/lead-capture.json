{
  "name": "Lead intake · Capture and qualify",
  "nodes": [
    {
      "id": "549c8d4c-ba23-4c76-addc-c83ea6c21eb5",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -480
      ],
      "parameters": {
        "width": 620,
        "height": 220,
        "content": "## Lead intake · Capture and qualify\nTakes an enquiry from any form, rejects junk, ignores repeats, has a model score the fit, then files it in the CRM and sends the right first reply.\n\n**Needs:** CRM_API_KEY, CRM_BASE_URL, DB_API_KEY, DB_BASE_URL, EMAIL_API_KEY, EMAIL_BASE_URL, LLM_API_KEY, LLM_BASE_URL, LLM_MODEL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/lead-intake`"
      }
    },
    {
      "id": "127eeb0a-9aa4-4821-a24a-80655ccff3a8",
      "position": [
        0,
        0
      ],
      "name": "Enquiry form",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "5f08c07c-aaaf-48ae-abb5-df5afa14171f"
    },
    {
      "id": "aa61cc86-3bf7-4447-abea-98977e1e3fbe",
      "position": [
        240,
        0
      ],
      "name": "Validate and normalise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nconst email = String(b.email ?? \"\").trim().toLowerCase();\nconst message = String(b.message ?? \"\").trim();\nconst errors = [];\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) errors.push(\"email\");\nif (message.length < 10) errors.push(\"message\");\nif (b.website) errors.push(\"honeypot\"); // a field people never see and bots always fill\nreturn [{ json: {\n  valid: errors.length === 0, errors,\n  email, message: message.slice(0, 4000),\n  name: String(b.name ?? \"\").trim() || email.split(\"@\")[0],\n  company: String(b.company ?? \"\").trim() || null,\n  source: String(b.source ?? \"website\"),\n  received_at: new Date().toISOString(),\n  scope: \"lead\", key: email + \":\" + new Date().toISOString().slice(0, 10),\n} }];"
      }
    },
    {
      "id": "55e315b0-6a2d-4aee-aa71-2dfb2f7083a9",
      "position": [
        480,
        0
      ],
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "8ba548b6-353c-474e-a581-189fba03a955",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "8c1243a3-8901-49f3-a3bc-6e040c7d1793",
      "position": [
        720,
        -90
      ],
      "name": "Reject",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, errors: $json.errors }) }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "f82c68bd-9675-41ea-a438-266d7b203bfc",
      "position": [
        720,
        90
      ],
      "name": "Accept",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {
          "responseCode": 202
        }
      }
    },
    {
      "id": "cb38c108-b6bb-41b0-a7c1-ca12827eb1f1",
      "position": [
        960,
