        "jsCode": "const l = $(\"Read the verdict\").first().json;\nreturn [{ json: { text: \"New qualified lead: \" + l.name + (l.company ? \" (\" + l.company + \")\" : \"\") + \", score \" + l.score + \". \" + l.reason, level: \"info\" } }];"
