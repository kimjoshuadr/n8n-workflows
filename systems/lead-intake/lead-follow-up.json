{
  "name": "Lead intake · Follow up the unbooked",
  "nodes": [
    {
      "id": "00756567-1278-40f7-aed3-eddf96a4534e",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Lead intake · Follow up the unbooked\nEach morning, writes to qualified leads who have not booked. Three nudges, two days apart, then the lead is marked cold and left alone.\n\n**Platforms:** Supabase, SendGrid\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `systems/lead-intake`"
      }
    },
    {
      "id": "fc6eff86-5da9-4143-acd2-26d5040e967c",
      "position": [
        0,
        180
      ],
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "6a9921e9-7fa6-45c6-ac0b-cfb0ec3a0779",
      "position": [
        260,
        90
      ],
      "name": "Unbooked leads",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "leads",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "={{ 'qualified' }}"
            },
            {
              "keyName": "booked",
              "condition": "eq",
              "keyValue": "={{ 'false' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "61e3f413-9ae6-437e-a724-f2f2648ffa16",
      "position": [
        520,
        180
      ],
      "name": "Who is due?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const now = Date.now();\nconst TWO_DAYS = 2 * 864e5;\nreturn $input.all().map((i) => i.json).filter((l) => l.email)\n  .filter((l) => now - new Date(l.last_contact_at ?? l.received_at).getTime() >= TWO_DAYS)\n  .map((l) => ({ json: { ...l, next: (l.follow_ups ?? 0) + 1, give_up: (l.follow_ups ?? 0) >= 3 } }));"
      }
    },
    {
      "id": "e434ad25-0e23-4e43-a77c-47f6e56e389e",
      "position": [
        780,
        180
      ],
      "name": "Nudges left?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "308a4ea2-73a0-47d7-a94a-55bb747651f2",
              "leftValue": "={{ !$json.give_up }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "7db1d3b9-5dba-4640-ab26-33f25dbc4bd2",
      "position": [
        1040,
        90
      ],
      "name": "Send the nudge",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "parameters": {
        "resource": "mail",
        "operation": "send",
        "fromEmail": "={{ 'hello@example.com' }}",
        "fromName": "={{ 'Acme' }}",
        "toEmail": "={{ $json.email }}",
        "dynamicTemplate": true,
        "templateId": "={{ 'd-follow-up-' + $json.next }}",
        "dynamicTemplateFields": {
          "fields": [
            {
              "key": "name",
              "value": "={{ $json.name }}"
            }
          ]
        },
        "additionalFields": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "sendGridApi": {
          "id": "__CRED:sendgrid__",
          "name": "SendGrid"
        }
      }
    },
    {
      "id": "28ef7e12-6f90-4c26-aee4-f1a41f98ec10",
      "position": [
        1300,
        180
      ],
      "name": "Record the nudge",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "leads",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "condition": "eq",
              "keyValue": "={{ $('Nudges left?').item.json.email }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "follow_ups",
              "fieldValue": "={{ $('Nudges left?').item.json.next }}"
            },
            {
              "fieldId": "last_contact_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "ecd9d818-37af-490c-ae0f-f099acb906af",
      "position": [
        1040,
        270
      ],
      "name": "Mark cold",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "leads",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "condition": "eq",
              "keyValue": "={{ $json.email }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "status",
              "fieldValue": "={{ 'cold' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "a9dbff5c-ca38-4410-a3e2-7e657defbe85",
      "position": [
        260,
        270
      ],
      "name": "Check in",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "heartbeats",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "name",
              "condition": "eq",
              "keyValue": "={{ 'lead-follow-up' }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "last_seen",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    }
  ],
  "connections": {
    "Every morning": {
      "main": [
        [
          {
            "node": "Unbooked leads",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check in",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unbooked leads": {
      "main": [
        [
          {
            "node": "Who is due?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Who is due?": {
      "main": [
        [
          {
            "node": "Nudges left?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Nudges left?": {
      "main": [
        [
          {
            "node": "Send the nudge",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Mark cold",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send the nudge": {
      "main": [
        [
          {
            "node": "Record the nudge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
