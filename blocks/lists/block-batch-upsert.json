{
  "name": "Block · Upsert in chunks",
  "nodes": [
    {
      "id": "f6161fef-3fbe-47ee-aac0-ad5c13060da1",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -300
      ],
      "parameters": {
        "width": 620,
        "height": 220,
        "content": "## Block · Upsert in chunks\nGroups a long list into chunks of 100 and upserts each chunk in one request.\n\n**Needs:** DB_API_KEY, DB_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `blocks/lists`"
      }
    },
    {
      "id": "be9b8e19-b05d-4c6e-ae60-82d4a452979e",
      "position": [
        0,
        0
      ],
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "d938494d-8049-400c-a65d-5006fa3c7369",
      "position": [
        240,
        0
      ],
      "name": "Chunk",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const rows = $input.all().map((i) => i.json);\nconst out = [];\nfor (let i = 0; i < rows.length; i += 100) out.push({ json: { rows: rows.slice(i, i + 100) } });\nreturn out;"
      }
    },
    {
      "id": "7c40a9a2-0315-4d1c-a2fb-67a4d9a4a964",
      "position": [
        480,
        0
      ],
      "name": "Upsert the chunk",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DB_BASE_URL }}/records",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "on_conflict",
              "value": "={{ 'key' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.rows) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    }
  ],
  "connections": {
    "When called": {
      "main": [
        [
          {
            "node": "Chunk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chunk": {
      "main": [
        [
          {
            "node": "Upsert the chunk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
