{
  "name": "Block · Loop that respects a rate limit",
  "nodes": [
    {
      "id": "b5402a59-60e1-4978-a3f1-e8eca0003ca8",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Block · Loop that respects a rate limit\nSends items in small batches with a pause between them, for APIs that reject bursts.\n\n**Platforms:** none, this is logic only\n**Settings:** EMAIL_API_KEY, EMAIL_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `blocks/lists`"
      }
    },
    {
      "id": "29456fd6-d221-4bb3-a076-4c05cb3aac4f",
      "position": [
        0,
        180
      ],
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "241695c6-bc46-49b3-adde-0ba3ec902d0d",
      "position": [
        260,
        180
      ],
      "name": "Five at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "parameters": {
        "batchSize": 5,
        "options": {}
      }
    },
    {
      "id": "946085ab-8480-4676-a553-0615fceaff09",
      "position": [
        520,
        90
      ],
      "name": "Send",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EMAIL_BASE_URL }}/emails",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.EMAIL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.email, template: 'bulk' }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "93335136-9f17-4f45-aa3d-b25a22c7abf8",
      "position": [
        780,
        180
      ],
      "name": "Pause",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "webhookId": "5f71707a-a3ff-48b2-a307-f22c47256f16"
    },
    {
      "id": "bc05a9f0-2ccd-4316-a02d-828fa7eb4020",
      "position": [
        520,
        270
      ],
      "name": "Finished",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    }
  ],
  "connections": {
    "When called": {
      "main": [
        [
          {
            "node": "Five at a time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Five at a time": {
      "main": [
        [
          {
            "node": "Finished",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send": {
      "main": [
        [
          {
            "node": "Pause",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pause": {
      "main": [
        [
          {
            "node": "Five at a time",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
