{
  "name": "Block · Wait for a person's yes",
  "nodes": [
    {
      "id": "810ae272-77b2-4f60-adfb-b1a1a94eaaaa",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -390
      ],
      "parameters": {
        "width": 620,
        "height": 220,
        "content": "## Block · Wait for a person's yes\nRecords a pending decision and gives back approve and reject links. Nothing proceeds until one is pressed, and each link works once.\n\n**Needs:** DB_API_KEY, DB_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `blocks/reliability`"
      }
    },
    {
      "id": "b5a17500-15e1-4031-a9ce-52a4c5702edf",
      "position": [
        0,
        0
      ],
      "name": "Decision link",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "GET",
        "path": "block-approval",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "facc578f-6c8e-460f-abac-5d83098e2e87"
    },
    {
      "id": "745e3af5-4eac-4a5d-a116-7cd560b4cc76",
      "position": [
        240,
        0
      ],
      "name": "Read the link",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const q = $input.first().json.query ?? {};\nreturn [{ json: { token: String(q.token ?? \"\"), decision: q.decision === \"approve\" ? \"approved\" : q.decision === \"reject\" ? \"rejected\" : null } }];"
      }
    },
    {
      "id": "03f464db-fa1d-4ce5-a2a2-a68afaa8c184",
      "position": [
        480,
        0
      ],
      "name": "Resolve if still pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.DB_BASE_URL }}/approvals",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ 'eq.' + $json.token }}"
            },
            {
              "name": "status",
              "value": "={{ 'eq.pending' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: $json.decision, decided_at: $now.toISO() }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true
    },
    {
      "id": "f0fed394-42c6-4876-a934-692bd767984d",
      "position": [
        720,
        0
      ],
      "name": "Resolved now?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "49965971-b5b6-440b-ae0c-8c6d56f375c9",
              "leftValue": "={{ !!$json.token && !!$('Read the link').first().json.decision }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c57ba15a-111f-4269-aa6e-42d06d49bf8b",
      "position": [
        960,
        -90
      ],
      "name": "Thanks",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, status: $json.status }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "b58c6f0f-2371-4495-ac4a-c927e54a91ff",
      "position": [
        960,
        90
      ],
      "name": "Link no longer valid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'This link was already used or does not exist' }) }}",
        "options": {
          "responseCode": 410
        }
      }
    }
  ],
  "connections": {
    "Decision link": {
      "main": [
        [
          {
            "node": "Read the link",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read the link": {
      "main": [
        [
          {
            "node": "Resolve if still pending",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolve if still pending": {
      "main": [
        [
          {
            "node": "Resolved now?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolved now?": {
      "main": [
        [
          {
            "node": "Thanks",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Link no longer valid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
