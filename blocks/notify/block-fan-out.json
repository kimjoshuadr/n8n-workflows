{
  "name": "Block · One event, three channels",
  "nodes": [
    {
      "id": "fd0e7fec-5f0c-494e-a945-04bbfbce22a7",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Block · One event, three channels\nSends the same message by chat, email and SMS, where each channel failing leaves the other two untouched.\n\n**Platforms:** Slack, SendGrid, Twilio\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `blocks/notify`"
      }
    },
    {
      "id": "e3a50d45-e58c-49b7-ad42-f3eae85432bc",
      "position": [
        0,
        90
      ],
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "25f408bd-0113-4440-a475-74d1d68017c2",
      "position": [
        260,
        90
      ],
      "name": "Chat",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ '#general' }}"
        },
        "text": "={{ $json.text }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "slackApi": {
          "id": "__CRED:slack__",
          "name": "Slack"
        }
      }
    },
    {
      "id": "f3ca4c32-3691-404a-af90-893f391fe04a",
      "position": [
        520,
        90
      ],
      "name": "Email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "parameters": {
        "resource": "mail",
        "operation": "send",
        "fromEmail": "={{ 'hello@example.com' }}",
        "fromName": "={{ 'Acme' }}",
        "toEmail": "={{ $('When called').item.json.email }}",
        "subject": "={{ 'Notice' }}",
        "dynamicTemplate": false,
        "contentType": "text/plain",
        "contentValue": "={{ $('When called').item.json.text }}",
        "additionalFields": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "sendGridApi": {
          "id": "__CRED:sendgrid__",
          "name": "SendGrid"
        }
      }
    },
    {
      "id": "b02d9e72-5abb-4a3f-a51a-636fd8586fe0",
      "position": [
        780,
        90
      ],
      "name": "SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "parameters": {
        "resource": "sms",
        "operation": "send",
        "from": "+15550000",
        "to": "={{ $('When called').item.json.phone }}",
        "message": "={{ $('When called').item.json.text.slice(0, 160) }}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "twilioApi": {
          "id": "__CRED:twilio__",
          "name": "Twilio"
        }
      }
    },
    {
      "id": "f882cc6b-f470-4b73-a97c-6606f4dadeac",
      "position": [
        1040,
        90
      ],
      "name": "Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const sent = (name) => { const j = $(name).first().json; return !!j && !j.error; };\nreturn [{ json: { chat: sent(\"Chat\"), email: sent(\"Email\"), sms: sent(\"SMS\") } }];"
      }
    }
  ],
  "connections": {
    "When called": {
      "main": [
        [
          {
            "node": "Chat",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chat": {
      "main": [
        [
          {
            "node": "Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email": {
      "main": [
        [
          {
            "node": "SMS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SMS": {
      "main": [
        [
          {
            "node": "Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
