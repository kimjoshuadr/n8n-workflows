{
  "name": "Block · Event to a chat message",
  "nodes": [
    {
      "id": "e1e0090b-4b1e-464f-a108-d01749b9748f",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Block · Event to a chat message\nTurns any event into one readable chat message.\n\n**Platforms:** none, this is logic only\n**Settings:** CHAT_API_KEY, CHAT_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `blocks/notify`"
      }
    },
    {
      "id": "dd111805-efd3-4ef4-af70-b962b7f6d573",
      "position": [
        0,
        90
      ],
      "name": "Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "block-to-chat",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "10a775c6-7bd7-4e85-aeae-c8ad63d39e99"
    },
    {
      "id": "3e9d4ca4-0f9b-4783-a7e0-3d5785d3b519",
      "position": [
        260,
        90
      ],
      "name": "Post it",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHAT_BASE_URL }}/chat.postMessage",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.CHAT_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: $json.body.channel ?? '#general', text: ($json.body.title ? '*' + $json.body.title + '*\\n' : '') + String($json.body.text ?? '').slice(0, 3000) }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    }
  ],
  "connections": {
    "Event": {
      "main": [
        [
          {
            "node": "Post it",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
