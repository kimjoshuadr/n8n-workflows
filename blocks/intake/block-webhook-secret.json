{
  "name": "Block · Webhook with a shared secret",
  "nodes": [
    {
      "id": "6ee31b3a-e657-43af-ab90-526d33ff4dd8",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Block · Webhook with a shared secret\nRefuses any request that does not carry the secret header, before doing anything else.\n\n**Platforms:** none, this is logic only\n**Settings:** SHOP_API_KEY\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `blocks/intake`"
      }
    },
    {
      "id": "347ecc7e-e168-4a9a-a4e3-f3853a8bd43a",
      "position": [
        0,
        180
      ],
      "name": "Incoming",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "block-secret",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "03c59666-1abd-4254-a7bd-9caf70c6c91d"
    },
    {
      "id": "fe132aea-e655-4182-ac5b-e61c222301eb",
      "position": [
        260,
        180
      ],
      "name": "Has the secret?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "e169d05a-2eeb-40ae-ae09-cb2b2080a4f8",
              "leftValue": "={{ $json.headers['x-webhook-secret'] === $env.SHOP_API_KEY }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "e0683991-2c07-4fbf-a093-dcefe872eb46",
      "position": [
        520,
        90
      ],
      "name": "OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "b9d88f18-7a15-41a2-a9fc-509d49b27034",
