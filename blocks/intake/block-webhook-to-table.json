{
  "name": "Block · Webhook to a table",
  "nodes": [
    {
      "id": "e015fead-a874-4744-ae64-a8fa684103ba",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -300
      ],
      "parameters": {
        "width": 620,
        "height": 220,
        "content": "## Block · Webhook to a table\nThe smallest useful workflow: receive a form post, keep the fields you named, store a row, answer the sender.\n\n**Needs:** DB_API_KEY, DB_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `blocks/intake`"
      }
    },
    {
      "id": "856da8c4-1ef7-40da-a9e2-1714e5b10edb",
      "position": [
        0,
        0
      ],
      "name": "Form posted",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "block-form",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "c489aada-7889-41a7-ab25-3873ff4cb9a1"
    },
    {
      "id": "2ca64af3-be2f-49c3-a4d8-e60878c2ea43",
      "position": [
        240,
        0
      ],
      "name": "Keep known fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\nconst row = Object.fromEntries([\"name\", \"email\", \"message\"].map((k) => [k, typeof body[k] === \"string\" ? body[k].trim().slice(0, 2000) : null]));\nreturn [{ json: { ...row, received_at: new Date().toISOString() } }];"
      }
    },
    {
      "id": "b347c1b3-65ab-4277-ad35-d0982b273dc1",
      "position": [
        480,
        0
      ],
      "name": "Store the row",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DB_BASE_URL }}/form_submissions",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "9fc6b43c-2a82-4322-a503-cd2ec12ef109",
      "position": [
        720,
        0
      ],
      "name": "Thanks",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, id: $json.id }) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Form posted": {
      "main": [
        [
          {
            "node": "Keep known fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep known fields": {
      "main": [
        [
          {
            "node": "Store the row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Store the row": {
      "main": [
        [
          {
            "node": "Thanks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
