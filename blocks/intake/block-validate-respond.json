      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Block · Validate and answer with field errors\nChecks a payload against simple rules and answers with exactly which fields were wrong, so the form can show it.\n\n**Platforms:** none, this is logic only\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `blocks/intake`"
      }
    },
    {
      "id": "a22a6b5c-3fa2-4b9b-a448-d581475e0233",
      "position": [
        0,
        180
      ],
      "name": "Submitted",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "block-validate",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "afb4a648-5bf0-40dc-a0df-90259b086281"
    },
    {
      "id": "c548a1ea-6522-400e-a1fd-010b91401e49",
      "position": [
        260,
        180
      ],
      "name": "Check the fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const v = $input.first().json.body ?? {};\nconst errors = {};\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(String(v.email ?? \"\"))) errors.email = \"Enter a valid email address\";\nif (String(v.name ?? \"\").trim().length < 2) errors.name = \"Enter your name\";\nif (v.phone && !/^\\+?[0-9 ()-]{7,20}$/.test(String(v.phone))) errors.phone = \"Enter a valid phone number\";\nreturn [{ json: { valid: Object.keys(errors).length === 0, errors } }];"
      }
    },
