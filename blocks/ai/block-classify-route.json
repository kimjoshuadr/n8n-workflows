{
  "name": "Block · Classify, then route",
  "nodes": [
    {
      "id": "0cbd329a-c0fa-42f0-a594-7e0bafe377d6",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Block · Classify, then route\nHas a model put a message into one of a fixed set of labels and routes on it, with a default route for anything unexpected.\n\n**Platforms:** OpenAI\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `blocks/ai`"
      }
    },
    {
      "id": "55e34645-22f0-419b-aaae-bf4cd106cc60",
      "position": [
        0,
        270
      ],
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "7f5afb55-e7b6-4364-a31c-89186973d9b6",
      "position": [
        360,
        140
      ],
      "name": "Classify",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "[task:classify] Classify the message. Reply with JSON: { label: 'billing'|'technical'|'general' }.",
          "maxIterations": 2
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "2b196688-2df7-44e2-a30a-33184243a659",
      "position": [
        260,
        360
      ],
      "name": "Classify · GPT",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "__CRED:openai__",
          "name": "OpenAI"
        }
      }
    },
    {
      "id": "ab4c059e-45fe-4d18-ad73-3ab6d80feab9",
      "position": [
        460,
        360
      ],
      "name": "Classify · shape",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"label\": \"billing\",\n  \"urgent\": false,\n  \"sentiment\": \"neutral\"\n}"
      }
    },
    {
      "id": "55b3c9c1-edd0-44bc-aabc-e42c6e07ab91",
      "position": [
        720,
        270
      ],
      "name": "Read the label",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "let label = \"general\";\ntry { const out = $input.first().json.output; const l = (typeof out === \"string\" ? JSON.parse(out) : out).label; if ([\"billing\", \"technical\", \"general\"].includes(l)) label = l; } catch (e) {}\nreturn [{ json: { ...$(\"When called\").first().json, label } }];"
      }
    },
    {
      "id": "f8981aeb-fba8-4c36-a952-56bc2e49eca2",
      "position": [
        980,
        270
      ],
      "name": "By label",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "0e6105f4-b33e-46a8-aeb9-d4a1141be834",
                    "leftValue": "={{ $json.label === 'billing' }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "billing"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "f20e3083-9257-483e-a433-4b8d6c3edb2b",
                    "leftValue": "={{ $json.label === 'technical' }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
