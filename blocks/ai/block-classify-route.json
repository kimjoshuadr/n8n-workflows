{
  "name": "Block · Classify, then route",
  "nodes": [
    {
      "id": "0cbd329a-c0fa-42f0-a594-7e0bafe377d6",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Block · Classify, then route\nHas a model put a message into one of a fixed set of labels and routes on it, with a default route for anything unexpected.\n\n**Platforms:** none, this is logic only\n**Settings:** LLM_API_KEY, LLM_BASE_URL, LLM_MODEL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `blocks/ai`"
      }
    },
    {
      "id": "55e34645-22f0-419b-aaae-bf4cd106cc60",
      "position": [
        0,
        270
      ],
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "7f5afb55-e7b6-4364-a31c-89186973d9b6",
      "position": [
        260,
        270
      ],
      "name": "Classify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LLM_BASE_URL }}/chat/completions",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.LLM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $env.LLM_MODEL,\n  temperature: 0.2,\n  response_format: { type: \"json_object\" },\n  messages: [\n    { role: \"system\", content: \"[task:classify] Classify the message. Reply with JSON: { label: 'billing'|'technical'|'general' }.\" },\n    { role: \"user\", content: $json.text }\n  ]\n}) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "55b3c9c1-edd0-44bc-aabc-e42c6e07ab91",
      "position": [
        520,
        270
      ],
      "name": "Read the label",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "let label = \"general\";\ntry { const l = JSON.parse($input.first().json.choices[0].message.content).label; if ([\"billing\", \"technical\", \"general\"].includes(l)) label = l; } catch (e) {}\nreturn [{ json: { ...$(\"When called\").first().json, label } }];"
      }
    },
    {
      "id": "f8981aeb-fba8-4c36-a952-56bc2e49eca2",
      "position": [
        780,
        270
      ],
      "name": "By label",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "0e6105f4-b33e-46a8-aeb9-d4a1141be834",
                    "leftValue": "={{ $json.label === 'billing' }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "billing"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "f20e3083-9257-483e-a433-4b8d6c3edb2b",
                    "leftValue": "={{ $json.label === 'technical' }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "technical"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
