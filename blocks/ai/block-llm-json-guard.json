{
  "name": "Block · A model reply you can rely on",
  "nodes": [
    {
      "id": "44c2965c-9665-4431-a5a6-fb8153c9e658",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Block · A model reply you can rely on\nAsks a model for JSON, checks the reply has the fields you need, asks once more if it does not, and then gives up honestly.\n\n**Platforms:** none, this is logic only\n**Settings:** LLM_API_KEY, LLM_BASE_URL, LLM_MODEL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `blocks/ai`"
      }
    },
    {
      "id": "94360127-1344-4382-a350-ab007574aaa7",
      "position": [
        0,
        180
      ],
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "2f1630bb-4649-4948-a2c3-dd5716b04e48",
      "position": [
        260,
        180
      ],
      "name": "Ask",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LLM_BASE_URL }}/chat/completions",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.LLM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $env.LLM_MODEL,\n  temperature: 0.2,\n  response_format: { type: \"json_object\" },\n  messages: [\n    { role: \"system\", content: \"[task:guarded] Reply with JSON only.\" },\n    { role: \"user\", content: $json.prompt }\n  ]\n}) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "60c14cb6-e19d-4c53-a456-15c40ad60e0c",
      "position": [
        520,
        180
      ],
      "name": "Check the reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const req = $(\"When called\").first().json;\nconst required = req.required ?? [];\nlet data = null;\ntry { data = JSON.parse($input.first().json.choices[0].message.content); } catch (e) {}\nconst missing = data ? required.filter((k) => data[k] === undefined || data[k] === null) : required;\nreturn [{ json: { ok: !!data && missing.length === 0, data, missing, attempt: $runIndex + 1, prompt: req.prompt + (missing.length ? \"\\n\\nYour last reply was missing: \" + missing.join(\", \") + \". Reply again with every field.\" : \"\") } }];"
      }
    },
    {
      "id": "62ce4d4d-8ea1-4996-a96b-a19629d4a546",
      "position": [
        780,
        180
      ],
      "name": "Good?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "e092e299-e336-436f-a7dd-b43e67067361",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "8333bf41-bb7b-45b8-aabe-d66f039585f0",
      "position": [
        1040,
