      "name": "Check the reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const req = $(\"When called\").first().json;\nconst required = req.required ?? [];\nlet data = null;\ntry { data = JSON.parse($input.first().json.output); } catch (e) {}\nconst missing = data ? required.filter((k) => data[k] === undefined || data[k] === null) : required;\nreturn [{ json: { ok: !!data && missing.length === 0, data, missing, attempt: $runIndex + 1, prompt: req.prompt + (missing.length ? \"\\n\\nYour last reply was missing: \" + missing.join(\", \") + \". Reply again with every field.\" : \"\") } }];"
      }
    },
