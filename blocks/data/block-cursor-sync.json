{
  "name": "Block · Incremental sync with a bookmark",
  "nodes": [
    {
      "id": "8e0f8dd2-fece-4669-a71a-6687f8d7c50a",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Block · Incremental sync with a bookmark\nThe skeleton of every reliable sync: read the bookmark, fetch what is newer, write it, and only then move the bookmark.\n\n**Platforms:** Supabase, HubSpot\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `blocks/data`"
      }
    },
    {
      "id": "e24463a8-b568-48fe-ae05-15373c8370d7",
      "position": [
        0,
        180
      ],
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "parameters": {}
    },
    {
      "id": "2b38276a-8f8a-4515-a388-aa41e4683216",
      "position": [
        260,
        180
      ],
      "name": "Read bookmark",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "sync_cursors",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "name",
              "condition": "eq",
              "keyValue": "={{ 'block-sync' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "f960397b-b671-4a21-a236-1af63390f3d5",
      "position": [
        520,
        180
      ],
      "name": "Fetch newer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.hubapi.com/crm/v3/objects/contacts' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "after",
              "value": "={{ $json.value ?? '0' }}"
            },
            {
              "name": "limit",
              "value": "={{ '100' }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "hubspotAppToken": {
          "id": "__CRED:hubspot__",
          "name": "HubSpot"
        }
      }
    },
    {
      "id": "69153129-555f-48c3-a271-e3794d2630a2",
      "position": [
        780,
        180
      ],
      "name": "Newest id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const rows = $input.first().json.results ?? [];\nreturn [{ json: { rows, count: rows.length, newest: rows.length ? String(Math.max(...rows.map((r) => Number(r.id)))) : null } }];"
      }
    },
    {
      "id": "465e900a-785f-4ea6-a5ce-3f51b223b853",
      "position": [
        1040,
        180
      ],
      "name": "Anything new?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "8895fcd1-c460-45d2-aefa-96592b3fae89",
              "leftValue": "={{ $json.count > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9917a8a6-4b99-4fa2-accd-0d230b8df6b9",
      "position": [
        1300,
        90
      ],
      "name": "Write rows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://acme.supabase.co/rest/v1/synced' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "={{ 'resolution=merge-duplicates,return=representation' }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "on_conflict",
              "value": "={{ 'id' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.rows.map((r) => ({ id: String(r.id), email: r.properties?.email ?? null }))) }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "6129f980-4786-4109-a7e0-76b4286ca43f",
      "position": [
        1560,
        180
      ],
      "name": "Move bookmark",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://acme.supabase.co/rest/v1/sync_cursors' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "={{ 'resolution=merge-duplicates,return=representation' }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "on_conflict",
              "value": "={{ 'name' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: 'block-sync', value: $('Newest id').first().json.newest }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "5a6a3488-b574-404b-ae2c-acbd61dbb79b",
      "position": [
        1300,
        270
      ],
      "name": "Up to date",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    }
  ],
  "connections": {
    "Run manually": {
      "main": [
        [
          {
            "node": "Read bookmark",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read bookmark": {
      "main": [
        [
          {
            "node": "Fetch newer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch newer": {
      "main": [
        [
          {
            "node": "Newest id",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Newest id": {
      "main": [
        [
          {
            "node": "Anything new?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anything new?": {
      "main": [
        [
          {
            "node": "Write rows",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Up to date",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write rows": {
      "main": [
        [
          {
            "node": "Move bookmark",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
