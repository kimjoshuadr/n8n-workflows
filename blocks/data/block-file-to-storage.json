{
  "name": "Block · Archive a Drive file once",
  "nodes": [
    {
      "id": "f1f37d43-3aa5-4f07-a15c-f5375f74e1dd",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Block · Archive a Drive file once\nCopies a Google Drive file into the archive folder under a dated name, and records it so the same file sent twice is archived once.\n\n**Platforms:** Supabase, Google Drive\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `blocks/data`"
      }
    },
    {
      "id": "7365d2e3-10c4-48e3-a242-5679c55b636f",
      "position": [
        0,
        180
      ],
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "4a8806df-2c98-4674-a789-3ea70ce8acac",
      "position": [
        260,
        180
      ],
      "name": "Name it",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return $input.all().map((item) => {\n  const name = String(item.json.name ?? \"file\").replace(/[\\\\/:*?\"<>|]+/g, \"-\").trim();\n  return { json: { file_id: String(item.json.file_id ?? \"\"), key: \"drive/\" + item.json.file_id, archive_name: new Date().toISOString().slice(0, 10) + \" \" + name } };\n});"
      }
    },
    {
      "id": "141f8168-5d0e-4f7c-a3ad-f1a9f9680484",
      "position": [
        520,
        180
      ],
      "name": "Claim the file",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "stored_files",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "key",
              "fieldValue": "={{ $json.key }}"
            },
            {
              "fieldId": "source",
              "fieldValue": "={{ $json.file_id }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput",
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "31b82eb1-88ca-4138-aed3-ad4b22b04b50",
      "position": [
        780,
        90
      ],
      "name": "Copy to the archive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "parameters": {
        "resource": "file",
        "operation": "copy",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Name it').item.json.file_id }}"
        },
        "name": "={{ $('Name it').item.json.archive_name }}",
        "sameFolder": false,
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
          "__rl": true,
          "mode": "id",
          "value": "archive-folder-id"
        },
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "__CRED:googleDrive__",
          "name": "Google Drive"
        }
      }
    },
    {
      "id": "eea57e11-f1c9-46b9-a70d-d8441c8c30c9",
      "position": [
        780,
        270
      ],
      "name": "Already archived",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    }
  ],
  "connections": {
    "When called": {
      "main": [
        [
          {
            "node": "Name it",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Name it": {
      "main": [
        [
          {
            "node": "Claim the file",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim the file": {
      "main": [
        [
          {
            "node": "Copy to the archive",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Already archived",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
