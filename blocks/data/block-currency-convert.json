{
  "name": "Block · Convert a currency amount",
  "nodes": [
    {
      "id": "af6c0d6b-1356-4993-a26a-4726d9bcc5f0",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Block · Convert a currency amount\nConverts an amount with today's rate, rounds like money, and says so when the rate could not be fetched instead of returning a wrong number.\n\n**Platforms:** Stripe\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `blocks/data`"
      }
    },
    {
      "id": "ebe25fb7-4a24-45b5-ac09-7d05b40a2dcc",
      "position": [
        0,
        90
      ],
      "name": "When called",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "b8eae34c-eba4-46dd-a24f-bfcfa705a611",
      "position": [
        260,
        90
      ],
      "name": "Today's rate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.stripe.com/v1/exchange_rates/' + String($json.from).toLowerCase() }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "stripeApi",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "stripeApi": {
          "id": "__CRED:stripe__",
          "name": "Stripe"
        }
      }
    },
    {
      "id": "f0da4299-28e6-4bb4-af0c-d9a913e8d62b",
      "position": [
        520,
        90
      ],
      "name": "Convert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const req = $(\"When called\").first().json;\nconst rate = $input.first().json.rates?.[String(req.to).toLowerCase()];\nif (typeof rate !== \"number\") return [{ json: { ...req, converted: null, ok: false, reason: \"No rate available for \" + req.from + \" to \" + req.to } }];\nreturn [{ json: { ...req, rate, converted: Math.round(req.amount * rate * 100) / 100, ok: true } }];"
      }
    }
  ],
  "connections": {
    "When called": {
      "main": [
        [
          {
            "node": "Today's rate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Today's rate": {
      "main": [
        [
          {
            "node": "Convert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
