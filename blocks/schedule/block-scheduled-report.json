{
  "name": "Block · Scheduled count to chat",
  "nodes": [
    {
      "id": "81660216-8100-4465-aca1-8026477b7e5b",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Block · Scheduled count to chat\nEvery morning, counts yesterday's rows in a table and posts the number.\n\n**Platforms:** Supabase, Slack\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `blocks/schedule`"
      }
    },
    {
      "id": "e3a079bf-3467-4ff4-a55f-e6bf48dcb4b6",
      "position": [
        0,
        90
      ],
      "name": "08:00 daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "1997818f-2761-44bf-aea2-849b68947fa4",
      "position": [
        260,
        90
      ],
      "name": "Yesterday's rows",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "form_submissions",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "received_at",
              "condition": "gte",
              "keyValue": "={{ $now.minus({ days: 1 }).startOf('day').toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "ff4da1f0-c67f-4736-ae48-cbdb52ea9148",
      "position": [
        520,
        90
      ],
      "name": "Count",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { count: $input.all().filter((i) => i.json.id).length } }];"
      }
    },
    {
      "id": "c876f823-9f4f-4f9e-a210-9199b3f869c5",
      "position": [
        780,
        90
      ],
      "name": "Post",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ '#general' }}"
        },
        "text": "={{ $json.count + ' form submissions since yesterday morning.' }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "slackApi": {
          "id": "__CRED:slack__",
          "name": "Slack"
        }
      }
    }
  ],
  "connections": {
    "08:00 daily": {
      "main": [
        [
          {
            "node": "Yesterday's rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Yesterday's rows": {
      "main": [
        [
          {
            "node": "Count",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Count": {
      "main": [
        [
          {
            "node": "Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
