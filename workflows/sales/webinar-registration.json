{
  "name": "Events · Webinar registration and reminders",
  "nodes": [
    {
      "id": "94b9bb57-e865-4777-a101-c40bc4d3a993",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Events · Webinar registration and reminders\nRegisters someone for a webinar, sends the calendar invite, and reminds them a day and an hour before. Full sessions get a waitlist reply.\n\n**Platforms:** Supabase, SendGrid\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/sales`"
      }
    },
    {
      "id": "84fdd34d-0acb-4d79-afc1-890f3c149c2b",
      "position": [
        0,
        270
      ],
      "name": "Registration",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "webinar-register",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "45ead164-37b3-49fe-a3a4-6f6df1b0b1fa"
    },
    {
      "id": "a4de99b5-a706-4a2f-a431-d8138de2aa91",
      "position": [
        260,
        270
      ],
      "name": "Read the form",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nconst email = String(b.email ?? \"\").trim().toLowerCase();\nreturn [{ json: { valid: /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email) && !!b.webinar_id, email, name: String(b.name ?? \"\").trim(), webinar_id: String(b.webinar_id ?? \"\") } }];"
      }
    },
    {
      "id": "6ac60d43-855b-4256-ab86-5cb748269af3",
      "position": [
        520,
        270
      ],
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "8ba548b6-353c-474e-a581-189fba03a955",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "969476db-290f-4136-add8-c2187d38051d",
      "position": [
        780,
        180
      ],
      "name": "Invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'A valid email and a webinar are required' }) }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "f5a5fd9d-6142-41d4-afdc-9431895facb9",
      "position": [
        780,
        360
      ],
      "name": "Load the webinar",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "webinars",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.webinar_id }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "52b5b9dd-0c38-4456-a42a-11d8c20516df",
      "position": [
        1040,
        270
      ],
      "name": "Seats left?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "29a8c670-2e15-429a-af52-6794689dbd48",
              "leftValue": "={{ !!$json.id && ($json.registered ?? 0) < $json.capacity }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "5a5f949e-b610-4c2b-aafc-11893dadaadc",
      "position": [
        1300,
        180
      ],
      "name": "Register",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "registrations",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "key",
              "fieldValue": "={{ $('Read the form').first().json.webinar_id + ':' + $('Read the form').first().json.email }}"
            },
            {
              "fieldId": "webinar_id",
              "fieldValue": "={{ $('Read the form').first().json.webinar_id }}"
            },
            {
              "fieldId": "email",
              "fieldValue": "={{ $('Read the form').first().json.email }}"
            },
            {
              "fieldId": "name",
              "fieldValue": "={{ $('Read the form').first().json.name }}"
            },
            {
              "fieldId": "reminded_day",
              "fieldValue": "={{ false }}"
            },
            {
              "fieldId": "reminded_hour",
              "fieldValue": "={{ false }}"
            }
          ]
        }
      },
      "onError": "continueErrorOutput",
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "b6e25c6d-ac45-4ebe-a974-d7bff37afbcf",
      "position": [
        1560,
        90
      ],
      "name": "Registered already?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "9f291673-cc31-41db-aa79-28029678fc00",
              "leftValue": "={{ /duplicate key|23505/.test(String($json.error ?? '')) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "4906bd42-13fa-4320-af48-dfa69a248875",
      "position": [
        1820,
        90
      ],
      "name": "Try again",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'Registration is unavailable for a moment. Please try again.' }) }}",
        "options": {
          "responseCode": 503
        }
      }
    },
    {
      "id": "39d1899e-d1cd-4cf0-a1ba-c4c5c3b8a480",
      "position": [
        1560,
        270
      ],
      "name": "Count the seat",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "webinars",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Load the webinar').first().json.id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "registered",
              "fieldValue": "={{ ($('Load the webinar').first().json.registered ?? 0) + 1 }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "5ddd5294-a794-4b65-ab8d-b5b27a9c8270",
      "position": [
        1820,
        270
      ],
      "name": "Send the invite",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "parameters": {
        "resource": "mail",
        "operation": "send",
        "fromEmail": "={{ 'hello@example.com' }}",
        "fromName": "={{ 'Acme' }}",
        "toEmail": "={{ $('Read the form').first().json.email }}",
        "dynamicTemplate": true,
        "templateId": "={{ 'd-webinar-confirmed' }}",
        "dynamicTemplateFields": {
          "fields": [
            {
              "key": "title",
              "value": "={{ $('Load the webinar').first().json.title }}"
            },
            {
              "key": "starts_at",
              "value": "={{ $('Load the webinar').first().json.starts_at }}"
            },
            {
              "key": "join_url",
              "value": "={{ $('Load the webinar').first().json.join_url }}"
            }
          ]
        },
        "additionalFields": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "sendGridApi": {
          "id": "__CRED:sendgrid__",
          "name": "SendGrid"
        }
      }
    },
    {
      "id": "4ff542d0-6946-47aa-a546-25dd5a54921d",
      "position": [
        2080,
        270
      ],
      "name": "Confirmed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, status: 'registered' }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "e75c8f15-5b89-4a39-aa36-d441b6d50f68",
      "position": [
        1820,
        450
      ],
      "name": "Already registered",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, status: 'already_registered' }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "be848488-61d4-47e6-ab84-78065c63d285",
      "position": [
        1300,
        360
      ],
      "name": "Add to waitlist",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "waitlist",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "webinar_id",
              "fieldValue": "={{ $('Read the form').first().json.webinar_id }}"
            },
            {
              "fieldId": "email",
              "fieldValue": "={{ $('Read the form').first().json.email }}"
            },
            {
              "fieldId": "at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "f0100853-d664-47d8-ad8a-fa1dfa6be095",
      "position": [
        1560,
        450
      ],
      "name": "Waitlisted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, status: 'waitlisted' }) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
