{
  "name": "CRM · Enrich new contacts",
  "nodes": [
    {
      "id": "30fef254-8f76-42e9-acc5-0d76042db995",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## CRM · Enrich new contacts\nFills in company, role and size for a new CRM contact from an enrichment service, and never overwrites what a person already typed.\n\n**Platforms:** none, this is logic only\n**Settings:** CRM_API_KEY, CRM_BASE_URL, ENRICH_API_KEY, ENRICH_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/sales`"
      }
    },
    {
      "id": "3157603e-4d9f-4d19-af2a-c2f353d08099",
      "position": [
        0,
        180
      ],
      "name": "Contact created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "contact-created",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "817978a7-f8ed-492b-a070-1ac935e4bef3"
    },
    {
      "id": "ef49795c-516c-46e2-a0be-03b0bf5aef5f",
      "position": [
        260,
        180
      ],
      "name": "Read the contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const c = $input.first().json.body ?? {};\nconst email = String(c.email ?? \"\").toLowerCase();\nconst free = /@(gmail|yahoo|hotmail|outlook|icloud|proton)\\./.test(email);\nreturn [{ json: { id: String(c.id), email, existing: c.properties ?? {}, skip: !email || free } }];"
      }
    },
    {
      "id": "4fcd0473-a51a-489c-a91d-1e9aae011743",
      "position": [
        520,
        180
      ],
      "name": "Work email?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b6052b14-eada-4cc4-a134-89a733ce0b36",
              "leftValue": "={{ !$json.skip }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "8c8855ac-5b0a-4840-a801-55dc66fdaf02",
      "position": [
        780,
        90
      ],
      "name": "Look them up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ENRICH_BASE_URL }}/people/match",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.ENRICH_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $json.email }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "e66297c5-d75d-4c87-ad60-7354d3b80d2c",
      "position": [
        1040,
        90
      ],
      "name": "Only the blanks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const c = $(\"Work email?\").first().json;\nconst found = $input.first().json.person ?? {};\nconst candidate = { company: found.organization?.name, jobtitle: found.title, company_size: found.organization?.estimated_num_employees, linkedin: found.linkedin_url };\nconst updates = Object.fromEntries(Object.entries(candidate).filter(([k, v]) => v != null && v !== \"\" && !c.existing[k]));\nreturn [{ json: { id: c.id, updates, changed: Object.keys(updates).length > 0 } }];"
      }
    },
    {
      "id": "7dd1ef6d-3583-4c07-abca-9581957b5c5a",
      "position": [
        1300,
        180
      ],
      "name": "Anything to add?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
