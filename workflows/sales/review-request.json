{
  "name": "Reviews · Ask after delivery",
  "nodes": [
    {
      "id": "e1a25c00-2ac1-4aac-a0ee-e9fe84f25bc7",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Reviews · Ask after delivery\nA week after an order is delivered, asks for a review once. Customers with an open support conversation are not asked.\n\n**Platforms:** Supabase, SendGrid\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/sales`"
      }
    },
    {
      "id": "209749a1-72c4-4469-a637-e9e634c1c82e",
      "position": [
        0,
        90
      ],
      "name": "10:00 daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "588c8bb6-ae47-4ea1-a866-7fb00092c8d6",
      "position": [
        260,
        90
      ],
      "name": "Delivered orders",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "orders",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "={{ 'delivered' }}"
            },
            {
              "keyName": "review_requested",
              "condition": "is",
              "keyValue": "={{ 'null' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "750c9e07-a331-4b34-a4ed-b7434a4e43de",
      "position": [
        520,
        90
      ],
      "name": "Delivered a week ago",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const now = Date.now();\nreturn $input.all().map((i) => i.json).filter((o) => o.email && o.delivered_at)\n  .filter((o) => { const d = (now - new Date(o.delivered_at).getTime()) / 864e5; return d >= 7 && d < 30; })\n  .map((json) => ({ json }));"
      }
    },
    {
      "id": "114943dd-33dd-4235-a5cb-60a812fcfd28",
      "position": [
        780,
        90
      ],
      "name": "Open conversation?",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "support_conversations",
        "returnAll": false,
        "limit": 1,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "email",
              "condition": "eq",
              "keyValue": "={{ $json.email }}"
            },
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "={{ 'open' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "c2b70183-35d4-421a-a733-a998bc8059a1",
      "position": [
        1040,
        90
      ],
      "name": "Happy customers only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const orders = $(\"Delivered a week ago\").all();\nreturn $input.all().map((item, i) => ({ order: orders[i]?.json, open: !!item.json.email })).filter((x) => x.order && !x.open).map((x) => ({ json: x.order }));"
      }
    },
    {
      "id": "b8a8cda5-898f-4c8b-a116-4c314605eb46",
      "position": [
        1300,
        90
      ],
      "name": "Ask for a review",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "parameters": {
        "resource": "mail",
        "operation": "send",
        "fromEmail": "={{ 'hello@example.com' }}",
        "fromName": "={{ 'Acme' }}",
        "toEmail": "={{ $json.email }}",
        "dynamicTemplate": true,
        "templateId": "={{ 'd-review-request' }}",
        "dynamicTemplateFields": {
          "fields": [
            {
              "key": "order_id",
              "value": "={{ $json.order_id }}"
            }
          ]
        },
        "additionalFields": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "sendGridApi": {
          "id": "__CRED:sendgrid__",
          "name": "SendGrid"
        }
      }
    },
    {
      "id": "6dceb0d3-ec0d-4c4c-a36a-8e05da7c8222",
      "position": [
        1560,
        90
      ],
      "name": "Mark asked",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "orders",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "order_id",
              "condition": "eq",
              "keyValue": "={{ $('Happy customers only').item.json.order_id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "review_requested",
              "fieldValue": "={{ true }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    }
  ],
  "connections": {
    "10:00 daily": {
      "main": [
        [
          {
            "node": "Delivered orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delivered orders": {
      "main": [
        [
          {
            "node": "Delivered a week ago",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delivered a week ago": {
      "main": [
        [
          {
            "node": "Open conversation?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Open conversation?": {
      "main": [
        [
          {
            "node": "Happy customers only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Happy customers only": {
      "main": [
        [
          {
            "node": "Ask for a review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask for a review": {
      "main": [
        [
          {
            "node": "Mark asked",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
