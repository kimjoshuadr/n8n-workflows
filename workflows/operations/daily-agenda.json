{
  "name": "Calendar · Morning agenda",
  "nodes": [
    {
      "id": "ebe0da05-131a-4eba-af4b-3ec672c4ceb2",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Calendar · Morning agenda\nPosts today's meetings each weekday morning, with gaps and clashes pointed out, and stays silent on an empty day.\n\n**Platforms:** none, this is logic only\n**Settings:** CALENDAR_API_KEY, CALENDAR_BASE_URL, CHAT_API_KEY, CHAT_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/operations`"
      }
    },
    {
      "id": "1dc86708-c584-4810-a8dd-58d4f98b88cc",
      "position": [
        0,
        180
      ],
      "name": "Weekdays 07:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 7 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "237f2632-7cd7-450a-adf5-1cf4761dfd4d",
      "position": [
        260,
        180
      ],
      "name": "Today's events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.CALENDAR_BASE_URL }}/events",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.CALENDAR_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "from",
              "value": "={{ $now.startOf('day').toISO() }}"
            },
            {
              "name": "to",
              "value": "={{ $now.endOf('day').toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "e084fd54-3a9f-493f-abc6-04b9b9525606",
      "position": [
        520,
        180
      ],
      "name": "Lay out the day",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const events = ($input.first().json.events ?? []).filter((e) => e.start && e.end && !e.declined).sort((a, b) => new Date(a.start) - new Date(b.start));\nconst hm = (iso) => new Date(iso).toISOString().slice(11, 16);\nconst clashes = [];\nfor (let i = 1; i < events.length; i++) if (new Date(events[i].start) < new Date(events[i - 1].end)) clashes.push(events[i - 1].title + \" / \" + events[i].title);\nconst minutes = events.reduce((s, e) => s + (new Date(e.end) - new Date(e.start)) / 60000, 0);\nconst lines = events.map((e) => hm(e.start) + \"-\" + hm(e.end) + \"  \" + e.title);\nreturn [{ json: { count: events.length, clashes, hours: Math.round(minutes / 6) / 10, text: lines.join(\"\\n\") + (clashes.length ? \"\\nClash: \" + clashes.join(\"; \") : \"\") } }];"
      }
    },
    {
      "id": "127c1634-01d9-40c8-a5cd-bb365b53db74",
      "position": [
        780,
        180
      ],
      "name": "Anything on?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "d111f171-b22f-4f9f-a91f-117be7f8db0b",
              "leftValue": "={{ $json.count > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c10740c1-d42f-4c05-ad55-1c213a61958e",
      "position": [
        1040,
        90
      ],
      "name": "Post the agenda",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHAT_BASE_URL }}/chat.postMessage",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.CHAT_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: '@me', text: ':calendar: ' + $json.count + ' meetings today, ' + $json.hours + 'h in total.\\n' + $json.text }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "69f1be33-5bfe-49a6-a838-6ef69c2c902e",
      "position": [
        1040,
        270
      ],
      "name": "Clear day",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    }
  ],
  "connections": {
    "Weekdays 07:30": {
      "main": [
        [
          {
            "node": "Today's events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Today's events": {
      "main": [
        [
          {
            "node": "Lay out the day",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lay out the day": {
      "main": [
        [
          {
            "node": "Anything on?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anything on?": {
      "main": [
        [
          {
            "node": "Post the agenda",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Clear day",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
