{
  "name": "Contracts · Expiry reminders",
  "nodes": [
    {
      "id": "73bb3114-76cf-4870-abf0-fbbfa3815ab2",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -300
      ],
      "parameters": {
        "width": 620,
        "height": 220,
        "content": "## Contracts · Expiry reminders\nWarns the owner of each contract 60, 30 and 7 days before it ends, so renewals are a decision and never an accident.\n\n**Needs:** DB_API_KEY, DB_BASE_URL, EMAIL_API_KEY, EMAIL_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/operations`"
      }
    },
    {
      "id": "7bd67fa1-8654-4e8a-a7a7-626f90c3f5fb",
      "position": [
        0,
        0
      ],
      "name": "Monday 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "88d0cbd0-8640-4b5c-a523-473a3b2ee1ef",
      "position": [
        240,
        0
      ],
      "name": "Active contracts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DB_BASE_URL }}/contracts",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "={{ 'eq.active' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true
    },
    {
      "id": "6d080424-87dd-4da7-a5ca-bb31cd68a699",
      "position": [
        480,
        0
      ],
      "name": "Which warning is due?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const MARKS = [60, 30, 7];\nconst now = Date.now();\nreturn $input.all().map((i) => i.json).filter((c) => c.ends_on && c.owner_email).map((c) => {\n  const days = Math.ceil((new Date(c.ends_on).getTime() - now) / 864e5);\n  const mark = MARKS.filter((m) => days <= m).pop();\n  return { ...c, days, mark };\n}).filter((c) => c.days >= 0 && c.mark && c.mark < (c.last_warning ?? 999)).map((json) => ({ json }));"
      }
    },
    {
      "id": "275001f5-3bcb-47dd-a1c8-3bb2e7022143",
      "position": [
        720,
        0
      ],
      "name": "Warn the owner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EMAIL_BASE_URL }}/emails",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.EMAIL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.owner_email, subject: $json.name + ' ends in ' + $json.days + ' days', template: 'contract-expiry', data: { name: $json.name, ends_on: $json.ends_on, auto_renews: $json.auto_renews === true, notice_days: $json.notice_days } }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "2ecddad7-4372-4f22-acd2-c41b5093bfbb",
      "position": [
        960,
        0
      ],
      "name": "Record the warning",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.DB_BASE_URL }}/contracts",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "={{ 'eq.' + $('Which warning is due?').item.json.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ last_warning: $('Which warning is due?').item.json.mark }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    }
  ],
  "connections": {
    "Monday 09:00": {
      "main": [
        [
          {
            "node": "Active contracts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Active contracts": {
      "main": [
        [
          {
            "node": "Which warning is due?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Which warning is due?": {
      "main": [
        [
          {
            "node": "Warn the owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Warn the owner": {
      "main": [
        [
          {
            "node": "Record the warning",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
