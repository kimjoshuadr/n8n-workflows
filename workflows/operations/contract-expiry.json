{
  "name": "Contracts · Expiry reminders",
  "nodes": [
    {
      "id": "73bb3114-76cf-4870-abf0-fbbfa3815ab2",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Contracts · Expiry reminders\nWarns the owner of each contract 60, 30 and 7 days before it ends, so renewals are a decision and never an accident.\n\n**Platforms:** Supabase, SendGrid\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/operations`"
      }
    },
    {
      "id": "7bd67fa1-8654-4e8a-a7a7-626f90c3f5fb",
      "position": [
        0,
        90
      ],
      "name": "Monday 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 1"
            }
          ]
        }
      }
    },
    {
      "id": "88d0cbd0-8640-4b5c-a523-473a3b2ee1ef",
      "position": [
        260,
        90
      ],
      "name": "Active contracts",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "contracts",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "={{ 'active' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "6d080424-87dd-4da7-a5ca-bb31cd68a699",
      "position": [
        520,
        90
      ],
      "name": "Which warning is due?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const MARKS = [60, 30, 7];\nconst now = Date.now();\nreturn $input.all().map((i) => i.json).filter((c) => c.ends_on && c.owner_email).map((c) => {\n  const days = Math.ceil((new Date(c.ends_on).getTime() - now) / 864e5);\n  const mark = MARKS.filter((m) => days <= m).pop();\n  return { ...c, days, mark };\n}).filter((c) => c.days >= 0 && c.mark && c.mark < (c.last_warning ?? 999)).map((json) => ({ json }));"
      }
    },
    {
      "id": "275001f5-3bcb-47dd-a1c8-3bb2e7022143",
      "position": [
        780,
        90
      ],
      "name": "Warn the owner",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "parameters": {
        "resource": "mail",
        "operation": "send",
        "fromEmail": "={{ 'hello@example.com' }}",
        "fromName": "={{ 'Acme' }}",
        "toEmail": "={{ $json.owner_email }}",
        "dynamicTemplate": true,
        "templateId": "={{ 'd-contract-expiry' }}",
        "dynamicTemplateFields": {
          "fields": [
            {
              "key": "name",
              "value": "={{ $json.name }}"
            },
            {
              "key": "ends_on",
              "value": "={{ $json.ends_on }}"
            },
            {
              "key": "auto_renews",
              "value": "={{ $json.auto_renews === true }}"
            },
            {
              "key": "notice_days",
              "value": "={{ $json.notice_days }}"
            }
          ]
        },
        "additionalFields": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "sendGridApi": {
          "id": "__CRED:sendgrid__",
          "name": "SendGrid"
        }
      }
    },
    {
      "id": "2ecddad7-4372-4f22-acd2-c41b5093bfbb",
      "position": [
        1040,
        90
      ],
      "name": "Record the warning",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "contracts",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $('Which warning is due?').item.json.id }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "last_warning",
              "fieldValue": "={{ $('Which warning is due?').item.json.mark }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    }
  ],
  "connections": {
    "Monday 09:00": {
      "main": [
        [
          {
            "node": "Active contracts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Active contracts": {
      "main": [
        [
          {
            "node": "Which warning is due?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Which warning is due?": {
      "main": [
        [
          {
            "node": "Warn the owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Warn the owner": {
      "main": [
        [
          {
            "node": "Record the warning",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
