{
  "name": "People · New hire onboarding",
  "nodes": [
    {
      "id": "83ae19e9-d3a2-435b-abae-ccca80e2d98c",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## People · New hire onboarding\nWhen someone is hired, creates their checklist, books their first-week meetings, tells the people who need to act, and sends the welcome email on the right morning.\n\n**Platforms:** BambooHR, Supabase, Google Calendar, SendGrid\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/operations`"
      }
    },
    {
      "id": "8113f1d6-a5f3-49f6-ae85-f81d6ba7f5b2",
      "position": [
        0,
        180
      ],
      "name": "Hire confirmed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "hire-confirmed",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "44ca58c7-e7c5-4bbd-a832-5923bf9dfcda"
    },
    {
      "id": "1df97c2a-f2ba-4be0-a209-7820c30f4841",
      "position": [
        260,
        180
      ],
      "name": "Fetch the employee",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.bamboohr.com/api/gateway.php/acme/v1/employees/' + $json.body.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "bambooHrApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "={{ 'application/json' }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "={{ 'firstName,lastName,workEmail,jobTitle,supervisorEmail,hireDate,location' }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "bambooHrApi": {
          "id": "__CRED:bamboohr__",
          "name": "BambooHR"
        }
      }
    },
    {
      "id": "1a62c906-18bd-447c-ac2f-9912c625a41d",
      "position": [
        520,
        180
      ],
      "name": "Read the hire",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const h = $input.first().json ?? {};\nif (!h.workEmail || !h.hireDate) throw new Error(\"A hire needs a work email and a hire date in BambooHR\");\nreturn [{ json: { employee_id: String(h.id), email: String(h.workEmail).toLowerCase(), name: [h.firstName, h.lastName].filter(Boolean).join(\" \") || \"New hire\", role: h.jobTitle ?? \"\", manager: h.supervisorEmail ?? null, start_date: h.hireDate, remote: /remote/i.test(h.location ?? \"\"), scope: \"hire\", key: String(h.id) } }];"
      }
    },
    {
      "id": "65548fa8-317c-4ea7-a95f-d6b42eaa3634",
      "position": [
        780,
        180
      ],
      "name": "Seen before?",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:idempotency-guard__"
        },
        "options": {}
      }
    },
    {
      "id": "7170f6de-c6ea-4cea-a13f-bc9d478fd1f7",
      "position": [
        1040,
        180
      ],
      "name": "New hire?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "fc31d1b4-3200-4c6c-a4c2-071a88240df8",
              "leftValue": "={{ !$json.duplicate }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "40b8a0dc-f966-4500-a35d-ffd255c93d5c",
      "position": [
        1300,
        90
      ],
      "name": "Build the checklist",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const h = $input.first().json;\nconst day = (offset) => new Date(new Date(h.start_date).getTime() + offset * 864e5).toISOString().slice(0, 10);\nconst tasks = [\n  { owner: \"it\", task: \"Create accounts and order a laptop\", due: day(-5) },\n  { owner: \"it\", task: h.remote ? \"Ship the laptop\" : \"Prepare a desk\", due: day(-3) },\n  { owner: \"hr\", task: \"Send the contract and collect documents\", due: day(-7) },\n  { owner: \"manager\", task: \"Write the 30-day plan\", due: day(-1) },\n  { owner: \"manager\", task: \"First one-to-one\", due: day(0) },\n  { owner: \"hr\", task: \"Day 30 check-in\", due: day(30) },\n];\nreturn tasks.map((t) => ({ json: { ...t, employee_id: h.employee_id, employee: h.name, status: \"open\" } }));"
      }
    },
    {
      "id": "00c9cf76-60fb-4b61-a133-14df519df8c2",
      "position": [
        1560,
        180
      ],
      "name": "Save the task",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "onboarding_tasks",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "owner",
              "fieldValue": "={{ $json.owner }}"
            },
            {
              "fieldId": "task",
              "fieldValue": "={{ $json.task }}"
            },
            {
              "fieldId": "due",
              "fieldValue": "={{ $json.due }}"
            },
            {
              "fieldId": "employee_id",
              "fieldValue": "={{ $json.employee_id }}"
            },
            {
              "fieldId": "employee",
              "fieldValue": "={{ $json.employee }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "={{ $json.status }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "dcae3ec7-e95d-47e4-adbc-f00f76c29366",
      "position": [
        1820,
        180
      ],
      "name": "Book first-day welcome",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": {
          "__rl": true,
          "mode": "id",
          "value": "kim@example.com"
        },
        "start": "={{ $('New hire?').first().json.start_date + 'T09:30:00' }}",
        "end": "={{ $('New hire?').first().json.start_date + 'T10:00:00' }}",
        "additionalFields": {
          "summary": "={{ 'Welcome, ' + $('New hire?').first().json.name }}",
          "attendees": [
            "={{ [$('New hire?').first().json.email, $('New hire?').first().json.manager].filter(Boolean).join(',') }}"
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "executeOnce": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "googleCalendarOAuth2Api": {
          "id": "__CRED:googleCalendar__",
          "name": "Google Calendar"
        }
      }
    },
    {
      "id": "6de40182-e2bc-4e5e-a6a3-53f294f5ebf2",
      "position": [
        2080,
        180
      ],
      "name": "Schedule the welcome email",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "parameters": {
        "resource": "mail",
        "operation": "send",
        "fromEmail": "={{ 'hello@example.com' }}",
        "fromName": "={{ 'Acme' }}",
        "toEmail": "={{ $('New hire?').first().json.email }}",
        "dynamicTemplate": true,
        "templateId": "={{ 'd-welcome-new-hire' }}",
        "dynamicTemplateFields": {
          "fields": [
            {
              "key": "name",
              "value": "={{ $('New hire?').first().json.name }}"
            },
            {
              "key": "role",
              "value": "={{ $('New hire?').first().json.role }}"
            }
          ]
        },
        "additionalFields": {
          "sendAt": "={{ $('New hire?').first().json.start_date + 'T08:00:00' }}"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "executeOnce": true,
      "credentials": {
        "sendGridApi": {
          "id": "__CRED:sendgrid__",
          "name": "SendGrid"
        }
      }
    },
    {
      "id": "272112a1-ed06-441c-a9d3-18023bfc6f3e",
      "position": [
        2340,
        180
      ],
      "name": "Team message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const h = $(\"New hire?\").first().json;\nreturn [{ json: { channel: \"#people\", level: \"info\", text: h.name + \" (\" + h.role + \") starts on \" + h.start_date + \". Six onboarding tasks are assigned to IT, HR and their manager.\" } }];"
      }
    },
    {
      "id": "5bec1bc9-bc60-400c-af8f-490bf7c8691a",
      "position": [
        2600,
        180
      ],
      "name": "Tell the team",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:notify__"
        },
        "options": {}
      }
    },
    {
      "id": "e7aa6956-3546-4538-a9d7-551909492b49",
      "position": [
        1300,
        270
      ],
      "name": "Already set up",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    }
  ],
