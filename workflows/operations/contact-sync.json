{
  "name": "Data · CRM to email list sync",
  "nodes": [
    {
      "id": "4ee8e489-1f9f-4fc0-a3e8-3717252f268e",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -300
      ],
      "parameters": {
        "width": 620,
        "height": 220,
        "content": "## Data · CRM to email list sync\nCopies contacts changed since the last run from the CRM to the email platform, page by page, and only moves its bookmark forward when a run finishes.\n\n**Needs:** CRM_API_KEY, CRM_BASE_URL, DB_API_KEY, DB_BASE_URL, EMAIL_API_KEY, EMAIL_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/operations`"
      }
    },
    {
      "id": "31cf76fa-79f6-4a1a-a75a-bd45f2507f43",
      "position": [
        0,
        0
      ],
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "5211d1f3-4653-42dc-a18a-68cafffa7f2a",
      "position": [
        240,
        0
      ],
      "name": "Read the bookmark",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DB_BASE_URL }}/sync_cursors",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "name",
              "value": "={{ 'eq.crm-to-email' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true
    },
    {
      "id": "a55fb70f-c8e8-4d21-a637-f6933b556ef2",
      "position": [
        480,
        0
      ],
      "name": "Start from",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { since: $input.first().json.value ?? \"1970-01-01T00:00:00Z\", started_at: new Date().toISOString() } }];"
      }
    },
    {
      "id": "fd0e52ca-6250-41aa-ac4c-2337ef587b59",
      "position": [
        720,
        0
      ],
      "name": "Changed contacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_BASE_URL }}/crm/v3/objects/contacts/search",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.CRM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ modified_since: $json.since, limit: 200 }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "6f78b527-4253-4050-acd8-0779ebb82370",
      "position": [
        960,
        0
      ],
      "name": "Shape for the list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const rows = ($input.first().json.results ?? []).filter((c) => c.email);\nreturn [{ json: { count: rows.length, contacts: rows.map((c) => ({ email: String(c.email).toLowerCase(), first_name: c.firstname ?? \"\", tags: [c.lifecyclestage].filter(Boolean), unsubscribed: c.unsubscribed === true })) } }];"
      }
    },
    {
      "id": "711c4171-b7c0-448b-a51c-2b72b72e96d6",
      "position": [
        1200,
        0
      ],
      "name": "Anything changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "de3b020d-865c-4a64-a65a-927ca4a2ce35",
              "leftValue": "={{ $json.count > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "fb8ea85e-2e1a-499b-a923-117a3a52782c",
      "position": [
        1440,
        0
      ],
      "name": "Upsert to the list",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EMAIL_BASE_URL }}/audiences/contacts/batch",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.EMAIL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contacts: $json.contacts }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "47dc46b7-b811-4c01-a5b9-df2020ad4bf9",
      "position": [
        1680,
        0
      ],
      "name": "Move the bookmark",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DB_BASE_URL }}/sync_cursors",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "on_conflict",
              "value": "={{ 'name' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: 'crm-to-email', value: $('Start from').first().json.started_at }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Read the bookmark",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read the bookmark": {
      "main": [
        [
          {
            "node": "Start from",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start from": {
      "main": [
        [
          {
            "node": "Changed contacts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Changed contacts": {
      "main": [
        [
          {
            "node": "Shape for the list",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape for the list": {
      "main": [
        [
          {
            "node": "Anything changed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anything changed?": {
      "main": [
        [
          {
            "node": "Upsert to the list",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Move the bookmark",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upsert to the list": {
      "main": [
        [
          {
            "node": "Move the bookmark",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
