{
  "name": "Data · CRM to email list sync",
  "nodes": [
    {
      "id": "4ee8e489-1f9f-4fc0-a3e8-3717252f268e",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Data · CRM to email list sync\nCopies contacts changed since the last run from the CRM to the email platform, page by page, and only moves its bookmark forward when a run finishes.\n\n**Platforms:** Supabase, HubSpot, Mailchimp\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/operations`"
      }
    },
    {
      "id": "31cf76fa-79f6-4a1a-a75a-bd45f2507f43",
      "position": [
        0,
        180
      ],
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "5211d1f3-4653-42dc-a18a-68cafffa7f2a",
      "position": [
        260,
        180
      ],
      "name": "Read the bookmark",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "sync_cursors",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "name",
              "condition": "eq",
              "keyValue": "={{ 'crm-to-email' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "a55fb70f-c8e8-4d21-a637-f6933b556ef2",
      "position": [
        520,
        180
      ],
      "name": "Start from",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return [{ json: { since: $input.first().json.value ?? \"1970-01-01T00:00:00Z\", started_at: new Date().toISOString() } }];"
      }
    },
    {
      "id": "fd0e52ca-6250-41aa-ac4c-2337ef587b59",
      "position": [
        780,
        180
      ],
      "name": "Changed contacts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.hubapi.com/crm/v3/objects/contacts/search' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "hubspotAppToken",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filterGroups: [{ filters: [{ propertyName: 'lastmodifieddate', operator: 'GTE', value: $json.since }] }], properties: ['email', 'firstname', 'lifecyclestage', 'hs_email_optout'], limit: 100 }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "hubspotAppToken": {
          "id": "__CRED:hubspot__",
          "name": "HubSpot"
        }
      }
    },
    {
      "id": "6f78b527-4253-4050-acd8-0779ebb82370",
      "position": [
        1040,
        180
      ],
      "name": "Shape for the list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const rows = ($input.first().json.results ?? []).map((c) => c.properties ?? {}).filter((c) => c.email);\n// An opt-out in HubSpot travels with the contact, so Mailchimp never mails someone the CRM says not to.\nreturn [{ json: { count: rows.length, members: rows.map((c) => ({ email_address: String(c.email).toLowerCase(), status: String(c.hs_email_optout) === \"true\" ? \"unsubscribed\" : \"subscribed\", merge_fields: { FNAME: c.firstname ?? \"\" }, tags: [c.lifecyclestage].filter(Boolean) })) } }];"
      }
    },
    {
      "id": "711c4171-b7c0-448b-a51c-2b72b72e96d6",
      "position": [
        1300,
        180
      ],
      "name": "Anything changed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "de3b020d-865c-4a64-a65a-927ca4a2ce35",
              "leftValue": "={{ $json.count > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "fb8ea85e-2e1a-499b-a923-117a3a52782c",
      "position": [
        1560,
        180
      ],
      "name": "Upsert to the list",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://us1.api.mailchimp.com/3.0/lists/main-list' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "mailchimpApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ members: $json.members, update_existing: true }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "mailchimpApi": {
          "id": "__CRED:mailchimp__",
          "name": "Mailchimp"
        }
      }
    },
    {
      "id": "47dc46b7-b811-4c01-a5b9-df2020ad4bf9",
      "position": [
        1820,
        180
      ],
      "name": "Move the bookmark",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "sync_cursors",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "name",
              "condition": "eq",
              "keyValue": "={{ 'crm-to-email' }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "value",
              "fieldValue": "={{ $('Start from').first().json.started_at }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "5c0a4934-d20a-4101-a9a1-379e3cc2471c",
      "position": [
        2080,
        180
      ],
      "name": "Had a bookmark?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "0053a14e-c2ea-45a0-af15-03a51e486e70",
              "leftValue": "={{ !!$json.name }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c5686ce7-6581-4732-a3c6-96b9385a041e",
      "position": [
        2340,
        90
      ],
      "name": "Start the bookmark",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "sync_cursors",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "name",
              "fieldValue": "={{ 'crm-to-email' }}"
            },
            {
              "fieldId": "value",
              "fieldValue": "={{ $('Start from').first().json.started_at }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "3baa9c25-5c30-476a-a699-97b4553b388c",
      "position": [
        2340,
        270
      ],
      "name": "Bookmark moved",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Read the bookmark",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read the bookmark": {
      "main": [
        [
          {
            "node": "Start from",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start from": {
      "main": [
        [
          {
            "node": "Changed contacts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Changed contacts": {
      "main": [
        [
          {
            "node": "Shape for the list",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape for the list": {
      "main": [
        [
          {
