          }
        ],
        [
          {
            "node": "Move the bookmark",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upsert to the list": {
      "main": [
        [
          {
            "node": "Move the bookmark",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Move the bookmark": {
      "main": [
        [
          {
            "node": "Had a bookmark?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Had a bookmark?": {
      "main": [
        [
          {
            "node": "Bookmark moved",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Start the bookmark",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
