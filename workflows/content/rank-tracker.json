{
  "name": "SEO · Keyword rank tracker",
  "nodes": [
    {
      "id": "d0c1473d-46df-4478-ab66-a7b8d05afaaf",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## SEO · Keyword rank tracker\nRecords where the site ranks for each tracked keyword every day, and alerts when one falls five places or drops off the first page.\n\n**Platforms:** Supabase, SerpAPI\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/content`"
      }
    },
    {
      "id": "7088e2ba-68f5-463b-aa23-ed2f4b1464bc",
      "position": [
        0,
        180
      ],
      "name": "05:00 daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 5 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "93568259-4da4-4912-aec0-7288e35a5379",
      "position": [
        260,
        180
      ],
      "name": "Tracked keywords",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "keywords",
        "returnAll": true
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "46728195-3a4d-41e7-a6a9-fb7b6af5d707",
      "position": [
        520,
        180
      ],
      "name": "Search for it",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://serpapi.com/search.json' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "serpApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.keyword }}"
            },
            {
              "name": "num",
              "value": "={{ '10' }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "serpApi": {
          "id": "__CRED:serpapi__",
          "name": "SerpAPI"
        }
      }
    },
    {
      "id": "16c88ff0-1d72-41d0-a1d8-08d2967004cb",
      "position": [
        780,
        180
      ],
      "name": "Find our position",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const kws = $(\"Tracked keywords\").all();\nreturn $input.all().map((item, i) => {\n  const k = kws[i]?.json;\n  if (!k?.keyword) return null;\n  const results = item.json.organic_results;\n  if (!Array.isArray(results)) return { json: { ...k, position: null, checked: false } };\n  const idx = results.findIndex((r) => String(r.link ?? \"\").includes(k.domain));\n  const position = idx === -1 ? null : idx + 1;\n  const before = k.last_position ?? null;\n  const fell = before !== null && (position === null || position - before >= 5);\n  const offFirstPage = before !== null && before <= 10 && (position === null || position > 10);\n  return { json: { ...k, position, before, checked: true, alert: fell || offFirstPage } };\n}).filter(Boolean);"
      }
    },
    {
      "id": "80c5ba5f-d592-497d-a633-63c769914243",
      "position": [
        1040,
        180
      ],
      "name": "Got a result?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "736a0f7e-147b-4f5c-a53a-b3694398cd04",
              "leftValue": "={{ $json.checked }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "7fb769f1-eae5-43e7-ad02-ccf615078f6b",
      "position": [
        1300,
        90
      ],
      "name": "Record today",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "rank_history",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "keyword",
              "fieldValue": "={{ $json.keyword }}"
            },
            {
              "fieldId": "position",
              "fieldValue": "={{ $json.position }}"
            },
            {
              "fieldId": "at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "e47b9f1c-9133-4c51-aef5-2819eb56261b",
      "position": [
        1560,
        180
      ],
      "name": "Update the keyword",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "keywords",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "keyword",
              "condition": "eq",
              "keyValue": "={{ $('Got a result?').item.json.keyword }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "last_position",
              "fieldValue": "={{ $('Got a result?').item.json.position }}"
            },
            {
              "fieldId": "checked_at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "db1a4d9a-0c7c-4beb-a80e-dc9f3c0f0c54",
      "position": [
        1820,
        180
      ],
      "name": "Gather the drops",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const drops = $(\"Got a result?\").all().map((i) => i.json).filter((k) => k.alert);\nif (!drops.length) return [];\nreturn [{ json: { channel: \"#seo\", level: \"warn\", text: drops.length + \" keyword(s) dropped: \" + drops.map((d) => \"\\\"\" + d.keyword + \"\\\" \" + d.before + \" to \" + (d.position ?? \"not in top 30\")).join(\"; \") } }];"
      }
    },
    {
      "id": "d7a6ee0b-7089-424c-a59b-c0209e3b07ad",
      "position": [
        2080,
        180
      ],
      "name": "Alert",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:notify__"
        },
        "options": {}
      }
    },
    {
      "id": "8dda734b-cae2-4de8-a5a5-42069bc76550",
      "position": [
        1300,
        270
      ],
      "name": "Search failed, keep yesterday",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    }
  ],
