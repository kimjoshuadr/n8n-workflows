{
  "name": "Brand · Mention monitor",
  "nodes": [
    {
      "id": "fd7adbcf-5839-4c98-a544-b11917a87adf",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Brand · Mention monitor\nChecks hourly for new mentions of the brand, and raises the negative ones straight away with the text and the link.\n\n**Platforms:** SerpAPI, Supabase, OpenAI\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/content`"
      }
    },
    {
      "id": "783f890a-1f56-4274-a82b-85b36463e9ff",
      "position": [
        0,
        220
      ],
      "name": "Hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "1f6f7a17-4b0b-477e-aedd-db2ce240958a",
      "position": [
        260,
        220
      ],
      "name": "Search for mentions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://serpapi.com/search.json' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "serpApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ '\"YourBrand\" -site:yourbrand.com' }}"
            },
            {
              "name": "num",
              "value": "={{ '10' }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "serpApi": {
          "id": "__CRED:serpapi__",
          "name": "SerpAPI"
        }
      }
    },
    {
      "id": "5aa5a603-f41c-4f9a-aa3b-de47c512dc3c",
      "position": [
        520,
        220
      ],
      "name": "One item per mention",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return ($input.first().json.organic_results ?? []).filter((m) => m.link && m.snippet).map((m) => ({ json: { url: m.link, text: String(m.snippet).slice(0, 1500), author: m.source ?? \"unknown\" } }));"
      }
    },
    {
      "id": "04434a01-4cdb-45fd-a1f3-f50baec5b005",
      "position": [
        780,
        220
      ],
      "name": "Already seen",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "seen_mentions",
        "returnAll": true
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "executeOnce": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "10500e04-a418-4c77-a8aa-c4aaad3f744f",
      "position": [
        1040,
        220
      ],
      "name": "Keep the unseen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const seen = new Set($input.all().map((i) => i.json.url).filter(Boolean));\nreturn $(\"One item per mention\").all().filter((i) => !seen.has(i.json.url));"
      }
    },
    {
      "id": "0f96b39f-4736-4171-a25c-778a1b16321f",
      "position": [
        1300,
        220
      ],
      "name": "Remember it",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "seen_mentions",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "url",
              "fieldValue": "={{ $json.url }}"
            },
            {
              "fieldId": "text",
              "fieldValue": "={{ $json.text }}"
            },
            {
              "fieldId": "author",
              "fieldValue": "={{ $json.author }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "9f0e05e0-d6d4-41ba-a9e4-7c45edf88955",
      "position": [
        1560,
        220
      ],
      "name": "New mention?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "0af0568a-5483-443d-a949-162ab3b25f45",
              "leftValue": "={{ !!$json.url }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "709e6a7c-db85-41d5-a448-3325ef6a0625",
      "position": [
        1920,
        90
      ],
      "name": "Read the tone",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "[task:classify] Classify a public mention of a brand. Reply with JSON: { label: string, urgent: boolean, sentiment: 'negative'|'neutral'|'positive' }.",
          "maxIterations": 2
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "2d449a17-d4b7-403c-ace6-23627f1c2c5f",
      "position": [
        1820,
        310
      ],
      "name": "Read the tone · GPT",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "__CRED:openai__",
          "name": "OpenAI"
        }
      }
    },
    {
      "id": "8a8704b2-79d0-4b8e-a37a-243dcfd4ce06",
      "position": [
        2020,
        310
      ],
      "name": "Read the tone · shape",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"label\": \"billing\",\n  \"urgent\": false,\n  \"sentiment\": \"neutral\"\n}"
      }
    },
    {
      "id": "a33254dd-9d01-4f63-afb8-8192e282cd8a",
      "position": [
        2280,
        220
      ],
      "name": "Read the verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const before = $(\"New mention?\").all();\nconst out = [];\nfor (const [i, item] of $input.all().entries()) {\n  const answer = item.json.output;\n  const ok = answer && typeof answer === \"object\" && !Array.isArray(answer);\n  out.push({ json: { ...(before[i]?.json ?? {}), ...(ok ? answer : {\"sentiment\":\"unknown\"}), parse_error: !ok } });\n}\nreturn out;"
      }
    },
    {
      "id": "c611beb0-43ce-4506-ae34-bb8a59e94758",
      "position": [
        2540,
        220
      ],
      "name": "Needs attention?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "9f752473-dabe-43f0-ab0a-a87aeeda6155",
              "leftValue": "={{ $json.sentiment === 'negative' || $json.sentiment === 'unknown' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "111a576d-cccd-4ada-af8f-6d8381d791be",
      "position": [
        2800,
        220
      ],
      "name": "Write the alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return $input.all().map((i) => ({ json: { channel: \"#brand\", level: \"warn\", text: (i.json.sentiment === \"unknown\" ? \"Unclassified\" : \"Negative\") + \" mention by \" + i.json.author + \": \\\"\" + i.json.text.slice(0, 240) + \"\\\" \" + i.json.url } }));"
      }
    },
    {
      "id": "a257aad1-dddc-44ca-ad56-a889b9f0f97b",
      "position": [
        3060,
        220
      ],
      "name": "Raise it",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:notify__"
        },
        "options": {}
      }
    }
  ],
