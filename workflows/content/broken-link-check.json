{
  "name": "SEO · Broken link check",
  "nodes": [
    {
      "id": "1899a43d-f976-47a6-add6-a7c84a792a69",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## SEO · Broken link check\nEvery Sunday night, visits each page in the sitemap list and reports the ones that no longer load, with the status each returned.\n\n**Platforms:** Supabase, Slack\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/content`"
      }
    },
    {
      "id": "64bf7497-7acb-4077-ac69-ddb08c528331",
      "position": [
        0,
        90
      ],
      "name": "Sunday 23:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 23 * * 0"
            }
          ]
        }
      }
    },
    {
      "id": "8fa0038a-a8b3-4563-aa94-abf2505256d6",
      "position": [
        260,
        90
      ],
      "name": "Pages to check",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "site_pages",
        "returnAll": true
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "f6a14775-0815-4ee8-a343-bc8acbc85627",
      "position": [
        520,
        90
      ],
      "name": "Visit the page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "690182e4-2c28-4f58-a0fd-666bed0f6d85",
      "position": [
        780,
        90
      ],
      "name": "Find the broken ones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const pages = $(\"Pages to check\").all();\nconst results = $input.all().map((item, i) => ({ url: pages[i]?.json.url, status: item.json.statusCode ?? 0 })).filter((r) => r.url);\nconst broken = results.filter((r) => r.status === 0 || r.status >= 400);\nreturn [{ json: { checked: results.length, broken, any: broken.length > 0, text: broken.length + \" of \" + results.length + \" pages are broken:\\n\" + broken.map((b) => \"- \" + b.url + \" (\" + (b.status || \"no response\") + \")\").join(\"\\n\") } }];"
      }
    },
    {
      "id": "450bc51c-1ede-4a2f-ae89-2fbba4be183c",
      "position": [
        1040,
        90
      ],
      "name": "Any broken?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cb0ed925-8588-45a1-a4c2-bfe199fdbc84",
              "leftValue": "={{ $json.any }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "8b399977-3748-4f85-a978-495a85a9dd35",
      "position": [
        1300,
        90
      ],
      "name": "Report them",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ '#website' }}"
        },
        "text": "={{ ':link: ' + $json.text }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "slackApi": {
          "id": "__CRED:slack__",
          "name": "Slack"
        }
      }
    },
    {
      "id": "457c27ef-751e-4d52-a4d3-dd43cc695c91",
      "position": [
        1560,
        90
      ],
      "name": "Save the run",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "link_checks",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "checked",
              "fieldValue": "={{ $('Find the broken ones').first().json.checked }}"
            },
            {
              "fieldId": "broken",
              "fieldValue": "={{ $('Find the broken ones').first().json.broken.length }}"
            },
            {
              "fieldId": "at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    }
  ],
  "connections": {
    "Sunday 23:00": {
      "main": [
        [
          {
            "node": "Pages to check",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pages to check": {
      "main": [
        [
          {
            "node": "Visit the page",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Visit the page": {
      "main": [
        [
          {
            "node": "Find the broken ones",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find the broken ones": {
      "main": [
        [
          {
            "node": "Any broken?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any broken?": {
      "main": [
        [
          {
            "node": "Report them",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Save the run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Report them": {
      "main": [
        [
          {
            "node": "Save the run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
