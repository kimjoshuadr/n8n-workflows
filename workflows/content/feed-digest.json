{
  "name": "Content · Industry news digest",
  "nodes": [
    {
      "id": "de86528e-868c-4517-ad9d-ebc048846226",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Content · Industry news digest\nEach Friday, reads the feeds you follow, drops what was already sent, and emails a short digest of what is new.\n\n**Platforms:** none, this is logic only\n**Settings:** DB_API_KEY, DB_BASE_URL, EMAIL_API_KEY, EMAIL_BASE_URL, LLM_API_KEY, LLM_BASE_URL, LLM_MODEL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/content`"
      }
    },
    {
      "id": "cc9d4449-7460-44ef-a9f2-fa35b2b73ace",
      "position": [
        0,
        180
      ],
      "name": "Friday 15:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 15 * * 5"
            }
          ]
        }
      }
    },
    {
      "id": "177a9f15-bba1-4e84-af8d-87fa87c9c578",
      "position": [
        260,
        180
      ],
      "name": "Feeds to read",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DB_BASE_URL }}/feeds",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true
    },
    {
      "id": "af78b7b8-9ef8-4c32-a03a-2aae5929a03e",
      "position": [
        520,
        180
      ],
      "name": "Fetch the feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $json.url }}",
        "options": {
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "b5b5a71e-36ae-40cf-a4cf-a539b9df84a0",
      "position": [
        780,
        180
      ],
      "name": "Collect the items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const items = $input.all().flatMap((i) => i.json.items ?? []).filter((x) => x && x.url && x.title);\nconst unique = [...new Map(items.map((x) => [x.url, x])).values()];\nreturn unique.map((x) => ({ json: { url: x.url, title: x.title, summary: String(x.summary ?? \"\").slice(0, 500) } }));"
      }
    },
    {
      "id": "0b5672e7-ce8f-4afa-aa63-7ee83469328b",
      "position": [
        1040,
        180
      ],
      "name": "Claim as seen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DB_BASE_URL }}/seen_items",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "on_conflict",
              "value": "={{ 'url' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ url: $json.url, title: $json.title, summary: $json.summary }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true
    },
    {
      "id": "2eb7e7c6-d7ce-4959-acd8-37877e2c7ef5",
      "position": [
        1300,
        180
      ],
      "name": "Only the new ones",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const fresh = $input.all().map((i) => i.json).filter((r) => r && r.url);\nreturn [{ json: { count: fresh.length, list: fresh.map((r) => \"- \" + r.title + \" (\" + r.url + \"): \" + r.summary).join(\"\\n\") } }];"
      }
    },
    {
      "id": "04fdcfe1-4e46-42f6-a010-4d958b1cf685",
      "position": [
        1560,
        180
      ],
      "name": "Anything new?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "8895fcd1-c460-45d2-aefa-96592b3fae89",
              "leftValue": "={{ $json.count > 0 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "2f1e68eb-7eb0-4d16-ae21-bc626f046626",
      "position": [
        1820,
        90
      ],
      "name": "Write the digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LLM_BASE_URL }}/chat/completions",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.LLM_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $env.LLM_MODEL,\n  temperature: 0.2,\n  messages: [\n    { role: \"system\", content: \"[task:summarise] Write a short weekly digest from these items: one line per item saying why it matters, grouped under at most three headings. Keep every link. Add nothing that is not in the items.\" },\n    { role: \"user\", content: $json.list }\n  ]\n}) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "1961c6f0-8d98-4f07-a0c4-0e729f31c566",
      "position": [
        2080,
        180
      ],
      "name": "Send the digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EMAIL_BASE_URL }}/emails",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.EMAIL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: 'team@example.com', subject: 'This week: ' + $('Only the new ones').first().json.count + ' things worth reading', text: $json.choices?.[0]?.message?.content ?? $('Only the new ones').first().json.list }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "66d3f369-29ed-409e-a4e9-9b6197aa6b76",
      "position": [
        1820,
        270
      ],
      "name": "Quiet week",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    }
  ],
  "connections": {
    "Friday 15:00": {
      "main": [
        [
          {
            "node": "Feeds to read",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Feeds to read": {
      "main": [
        [
          {
            "node": "Fetch the feed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch the feed": {
      "main": [
        [
          {
            "node": "Collect the items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect the items": {
      "main": [
        [
          {
            "node": "Claim as seen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim as seen": {
      "main": [
        [
          {
            "node": "Only the new ones",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only the new ones": {
      "main": [
        [
          {
            "node": "Anything new?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anything new?": {
      "main": [
        [
          {
            "node": "Write the digest",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Quiet week",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write the digest": {
      "main": [
        [
          {
            "node": "Send the digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
