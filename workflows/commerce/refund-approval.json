{
  "name": "Payments · Refund requests",
  "nodes": [
    {
      "id": "00913755-5954-42c7-a078-519cb4fa733b",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Payments · Refund requests\nRefunds small amounts on recent orders automatically, and sends anything larger, older or repeated to a person with the facts attached.\n\n**Platforms:** none, this is logic only\n**Settings:** DB_API_KEY, DB_BASE_URL, PAYMENTS_API_KEY, PAYMENTS_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/commerce`"
      }
    },
    {
      "id": "7fd7f990-cc1e-41db-a29b-aa29ee3a4832",
      "position": [
        0,
        270
      ],
      "name": "Refund requested",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "refund-request",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "27719aa1-d7f8-4504-a019-dc67846cf6e1"
    },
    {
      "id": "fbea3a51-881e-454e-ab6b-09a5885c815e",
      "position": [
        260,
        270
      ],
      "name": "Read the request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nreturn [{ json: { order_id: String(b.order_id ?? \"\"), reason: String(b.reason ?? \"\").slice(0, 500), valid: !!b.order_id } }];"
      }
    },
    {
      "id": "8e554982-1e8c-444e-af1e-2a3180d59aab",
      "position": [
        520,
        270
      ],
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "8ba548b6-353c-474e-a581-189fba03a955",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f1226abd-4556-4995-a264-87b282849c8d",
      "position": [
        780,
        180
      ],
      "name": "Invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'order_id is required' }) }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "6398f882-6201-40a1-a1ec-914c2274ef81",
      "position": [
        780,
        360
      ],
      "name": "Load the order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DB_BASE_URL }}/orders",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "order_id",
              "value": "={{ 'eq.' + $json.order_id }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true
    },
    {
      "id": "962f37e7-43a1-417e-afc0-7a1dc7ff8c10",
      "position": [
        1040,
        270
      ],
      "name": "Order found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f6953e36-bbca-46f5-aebc-bbf8bd46ebcb",
              "leftValue": "={{ !!$json.order_id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ce1b18cb-650b-421d-a601-768ca4c5142a",
      "position": [
        1300,
        180
      ],
      "name": "Unknown order",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'Order not found' }) }}",
        "options": {
          "responseCode": 404
        }
      }
    },
    {
      "id": "165d585a-b746-4539-a49c-4c591a7e7a98",
      "position": [
        1300,
        360
      ],
      "name": "Past refunds",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.DB_BASE_URL }}/refunds",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{ 'eq.' + $json.email }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true
    },
    {
      "id": "f7db93bf-aaff-413f-acb0-714c5ee658d5",
      "position": [
        1560,
        270
      ],
      "name": "Apply the policy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const o = $(\"Order found?\").first().json;\nconst past = $input.all().map((i) => i.json).filter((r) => r.email);\nconst ageDays = (Date.now() - new Date(o.created_at).getTime()) / 864e5;\nconst reasons = [];\nif (o.status === \"refunded\") reasons.push(\"already refunded\");\nif (Number(o.total) > 100) reasons.push(\"over the 100 auto-refund limit\");\nif (ageDays > 30) reasons.push(\"order is older than 30 days\");\nif (past.length >= 2) reasons.push(\"third refund for this customer\");\nreturn [{ json: { order_id: o.order_id, email: o.email, amount: Number(o.total), charge_id: o.charge_id ?? null, auto: reasons.length === 0, already: o.status === \"refunded\", reasons, request_reason: $(\"Read the request\").first().json.reason } }];"
      }
    },
    {
      "id": "9b43df5f-9418-4d50-abda-43e9c88511f8",
      "position": [
        1820,
        270
      ],
      "name": "Decision",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "439569eb-8b35-4ea4-afa5-0c19562a4a04",
                    "leftValue": "={{ $json.already }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "already"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "a206d327-f40f-47d4-a1c1-6a4558bed3c2",
                    "leftValue": "={{ $json.auto }}",
                    "rightValue": "",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "auto"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
    {
      "id": "89727790-60c7-43dc-a7d0-cc877fe0ca7f",
      "position": [
        2080,
        90
      ],
      "name": "Already refunded",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, status: 'already_refunded' }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "08dc9c47-152b-436c-ae18-e450884688a8",
      "position": [
        2080,
        270
      ],
      "name": "Refund at the processor",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PAYMENTS_BASE_URL }}/refunds",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.PAYMENTS_API_KEY }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ 'refund-' + $json.order_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ charge: $json.charge_id, amount: Math.round($json.amount * 100) }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "96cf1058-4f1e-43e4-a62b-b17d9a28d5fd",
      "position": [
        2340,
        180
      ],
      "name": "Record the refund",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DB_BASE_URL }}/refunds",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ order_id: $('Decision').first().json.order_id, email: $('Decision').first().json.email, amount: $('Decision').first().json.amount, auto: true, at: $now.toISO() }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "aa509920-8bdf-4c3c-ac51-af0894d62c6b",
      "position": [
        2600,
        180
      ],
      "name": "Mark the order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.DB_BASE_URL }}/orders",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.DB_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "order_id",
              "value": "={{ 'eq.' + $('Decision').first().json.order_id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ status: 'refunded' }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "9a0c31a9-5445-4e24-a40d-cd0aa479ad31",
      "position": [
        2860,
        270
      ],
      "name": "Refunded",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
