    },
    {
      "id": "42660ce5-9634-4d36-aaf8-c4d9ca989c08",
      "position": [
        2080,
        450
      ],
      "name": "Review message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const d = $input.first().json;\nreturn [{ json: { channel: \"#finance\", level: \"warn\", text: \"Refund request for order \" + d.order_id + \" (\" + d.amount + \", \" + d.email + \") needs a decision: \" + d.reasons.join(\", \") + \". Customer says: \\\"\" + d.request_reason + \"\\\"\" } }];"
      }
    },
    {
      "id": "f7ced98e-c1f1-4e1a-aee6-354c0662d828",
      "position": [
        2340,
        360
      ],
      "name": "Ask finance",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:notify__"
        },
        "options": {}
      }
    },
    {
      "id": "2b46bc9c-a009-4ea3-abe8-3ef9244d47ae",
      "position": [
        2600,
        360
      ],
      "name": "Under review",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, status: 'under_review' }) }}",
        "options": {
          "responseCode": 200
        }
      }
    }
