{
  "name": "Finance · Supplier invoice intake",
  "nodes": [
    {
      "id": "b82bc863-c3b5-4db8-aada-a4e84786912b",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Finance · Supplier invoice intake\nReads a supplier invoice with a model, checks the arithmetic and the duplicate history itself, and files it or sends it for review.\n\n**Platforms:** OpenAI, Supabase\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/commerce`"
      }
    },
    {
      "id": "2d441b15-b385-429f-aa5b-7bed507d0641",
      "position": [
        0,
        220
      ],
      "name": "Invoice received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "invoice-received",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "c031b77e-c01d-4e46-aaaf-47b5aae59510"
    },
    {
      "id": "03e231f0-d86d-4ba5-a2de-0b0b5a10f8bb",
      "position": [
        260,
        220
      ],
      "name": "Read the upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nreturn [{ json: { file_url: b.file_url ?? null, text: String(b.text ?? \"\").slice(0, 12000), received_from: b.from ?? null } }];"
      }
    },
    {
      "id": "be6efcea-4980-4068-ab30-c0b58ec2b4e2",
      "position": [
        620,
        90
      ],
      "name": "Extract the fields",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "[task:extract] Extract from this supplier invoice. Reply with JSON: { vendor: string, invoice_number: string, total: number, currency: string, due_date: 'YYYY-MM-DD', confidence: 0-1 }. Use null for anything not present. Do not guess.",
          "maxIterations": 2
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "035c0412-8d36-44b9-a4cf-9fd802eb6d8d",
      "position": [
        520,
        310
      ],
      "name": "Extract the fields · GPT",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "__CRED:openai__",
          "name": "OpenAI"
        }
      }
    },
    {
      "id": "70d96529-4d34-4df0-ae1a-82a238dacde4",
      "position": [
        720,
        310
      ],
      "name": "Extract the fields · shape",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"vendor\": \"Acme Supplies\",\n  \"invoice_number\": \"INV-1\",\n  \"total\": 100.5,\n  \"currency\": \"USD\",\n  \"due_date\": \"2026-11-15\",\n  \"confidence\": 0.9\n}"
      }
    },
    {
      "id": "d19b84c8-153d-4c12-a0ec-264645de9250",
      "position": [
        980,
        220
      ],
      "name": "Read the fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const before = $(\"Read the upload\").all();\nconst out = [];\nfor (const [i, item] of $input.all().entries()) {\n  const answer = item.json.output;\n  const ok = answer && typeof answer === \"object\" && !Array.isArray(answer);\n  out.push({ json: { ...(before[i]?.json ?? {}), ...(ok ? answer : {\"vendor\":null,\"invoice_number\":null,\"total\":null,\"confidence\":0}), parse_error: !ok } });\n}\nreturn out;"
      }
    },
    {
      "id": "92aa97fc-c57f-4b53-ae7f-ce0206030bf0",
      "position": [
        1240,
        220
      ],
      "name": "Seen this invoice?",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "supplier_invoices",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "vendor",
              "condition": "eq",
              "keyValue": "={{ $json.vendor }}"
            },
            {
              "keyName": "invoice_number",
              "condition": "eq",
              "keyValue": "={{ $json.invoice_number }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "10a82e1d-ac43-4aa1-ae61-c8eff25bac77",
      "position": [
        1500,
        220
      ],
      "name": "Check it",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const f = $(\"Read the fields\").first().json;\nconst duplicate = $input.all().some((i) => i.json.invoice_number);\nconst problems = [];\nif (f.parse_error) problems.push(\"the model reply could not be read\");\nif (!f.vendor || !f.invoice_number) problems.push(\"vendor or invoice number missing\");\nif (typeof f.total !== \"number\" || !(f.total > 0)) problems.push(\"total is missing or not positive\");\nif (f.due_date && Number.isNaN(Date.parse(f.due_date))) problems.push(\"due date is not a date\");\nif ((f.confidence ?? 0) < 0.8) problems.push(\"low confidence (\" + (f.confidence ?? 0) + \")\");\nif (duplicate) problems.push(\"an invoice with this number from this vendor already exists\");\nreturn [{ json: { ...f, duplicate, problems, ok: problems.length === 0 } }];"
      }
    },
    {
      "id": "7ca9ce37-ace8-4cee-aeb4-4e3144e09c43",
      "position": [
        1760,
        220
      ],
      "name": "Clean?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f9865d9d-1d89-460c-a60d-10222963f4e9",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "cd45c33b-3b28-49ba-ae08-c9d3cc192e7f",
      "position": [
        2020,
        130
      ],
      "name": "File it",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "supplier_invoices",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "vendor",
              "fieldValue": "={{ $json.vendor }}"
            },
            {
              "fieldId": "invoice_number",
              "fieldValue": "={{ $json.invoice_number }}"
            },
            {
              "fieldId": "total",
              "fieldValue": "={{ $json.total }}"
            },
            {
              "fieldId": "currency",
              "fieldValue": "={{ $json.currency }}"
            },
            {
              "fieldId": "due_date",
              "fieldValue": "={{ $json.due_date }}"
            },
            {
              "fieldId": "file_url",
              "fieldValue": "={{ $json.file_url }}"
            },
            {
              "fieldId": "status",
              "fieldValue": "={{ 'awaiting_payment' }}"
            },
            {
              "fieldId": "at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "c799b624-8903-400f-a667-8b17653a9225",
      "position": [
        2020,
        310
      ],
      "name": "Queue for review",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "invoice_review",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "file_url",
              "fieldValue": "={{ $json.file_url }}"
            },
            {
              "fieldId": "extracted",
              "fieldValue": "={{ { vendor: $json.vendor, invoice_number: $json.invoice_number, total: $json.total } }}"
            },
            {
              "fieldId": "problems",
              "fieldValue": "={{ $json.problems }}"
            },
            {
              "fieldId": "at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "06b8e197-286b-4745-ae65-385155019379",
      "position": [
        2280,
        220
      ],
      "name": "Review message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const f = $(\"Clean?\").first().json;\nreturn [{ json: { channel: \"#finance\", level: \"warn\", text: \"An invoice\" + (f.vendor ? \" from \" + f.vendor : \"\") + \" needs a manual check: \" + f.problems.join(\"; \") + \".\" } }];"
      }
    },
    {
      "id": "6d3870fe-3a81-410a-a75d-811f7a71ab28",
      "position": [
        2540,
        220
      ],
      "name": "Tell finance",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:notify__"
        },
        "options": {}
      }
    }
  ],
