{
  "name": "Inventory · Supplier stock sync",
  "nodes": [
    {
      "id": "61c149c3-46c2-4f6b-aa5c-d0c2d4ec5952",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Inventory · Supplier stock sync\nPulls the supplier's stock feed every two hours and updates the store only for products whose quantity changed, refusing a feed that looks wrong.\n\n**Platforms:** Supabase, Shopify\n**Settings:** SUPPLIER_API_KEY, SUPPLIER_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/commerce`"
      }
    },
    {
      "id": "447e4632-3745-453f-a3f2-83bd7b5e479d",
      "position": [
        0,
        180
      ],
      "name": "Every 2 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      }
    },
    {
      "id": "0e51cb14-7698-48f7-a7f9-0ac5229504f9",
      "position": [
        260,
        180
      ],
      "name": "Supplier feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPPLIER_BASE_URL }}/stock",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPPLIER_API_KEY }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "9720d664-fa72-4670-ae31-77520b4f6081",
      "position": [
        520,
        180
      ],
      "name": "Last known stock",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "stock_snapshot",
        "returnAll": true
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "executeOnce": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "3de44985-b2c5-4819-a7cb-cebef1a8d8be",
      "position": [
        780,
        180
      ],
      "name": "What changed?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const feed = ($(\"Supplier feed\").first().json.items ?? []).filter((i) => i.sku && Number.isFinite(Number(i.quantity)));\nconst known = new Map($input.all().map((i) => i.json).filter((r) => r.sku).map((r) => [r.sku, r.quantity]));\nconst changes = feed.map((i) => ({ sku: String(i.sku), quantity: Number(i.quantity), before: known.get(String(i.sku)) ?? null })).filter((c) => c.before !== c.quantity);\nconst zeroed = changes.filter((c) => c.quantity === 0 && c.before > 0).length;\n// A feed that empties most of the catalogue at once is far more likely to be broken than true.\nconst suspicious = feed.length === 0 || (known.size >= 10 && zeroed / known.size > 0.5);\nreturn [{ json: { feed_size: feed.length, changes, suspicious, zeroed } }];"
      }
    },
    {
      "id": "43f83472-acbb-4a4d-a086-39d595c2683a",
      "position": [
        1040,
        180
      ],
      "name": "Feed looks sane?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c79a2e39-a9ae-4123-aa69-282e42d9ed0e",
              "leftValue": "={{ !$json.suspicious }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6d094bfd-caaf-496a-acc9-3aa3327f20e9",
      "position": [
        1300,
        90
      ],
      "name": "One item per change",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return $input.first().json.changes.map((json) => ({ json }));"
      }
    },
    {
      "id": "69e1eaac-4590-4059-a49d-b85c2cb45bfc",
      "position": [
        1560,
        90
      ],
      "name": "Update the store",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://acme-store.myshopify.com/admin/api/2025-01' + '/inventory_levels/set.json' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "shopifyAccessTokenApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sku: $json.sku, available: $json.quantity }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "shopifyAccessTokenApi": {
          "id": "__CRED:shopify__",
          "name": "Shopify"
        }
      }
    },
    {
      "id": "652c313e-7013-4265-acb5-944180336c23",
      "position": [
        1820,
        180
      ],
      "name": "Update the snapshot",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "update",
        "tableId": "stock_snapshot",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "sku",
              "condition": "eq",
              "keyValue": "={{ $('One item per change').item.json.sku }}"
            }
          ]
        },
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "quantity",
              "fieldValue": "={{ $('One item per change').item.json.quantity }}"
            },
            {
              "fieldId": "at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "alwaysOutputData": true,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "bcf9d72a-4126-4b3c-a0fc-e733c78becd5",
      "position": [
        2080,
        180
      ],
      "name": "Known product?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "1f2ca40c-8a12-46a0-a9e6-cc665b09acd8",
              "leftValue": "={{ !!$json.sku }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9d90f585-e7f8-4b1e-a0ad-49b89af7b4a8",
      "position": [
        2340,
        90
      ],
      "name": "Add to the snapshot",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "stock_snapshot",
        "dataToSend": "defineBelow",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "sku",
              "fieldValue": "={{ $('One item per change').item.json.sku }}"
            },
            {
              "fieldId": "quantity",
              "fieldValue": "={{ $('One item per change').item.json.quantity }}"
            },
            {
              "fieldId": "at",
              "fieldValue": "={{ $now.toISO() }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:supabase__",
          "name": "Supabase"
        }
      }
    },
    {
      "id": "5a651431-6965-434a-a5be-860f5e7d2798",
      "position": [
        2340,
        270
      ],
      "name": "Snapshot updated",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "parameters": {}
    },
    {
      "id": "e8a82eec-5026-487f-aa42-b3d9e3f8fb35",
      "position": [
        1300,
        270
      ],
      "name": "Refused message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const r = $input.first().json;\nreturn [{ json: { level: \"critical\", text: \"Supplier stock feed refused: \" + (r.feed_size === 0 ? \"it was empty\" : r.zeroed + \" products went to zero at once\") + \". The store was not changed. Check the feed.\" } }];"
      }
    },
    {
      "id": "3b1cb19e-2f5b-4e5d-ad1c-f494891c8d60",
      "position": [
        1560,
        270
      ],
      "name": "Alert",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:notify__"
        },
        "options": {}
      }
    }
  ],
  "connections": {
