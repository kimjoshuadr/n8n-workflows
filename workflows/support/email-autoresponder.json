{
  "name": "Support · Inbox triage and first reply",
  "nodes": [
    {
      "id": "39f6a91a-0e41-485a-a8f0-540fb093d5c7",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -210
      ],
      "parameters": {
        "width": 640,
        "height": 230,
        "content": "## Support · Inbox triage and first reply\nSorts the shared inbox: answers the handful of questions that have a fixed answer, files newsletters and receipts, and leaves everything else for a person.\n\n**Platforms:** Gmail, OpenAI, SendGrid, Zendesk\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/support`"
      }
    },
    {
      "id": "3f7b9eab-f73c-4bae-a39a-5fb5bb509649",
      "position": [
        0,
        310
      ],
      "name": "Email received",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": true,
        "filters": {
          "readStatus": "unread"
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "__CRED:gmail__",
          "name": "Gmail"
        }
      }
    },
    {
      "id": "3fffe216-4bbc-4ff0-ab69-6419df3bf306",
      "position": [
        260,
        310
      ],
      "name": "Read the email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const m = $input.first().json ?? {};\nconst from = (/[\\w.+-]+@[\\w-]+(\\.[\\w-]+)+/.exec(String(m.From ?? m.from ?? \"\").toLowerCase()) ?? [\"\"])[0];\nconst auto = /no-?reply|mailer-daemon|notifications?@|newsletter/.test(from) || !!m.headers?.[\"auto-submitted\"] || !!m.headers?.[\"list-unsubscribe\"];\nreturn [{ json: { id: String(m.id), from, subject: String(m.Subject ?? m.subject ?? \"\"), text: String(m.text ?? m.snippet ?? \"\").slice(0, 3000), auto } }];"
      }
    },
    {
      "id": "881bc208-f9ee-4cd0-ae33-179c2b3f916c",
      "position": [
        520,
        310
      ],
      "name": "From a person?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "d04ba8d9-2748-4dd8-aa5a-affb78d49ee8",
              "leftValue": "={{ !$json.auto }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "95e0eb93-a0f2-4785-a029-af48ba64748d",
      "position": [
        880,
        90
      ],
      "name": "Archive it",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "parameters": {
        "resource": "message",
        "operation": "removeLabels",
        "messageId": "={{ $json.id }}",
        "labelIds": [
          "INBOX"
        ]
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "gmailOAuth2": {
          "id": "__CRED:gmail__",
          "name": "Gmail"
        }
      }
    },
    {
      "id": "f16bc1e7-80cf-4fd6-a52f-2c1331b1a456",
      "position": [
        880,
        270
      ],
      "name": "What is it asking?",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.subject + '\\n\\n' + $json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "[task:classify-intent] Classify this email. Reply with JSON: { intent: 'opening_hours'|'pricing'|'reset_password'|'other', confident: boolean }. Use 'other' unless the email is plainly and only asking that one thing.",
          "maxIterations": 2
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "541badc6-df20-4c07-ac51-1e9ac0e6199a",
      "position": [
        780,
        490
      ],
      "name": "What is it asking? · GPT",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4o-mini"
        },
        "options": {
          "temperature": 0
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "__CRED:openai__",
          "name": "OpenAI"
        }
      }
    },
    {
      "id": "d021447f-d76b-4b42-aea4-1972772b64ac",
      "position": [
        980,
        490
      ],
      "name": "What is it asking? · shape",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\n  \"intent\": \"other\",\n  \"confident\": false\n}"
      }
    },
    {
      "id": "76dd5537-8f50-436d-afee-cb0960475ee5",
      "position": [
        1240,
        310
      ],
      "name": "Read the intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const before = $(\"From a person?\").all();\nconst out = [];\nfor (const [i, item] of $input.all().entries()) {\n  const answer = item.json.output;\n  const ok = answer && typeof answer === \"object\" && !Array.isArray(answer);\n  out.push({ json: { ...(before[i]?.json ?? {}), ...(ok ? answer : {\"intent\":\"other\",\"confident\":false}), parse_error: !ok } });\n}\nreturn out;"
      }
    },
    {
      "id": "0dbffd99-c923-4469-a808-a283219c1739",
      "position": [
        1500,
        310
      ],
      "name": "A fixed-answer question?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "6bc90c78-4bd2-483e-a808-fa7d208ed0b7",
              "leftValue": "={{ $json.confident === true && ['opening_hours', 'pricing', 'reset_password'].includes($json.intent) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "cb18c537-3f8a-4656-adde-32ca7e1ea845",
      "position": [
        1760,
        220
      ],
      "name": "Send the standard reply",
      "type": "n8n-nodes-base.sendGrid",
      "typeVersion": 1,
      "parameters": {
        "resource": "mail",
        "operation": "send",
        "fromEmail": "={{ 'hello@example.com' }}",
        "fromName": "={{ 'Acme' }}",
        "toEmail": "={{ $json.from }}",
        "dynamicTemplate": true,
        "templateId": "={{ 'd-faq-' + $json.intent }}",
        "dynamicTemplateFields": {
          "fields": [
            {
              "key": "subject",
              "value": "={{ $json.subject }}"
            }
          ]
        },
        "additionalFields": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "sendGridApi": {
          "id": "__CRED:sendgrid__",
          "name": "SendGrid"
        }
      }
    },
    {
      "id": "61936198-2dd8-47cb-aa85-04c3879a8f47",
      "position": [
        2020,
        310
      ],
      "name": "Label as answered",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "parameters": {
        "resource": "message",
        "operation": "addLabels",
        "messageId": "={{ $('A fixed-answer question?').first().json.id }}",
        "labelIds": [
          "Label_auto_answered"
        ]
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "credentials": {
        "gmailOAuth2": {
          "id": "__CRED:gmail__",
          "name": "Gmail"
        }
      }
    },
    {
      "id": "d2ffd372-0eb1-4b45-aae4-858e0bf68533",
      "position": [
        1760,
        400
      ],
      "name": "Leave for a person",
      "type": "n8n-nodes-base.zendesk",
      "typeVersion": 1,
      "parameters": {
        "resource": "ticket",
        "operation": "create",
        "description": "={{ 'From ' + $json.from + ':\\n\\n' + $json.text }}",
        "additionalFields": {
          "subject": "={{ $json.subject }}",
          "tags": [
            "from-email"
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": {
        "zendeskApi": {
          "id": "__CRED:zendesk__",
          "name": "Zendesk"
        }
      }
    }
  ],
