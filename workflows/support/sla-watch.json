{
  "name": "Support · SLA breach watch",
  "nodes": [
    {
      "id": "8e55ef17-50ee-4d1e-aa59-c30e465d9741",
      "name": "About this workflow",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -300
      ],
      "parameters": {
        "width": 620,
        "height": 220,
        "content": "## Support · SLA breach watch\nEvery ten minutes, finds tickets about to miss their first-response time, warns the owner, and escalates the ones that already have. Each ticket is raised once per stage.\n\n**Needs:** HELPDESK_API_KEY, HELPDESK_BASE_URL\n**Source and tests:** github.com/kimjoshuadr/n8n-workflows · `workflows/support`"
      }
    },
    {
      "id": "45ebb3a7-a119-4b2c-a7d7-b67ce3887cdd",
      "position": [
        0,
        0
      ],
      "name": "Every 10 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      }
    },
    {
      "id": "28a8502f-811b-413c-a123-00db8e8bff6e",
      "position": [
        240,
        0
      ],
      "name": "Unanswered tickets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "={{ $env.HELPDESK_BASE_URL }}/tickets/search",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.HELPDESK_API_KEY }}"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "={{ 'open' }}"
            },
            {
              "name": "first_response",
              "value": "={{ 'none' }}"
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "c8cab437-7298-4c7b-a1bd-266a9d1b14db",
      "position": [
        480,
        0
      ],
      "name": "Measure against the SLA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const SLA = { urgent: 30, high: 120, normal: 480, low: 1440 }; // minutes to first response\nconst now = Date.now();\nreturn ($input.first().json.tickets ?? []).map((t) => {\n  const limit = SLA[t.priority] ?? SLA.normal;\n  const waited = Math.floor((now - new Date(t.created_at).getTime()) / 60000);\n  const stage = waited >= limit ? \"breached\" : waited >= limit * 0.75 ? \"at_risk\" : \"ok\";\n  return { id: String(t.id), subject: t.subject, owner: t.owner ?? \"unassigned\", priority: t.priority ?? \"normal\", waited, limit, stage, last: t.sla_stage ?? \"ok\" };\n}).filter((t) => t.stage !== \"ok\" && t.stage !== t.last).map((json) => ({ json }));"
      }
    },
    {
      "id": "bfcdbd2a-2e77-43ff-a71a-de33e60f8282",
      "position": [
        720,
        0
      ],
      "name": "Remember the stage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HELPDESK_BASE_URL }}/tickets/update",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.HELPDESK_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ticket_id: $json.id, sla_stage: $json.stage }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "e07c273e-d6c5-47c7-a6ff-92ab0d12bd38",
      "position": [
        960,
        0
      ],
      "name": "Write the alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const before = $(\"Measure against the SLA\").all();\nreturn $input.all().map((_, i) => { const t = before[i].json; return { json: { channel: \"#support\", level: t.stage === \"breached\" ? \"critical\" : \"warn\", text: t.stage === \"breached\" ? \"SLA missed: #\" + t.id + \" \\\"\" + t.subject + \"\\\" has waited \" + t.waited + \" min (limit \" + t.limit + \"). Owner: \" + t.owner : \"SLA at risk: #\" + t.id + \" has \" + (t.limit - t.waited) + \" min left. Owner: \" + t.owner } }; });"
      }
    },
    {
      "id": "5e506199-acaf-4276-acec-afff92ad22a3",
      "position": [
        1200,
        0
      ],
      "name": "Raise it",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "__WF:notify__"
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Every 10 minutes": {
      "main": [
        [
          {
            "node": "Unanswered tickets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unanswered tickets": {
      "main": [
        [
          {
            "node": "Measure against the SLA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Measure against the SLA": {
      "main": [
        [
          {
            "node": "Remember the stage",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Remember the stage": {
      "main": [
        [
          {
            "node": "Write the alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write the alert": {
      "main": [
        [
          {
            "node": "Raise it",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "__WF:error-handler__"
  }
}
